<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XuLyDonShopee.Core\XuLyDonShopee.Core.csproj" />
    <ProjectReference Include="..\XuLyDonShopee.App\XuLyDonShopee.App.csproj" />
  </ItemGroup>

  <!-- Lõi cân tải của hub web (thuần BCL, không đụng Blazor/DB) được LINK vào đây — hub web là project
       Microsoft.NET.Sdk.Web, tham chiếu cả project vào test sẽ kéo theo toàn bộ host ASP.NET. Cùng khuôn
       "LINK file nguồn" mà Shopee.Hub.Web.csproj đang dùng: file gốc đổi tên/di chuyển → build gãy rõ ràng. -->
  <ItemGroup>
    <Compile Include="..\..\server\Shopee.Hub.Web\Services\DispatchBalancer.cs" Link="Hub\DispatchBalancer.cs" />
  </ItemGroup>

</Project>
