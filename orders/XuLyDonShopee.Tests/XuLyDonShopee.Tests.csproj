<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XuLyDonShopee.Core\XuLyDonShopee.Core.csproj" />
    <ProjectReference Include="..\XuLyDonShopee.App\XuLyDonShopee.App.csproj" />
  </ItemGroup>

  <!-- Nguồn dùng chung được LINK (khuôn của Shopee.Hub.Web.csproj) — KHÔNG tham chiếu cả Shopee.Core (kéo theo
       Playwright/ClosedXML/WMI). MachineSlots là luật SUẤT LÀM VIỆC dùng chung hub↔client, thuần BCL. -->
  <ItemGroup>
    <Compile Include="..\..\suite\Shopee.Core\Coordination\MachineSlots.cs" Link="Shared\Coordination\MachineSlots.cs" />
    <!-- Luật SỐ LANE theo op (import khoá cứng 1 lane) — dùng chung chỗ chạy thật ↔ quỹ Brave, thuần BCL. -->
    <Compile Include="..\..\suite\Shopee.Core\Coordination\OpLanes.cs" Link="Shared\Coordination\OpLanes.cs" />
    <!-- Luật DỪNG JOB khi key proxy chết: 2 file thuần BCL (ProxyFailure + luật quyết định của ScrapeRunner).
         Bắt nhầm lỗi proxy lẻ thành lỗi toàn cục sẽ giết oan job đang chạy → phải có test cả ca âm tính. -->
    <Compile Include="..\..\suite\Shopee.Core\Proxy\ProxyFailure.cs" Link="Shared\Proxy\ProxyFailure.cs" />
    <Compile Include="..\..\suite\Shopee.Module.MultiBrave\ScrapeFailurePolicy.cs" Link="Shared\Scrape\ScrapeFailurePolicy.cs" />
  </ItemGroup>

</Project>
