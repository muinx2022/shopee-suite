<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Thư viện module (phase 1b): trước là WinExe độc lập, nay build thành DLL để shell Shopee.Suite nạp.
         Bỏ ApplicationManifest/app.manifest (chỉ dùng cho exe) và BuiltInComInteropSupport (không có COM interop;
         WindowFocus dùng P/Invoke DllImport, không cần cờ này).
         Toàn bộ view của module là WPF (port xong ở đợt 5): Views/*.xaml + Styles/*.xaml + Controls/PathIcon. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <!-- WDAC / PublishReadyToRun — TRẠNG THÁI SAU KHI PORT WPF (đợt 6, 2026-07-31):
         Ghi chú cũ (2026-07-14) nói KHÔNG bật R2R vì crossgen recompile các DLL NuGet BÊN THỨ BA (hồi đó UI
         chạy trên bộ DLL Avalonia tải từ NuGet) → hash đổi → mất uy tín ISG cloud → WDAC (UMCI Enforced)
         chặn 0x800711C7; đo back-to-back khi ấy: IL chạy 3/3, R2R chặn 6/6.
         Nay UI là WPF — runtime nằm trong .NET desktop CHÍNH CHỦ Microsoft (ký sẵn), gói NuGet bên thứ ba
         chỉ còn CommunityToolkit.Mvvm + Velopack, nên ràng buộc trên NHIỀU KHẢ NĂNG HẾT ÁP DỤNG. Chưa đo
         lại được ở đợt này (cần đúng máy bật WDAC UMCI Enforced) → GIỮ NGUYÊN quyết định cũ cho an toàn:
         project này không tự bật R2R. `release-suite.cmd` vẫn publish suite với -p:PublishReadyToRun=true
         như trước, không đổi. Kiểm lại trên máy WDAC ở lần phát hành thật rồi hãy sửa ghi chú này. -->
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XuLyDonShopee.Core\XuLyDonShopee.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cho phép test unit các hàm PURE internal (vd OrderPersistPipeline.NenXoaDonKetThuc) — mẫu như Core. -->
    <InternalsVisibleTo Include="XuLyDonShopee.Tests" />
  </ItemGroup>
</Project>
