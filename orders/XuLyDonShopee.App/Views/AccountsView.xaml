<UserControl x:Class="XuLyDonShopee.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:XuLyDonShopee.App.ViewModels"
             xmlns:c="clr-namespace:XuLyDonShopee.App.Controls"
             xmlns:b="clr-namespace:XuLyDonShopee.App.Behaviors">

    <!-- Tài nguyên (màu + style + converter) của module — mỗi view TỰ CHỨA vì view có thể dựng độc lập
         trước khi gắn cây; StaticResource trong Style cục bộ / Converter của Binding phân giải NGAY lúc
         parse nên phải thấy ở scope view (không tràn vào Application của suite). Style CỤC BỘ của màn này
         khai chung trong đây (không đụng style dùng chung → không ảnh hưởng màn khác). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XuLyDonShopee.App;component/Styles/ModuleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════ Ô NHẬT KÝ (nền đen) ══════════ -->
            <!-- Template riêng vì (a) phải trong suốt ở MỌI trạng thái để lộ nền #0F1113 của thẻ log, và
                 (b) template TextBox của theme suite hard-code thanh cuộn Hidden — log dài phải cuộn được. -->
            <Style x:Key="logBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontFamily" Value="Consolas, Cascadia Mono" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#EDEDED" />
                <Setter Property="SelectionBrush" Value="#37507A" />
                <Setter Property="CaretBrush" Value="#EDEDED" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                              Focusable="False" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Ô lưới HẸP (cột tiến độ rộng 40): bỏ padding để icon 18px không bị cắt. -->
            <Style x:Key="cellTight" TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource {x:Type DataGridCell}}">
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- ══════════ Danh sách tài khoản dạng lưới phẳng (bỏ card bo góc từng dòng) ══════════ -->
            <Style x:Key="acctFlatItem" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="PART_bd" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}" MinHeight="{TemplateBinding MinHeight}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_bd" Property="Background" Value="#0A000000" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="PART_bd" Property="Background" Value="{StaticResource NavActiveBg}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="acctFlat" TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource acctFlatItem}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            </Style>

            <!-- Tên tài khoản trong lưới: thường xám đậm; khi phiên ĐANG MỞ (IsRunning) → xanh + SemiBold.
                 (Avalonia: `Classes.running="{Binding IsRunning}"` → WPF: DataTrigger trong style.) -->
            <Style x:Key="acctName" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{StaticResource Text232}" />
                <Setter Property="FontWeight" Value="Medium" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Setter Property="FontWeight" Value="Medium" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Vòng quay của cột tiến độ tab "Shops" (shop ĐANG được check): icon "làm mới" xoay 0→360°.
                 CHỈ chạy khi IsChecking=true (EnterActions/ExitActions) nên lúc rảnh không tốn CPU — đúng ý
                 bản Avalonia (nó gắn animation vào icon chỉ hiện khi đang check).
                 RenderTransform đặt TẠI CHỖ DÙNG chứ không trong Setter: giá trị Setter dùng CHUNG cho mọi
                 instance, animate vào đó là animate nhầm cả bảng. -->
            <Style x:Key="spin" TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsChecking}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="spinSb">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0" To="360" Duration="0:0:1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="spinSb" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Nút "Đóng" của banner lỗi địa chỉ: dáng chung của module (nền trắng + viền) nhưng thấp hơn một
                 nấc (28) cho vừa dòng banner. Icon để màu XÁM mặc định — CỐ Ý không đỏ, để không lẫn với dấu
                 ✕ đỏ "shop lỗi địa chỉ" ở cột tiến độ. -->
            <Style x:Key="alertClose" TargetType="{x:Type Button}" BasedOn="{StaticResource secondary}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Nút lọc "Những TK chưa xác nhận (N)": dáng chung (nền trắng + viền), chỉ giữ canh TRÁI + kéo
                 hết bề ngang cột; giọng đỏ nằm ở ICON (cảnh báo — KHÔNG phải .destructive vì nút không xóa gì). -->
            <Style x:Key="unverifiedFilter" TargetType="{x:Type Button}" BasedOn="{StaticResource danger}">
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <!-- ══════════ Sub-tab (Thông tin tài khoản | Shops) — SEGMENTED CONTROL kiểu Windows 11 ══════════ -->
            <!-- Cả cụm nằm trong MỘT khay bo tròn nền xám ấm; ô ĐANG CHỌN nổi lên nền TRẮNG + viền mảnh + chữ
                 đen (nét chữ NORMAL ở MỌI trạng thái — không SemiBold/Bold ở đâu cả, khớp `subtabItem` của
                 suite), ô còn lại chìm chữ xám. Bên phải khay là tên tài khoản đang mở (truyền qua Tag).
                 Phải THAY TEMPLATE của TabControl vì khay nền bao quanh dải tab không dựng được bằng setter rời.
                 BẪY WPF (đợt 4): KHÔNG đặt Foreground/FontWeight/FontSize TRÊN CHÍNH TabItem — thừa kế của WPF
                 đi theo cây LOGIC mà `TabItem.Content` có logical parent là TabItem → sẽ in đậm + tô màu TOÀN BỘ
                 nội dung tab. Đặt TextElement.* trên Border trong template. -->
            <Style x:Key="detailTabItem" TargetType="{x:Type TabItem}">
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0" />
                <!-- PHẢI Stretch: TabControl.UpdateSelectedContent() CHÉP Horizontal/VerticalContentAlignment
                     của TabItem đang chọn sang PART_SelectedContentHost → để Center thì form/lưới co lại. -->
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabItem}">
                            <Border x:Name="PART_LayoutRoot" CornerRadius="7" Background="Transparent"
                                    BorderBrush="Transparent" BorderThickness="1" SnapsToDevicePixels="True"
                                    TextElement.FontSize="12.5" TextElement.FontWeight="Normal"
                                    TextElement.Foreground="{StaticResource TextMuted}">
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_LayoutRoot" Property="Background" Value="#66FFFFFF" />
                                    <Setter TargetName="PART_LayoutRoot" Property="TextElement.Foreground" Value="{StaticResource TextInk}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="PART_LayoutRoot" Property="Background" Value="{StaticResource CardBg}" />
                                    <Setter TargetName="PART_LayoutRoot" Property="BorderBrush" Value="{StaticResource Border010}" />
                                    <Setter TargetName="PART_LayoutRoot" Property="TextElement.Foreground" Value="{StaticResource TextInk}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="detailTabs" TargetType="{x:Type TabControl}" BasedOn="{StaticResource {x:Type TabControl}}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource detailTabItem}" />
                <!-- Các ô nằm NGANG (mặc định của TabControl là TabPanel co giãn/xuống dòng). -->
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TabControl}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="24,14,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- KHAY segmented: nền xám ấm của bộ design (suite gọi token này là
                                         NeutralBadgeBg), bo 10, đệm 4 để ô đang chọn nổi hẳn lên. Lấy THẲNG
                                         token của suite như khuôn song sinh bên WorkspaceView để 2 màn không
                                         lệch màu (DynamicResource → tra ở Application lúc chạy). -->
                                    <Border Grid.Column="0" Background="{DynamicResource NeutralBadgeBgBrush}"
                                            CornerRadius="10" Padding="4">
                                        <ItemsPresenter />
                                    </Border>
                                    <!-- Tên tài khoản đang mở — view truyền vào qua Tag. -->
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="12,0,0,0" FontSize="12"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Huy hiệu số trong ô segmented: ô đang chọn → nền cam nhạt chữ cam; ô chìm → nền xám chữ xám.
                 (Avalonia: selector `TabItem:selected Border.tabBadge`; WPF leo tổ tiên TabItem bằng DataTrigger.) -->
            <Style x:Key="tabBadge" TargetType="{x:Type Border}">
                <Setter Property="Background" Value="{StaticResource Border06}" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="7,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextElement.FontSize" Value="10.5" />
                <Setter Property="TextElement.FontWeight" Value="Medium" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuted}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                                 Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentSoft1}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentTextBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Bố cục: 2 cột — danh sách (trái, cao hết màn) | chi tiết + nhật ký của tài khoản đang chọn (phải). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Cột trái TỰ ĐO theo nội dung (đợt G) thay cho con số 360 đo tay — bản cũ phải đo lại hàng nút
                 mỗi lần đổi nhãn, quên đo là nhãn "Thêm tài khoản" bị cắt cụt thành "Thêm tài khoả".
                 Auto = ôm vừa phần rộng NHẤT trong cột. Hai thành phần bề rộng vốn KHÔNG có trần (ô tìm kiếm
                 và danh sách tài khoản — đo với bề ngang vô hạn nên đòi đúng bề rộng chuỗi dài nhất) đã bị kẹp
                 MaxWidth 320 ngay tại chỗ, nên phần quyết định còn lại chính là HÀNG NÚT ở đáy: đổi/ thêm nhãn
                 nút là cột tự nới ra vừa đủ. MinWidth 300 chặn đầu dưới lúc danh sách rỗng. -->
            <ColumnDefinition Width="Auto" MinWidth="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Cột trái: danh sách ═══════════ -->
        <Border Grid.Column="0" BorderBrush="{StaticResource Border06}" BorderThickness="0,0,1,0">
            <DockPanel Margin="24,24,20,16">

                <TextBlock DockPanel.Dock="Top" Text="Danh sách tài khoản"
                           Style="{StaticResource h1}"
                           Margin="0,0,0,16" />

                <!-- Ô tìm kiếm. MaxWidth: cột trái đo bằng Auto → ô nhập không có trần sẽ đòi đúng bề rộng
                     chuỗi đang gõ và kéo phình cả cột. -->
                <Border DockPanel.Dock="Top" Style="{StaticResource field}" Margin="0,0,0,14" MaxWidth="320"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⌕" FontSize="14"
                                   Foreground="{StaticResource Text9A}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBox Grid.Column="1" Style="{StaticResource bare}" Margin="8,0,12,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 b:WatermarkAssist.Watermark="Tìm theo email / ghi chú…" />
                        <Border Grid.ColumnSpan="2" Style="{StaticResource underline}" />
                    </Grid>
                </Border>

                <!-- Hàng nút dưới — cặp Thêm/Xóa cùng từ vựng với suite: Thêm = icon XANH (.success),
                     Xóa = nút vuông icon ĐỎ (.destructive .iconOnly).
                     3 nút để bề rộng TỰ NHIÊN (Auto) + một cột `*` co giãn ở giữa: nhãn không bao giờ bị cắt
                     cụt nữa, và cột trái (Auto) tự nới đúng bằng hàng này khi nhãn dài ra. -->
                <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource success}"
                            Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{DynamicResource IconAdd}" />
                            <TextBlock Text="Thêm tài khoản" Style="{StaticResource btnLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Margin="8,0,0,0"
                            Command="{Binding KeoTuHubCommand}"
                            ToolTip="Kéo danh bạ tài khoản từ Hub về máy này (login + shop, KHÔNG kèm mật khẩu). Tài khoản mới sẽ có mật khẩu trống — mở ra nhập mật khẩu rồi bấm Chạy. Tài khoản đã có ở máy được giữ nguyên.">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{DynamicResource IconSync}" />
                            <TextBlock Text="Kéo TK từ Hub" Style="{StaticResource btnLabel}" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource destructiveIconOnly}" Margin="8,0,0,0"
                            Command="{Binding DeleteCommand}"
                            IsEnabled="{Binding CanDelete}"
                            ToolTip="Xóa các tài khoản đang tick — không tick dòng nào thì xóa tài khoản đang chọn. Hỏi xác nhận trước khi xóa.">
                        <c:PathIcon Data="{DynamicResource IconDelete}" />
                    </Button>
                </Grid>

                <!-- (Hàng nút thao tác nhóm ✓/▶/■/✕ đã BỎ — trùng nhóm "Hành động" trên Ribbon.)
                     (Tùy chọn "Xóa profile và tạo lại" đã CHUYỂN lên dải Ribbon — tab Đơn hàng.) -->

                <!-- Nút lọc "Những TK chưa xác nhận (N)" (ẩn khi N=0 và không đang lọc); đang lọc → "Hiện tất cả". -->
                <Button DockPanel.Dock="Top" Style="{StaticResource unverifiedFilter}" Margin="0,0,0,12"
                        Command="{Binding ToggleShowUnverifiedCommand}"
                        Visibility="{Binding IsUnverifiedFilterVisible, Converter={StaticResource BoolToVis}}"
                        ToolTip="Lọc danh sách chỉ còn các tài khoản không tự xác minh được (cuối lượt chạy tự động vẫn kẹt ở trang verify/login/captcha)">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{DynamicResource IconFilter}" />
                        <TextBlock Text="{Binding UnverifiedButtonText}" Style="{StaticResource btnLabel}" />
                    </StackPanel>
                </Button>

                <!-- Danh sách tài khoản: mỗi dòng "[ ] Tên shop" + (khi đang chạy) chấm xanh & số chờ lấy.
                     MaxWidth: cột trái đo bằng Auto → danh sách không có trần sẽ đòi bề rộng của DÒNG DÀI NHẤT
                     (email + nhãn đỏ + nút) và kéo phình cả cột. -->
                <ListBox Style="{StaticResource acctFlat}" MaxWidth="320" HorizontalAlignment="Stretch"
                         ItemsSource="{Binding Accounts}"
                         SelectedItem="{Binding SelectedRow}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- Avalonia `Tapped` → WPF MouseLeftButtonUp (bubble từ control con lên Grid gốc
                                 của dòng). Nút "Truy cập TK" tự nuốt sự kiện chuột nên không lỡ toggle tick. -->
                            <Grid Background="Transparent" MouseLeftButtonUp="OnAccountRowTapped">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- CheckBox chỉ HIỂN THỊ trạng thái tick; bấm bất kỳ đâu trên dòng (kể cả vùng
                                     checkbox) sẽ toggle tick + chọn dòng. IsHitTestVisible=False + Mode=OneWay
                                     để checkbox không tự xử lý click (không toggle đúp, không nuốt chọn dòng). -->
                                <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                          IsHitTestVisible="False"
                                          IsChecked="{Binding IsSelected, Mode=OneWay}" />
                                <!-- Mũi tên "đang mở cửa sổ" ngay TRƯỚC tên (ẩn khi không chạy → không chiếm chỗ). -->
                                <TextBlock Grid.Column="1" Text="►" FontSize="10"
                                           Foreground="{StaticResource SuccessBrush}"
                                           VerticalAlignment="Center" Margin="0,0,4,0"
                                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                <!-- Tên shop: thường Text232/Medium; khi phiên ĐANG MỞ → xanh + SemiBold (style acctName). -->
                                <TextBlock Grid.Column="2" Style="{StaticResource acctName}" Text="{Binding Email}"
                                           FontSize="13" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Khối phải: nhãn đỏ "TK chưa xác nhận" + nút "Truy cập TK" (khi cờ bật);
                                     (khi đang chạy) chấm xanh & "Chờ lấy: N". -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="8,0,0,0">
                                    <!-- Nhãn đỏ: đỏ nền hồng nhạt, chữ đậm — không phá layout dòng.
                                         Màu lấy TOKEN DangerSoft* (Styles/Colors.xaml), không ghi cứng hex. -->
                                    <Border VerticalAlignment="Center"
                                            Visibility="{Binding IsVerifyFailed, Converter={StaticResource BoolToVis}}"
                                            Background="{StaticResource DangerSoftBg}"
                                            BorderBrush="{StaticResource DangerSoftBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="TK chưa xác nhận" FontSize="10"
                                                   Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- Nút "Truy cập TK": chọn acc + tự mở phiên để xác minh tay (code-behind).
                                         CHỈ ICON (nút vuông 30 dáng chuẩn): dòng chỉ rộng ~280px mà đã có nhãn đỏ;
                                         nghĩa của nút nằm ở icon "mở liên kết ngoài" + tooltip. -->
                                    <Button Style="{StaticResource primaryIconOnly}" Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsVerifyFailed, Converter={StaticResource BoolToVis}}"
                                            Click="OnTruyCapTkClick"
                                            ToolTip="Mở trang bán hàng của tài khoản này để xác minh tay trên cửa sổ Brave">
                                        <c:PathIcon Data="{DynamicResource IconOpenExternal}" />
                                    </Button>
                                    <Border Width="6" Height="6" CornerRadius="3" Margin="6,0,0,0"
                                            VerticalAlignment="Center" Background="{StaticResource SuccessBrush}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding ToShipText}" FontSize="11"
                                               Margin="6,0,0,0"
                                               Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding ToShipText, Converter={StaticResource StringToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════ Cột chi tiết: form GIÃN hết cột + nhật ký của tài khoản đang chọn bên PHẢI ═══════════
             Chia đều 3:2 (form 3* | log 2*) — cùng ngữ pháp với màn Chạy tự động, không hở giữa. -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Cột trái: placeholder + form chi tiết (chồng nhau trong cùng ô). -->
            <Grid Grid.Column="0">

                <!-- Placeholder khi chưa chọn -->
                <TextBlock Text="Chọn một tài khoản hoặc bấm + Thêm tài khoản"
                           Foreground="{StaticResource Text9A}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolToVis}}" />

                <!-- Khối chi tiết: 2 tab — "Thông tin tài khoản" (form) | "Shops" (chuẩn bị hàng theo shop/ngày).
                     TabControl mang Visibility=IsEditing; placeholder nằm NGOÀI (chồng cùng ô Grid).
                     Tag = tên tài khoản đang mở → template segmented control hiện ở mép phải khay tab. -->
                <TabControl Style="{StaticResource detailTabs}"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                            SelectedIndex="{Binding DetailTabIndex}"
                            Tag="{Binding SelectedRow.Email}">

                    <!-- ───────── Tab 1: Thông tin tài khoản ───────── -->
                    <TabItem>
                        <TabItem.Header>
                            <TextBlock Text="Thông tin tài khoản" VerticalAlignment="Center" />
                        </TabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <!-- Form GIÃN hết cột 3* (bỏ trần 760/neo trái): card nở hết bề ngang, bám sát panel
                                 nhật ký bên PHẢI → không còn khoảng chết ở giữa. -->
                            <StackPanel Margin="24,24,16,16">

                                <!-- Header (chỉ còn tiêu đề + subtitle; đã bỏ badge trạng thái tài khoản). -->
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Chi tiết tài khoản" Style="{StaticResource h1}" />
                                    <TextBlock Text="Thông tin đăng nhập và địa chỉ lấy hàng" FontSize="12"
                                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- (Hàng nút thao tác PHIÊN ▶ Chạy / ■ Dừng / 🧪 Chạy thử đã BỎ — mọi thao tác
                                     chạy/dừng qua nhóm "Hành động" trên Ribbon.) -->

                                <!-- Thông báo trạng thái (Mở trang bán hàng / Xử lý đơn / theo dõi đơn). -->
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,16"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />
                                <TextBlock Text="{Binding BusyStatus}" Foreground="{StaticResource SuccessBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,16"
                                           Visibility="{Binding BusyStatus, Converter={StaticResource StringToVis}}" />
                                <!-- Trạng thái theo dõi đơn "Chờ Lấy Hàng" (30' reload/đọc). -->
                                <TextBlock Text="{Binding OrderStatus}" Foreground="{StaticResource InfoBrush}"
                                           TextWrapping="Wrap" Margin="0,0,0,16"
                                           Visibility="{Binding OrderStatus, Converter={StaticResource StringToVis}}" />

                                <!-- Card XẾP DỌC 1 CỘT (dồn field về TRÁI): Đăng nhập → Cookie → Email xác minh →
                                     Địa chỉ. Cách nhau 12 theo dọc; phần bên PHẢI để dành cho panel nhật ký. -->

                                <!-- Card: Thông tin đăng nhập (Tên đăng nhập + Mật khẩu CÙNG 1 HÀNG). -->
                                <Border Style="{StaticResource card}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource section}" Text="THÔNG TIN ĐĂNG NHẬP"
                                                   Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Tên đăng nhập -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource fieldLabel}" Text="Tên đăng nhập" />
                                                <Border Style="{StaticResource field}">
                                                    <Grid>
                                                        <TextBox Style="{StaticResource bare}" Margin="12,0"
                                                                 Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                                                 b:WatermarkAssist.Watermark="Email hoặc tên đăng nhập" />
                                                        <Border Style="{StaticResource underline}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <!-- Mật khẩu: PasswordBox (che) chồng TextBox (hiện) — WPF không có
                                                 PasswordChar/RevealPassword trên TextBox. -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource fieldLabel}" Text="Mật khẩu" />
                                                <Border Style="{StaticResource field}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox Grid.Column="0" Style="{StaticResource barePassword}"
                                                                     Margin="12,0,0,0"
                                                                     b:PasswordBoxAssist.BindPassword="True"
                                                                     b:PasswordBoxAssist.BoundPassword="{Binding EditPassword, Mode=TwoWay}"
                                                                     Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolToVis}}" />
                                                        <TextBox Grid.Column="0" Style="{StaticResource bare}"
                                                                 Margin="12,0,0,0"
                                                                 Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                                                        <Button Grid.Column="1" Style="{StaticResource ghostIcon}"
                                                                Margin="4,0,5,0"
                                                                Command="{Binding ToggleShowPasswordCommand}"
                                                                ToolTip="Hiện/ẩn mật khẩu">
                                                            <Grid>
                                                                <c:PathIcon Data="{DynamicResource IconEye}"
                                                                            Visibility="{Binding ShowPassword, Converter={StaticResource InvBoolToVis}}" />
                                                                <c:PathIcon Data="{DynamicResource IconEyeOff}"
                                                                            Visibility="{Binding ShowPassword, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Button>
                                                        <Border Grid.ColumnSpan="2" Style="{StaticResource underline}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Cookie đăng nhập: CHỈ hiện trạng thái đã có / chưa có. -->
                                <Border Style="{StaticResource card}" Padding="20,14" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource section}" Text="COOKIE ĐĂNG NHẬP"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="✓ Đã có cookie đăng nhập" FontSize="13"
                                                   Margin="12,0,0,0"
                                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding HasCookie, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="Chưa có — mở trang bán hàng để tự lưu"
                                                   FontSize="13" Foreground="{StaticResource Text9A}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasCookie, Converter={StaticResource InvBoolToVis}}" />
                                    </StackPanel>
                                </Border>

                                <!-- Card: Email xác minh (hộp thư Hotmail/Outlook nhận mail verify của Shopee). -->
                                <Border Style="{StaticResource card}" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource section}" Text="EMAIL XÁC MINH"
                                                   Margin="0,0,0,12" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Email xác minh -->
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Style="{StaticResource fieldLabel}" Text="Email xác minh" />
                                                <Border Style="{StaticResource field}">
                                                    <Grid>
                                                        <TextBox Style="{StaticResource bare}" Margin="12,0"
                                                                 Text="{Binding EditVerifyEmail, UpdateSourceTrigger=PropertyChanged}"
                                                                 b:WatermarkAssist.Watermark="hộp thư Hotmail/Outlook" />
                                                        <Border Style="{StaticResource underline}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                            <!-- Mật khẩu email -->
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource fieldLabel}" Text="Mật khẩu email" />
                                                <Border Style="{StaticResource field}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox Grid.Column="0" Style="{StaticResource barePassword}"
                                                                     Margin="12,0,0,0"
                                                                     b:PasswordBoxAssist.BindPassword="True"
                                                                     b:PasswordBoxAssist.BoundPassword="{Binding EditVerifyEmailPassword, Mode=TwoWay}"
                                                                     Visibility="{Binding ShowVerifyEmailPassword, Converter={StaticResource InvBoolToVis}}" />
                                                        <TextBox Grid.Column="0" Style="{StaticResource bare}"
                                                                 Margin="12,0,0,0"
                                                                 Text="{Binding EditVerifyEmailPassword, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding ShowVerifyEmailPassword, Converter={StaticResource BoolToVis}}" />
                                                        <Button Grid.Column="1" Style="{StaticResource ghostIcon}"
                                                                Margin="4,0,5,0"
                                                                Command="{Binding ToggleShowVerifyEmailPasswordCommand}"
                                                                ToolTip="Hiện/ẩn mật khẩu email">
                                                            <Grid>
                                                                <c:PathIcon Data="{DynamicResource IconEye}"
                                                                            Visibility="{Binding ShowVerifyEmailPassword, Converter={StaticResource InvBoolToVis}}" />
                                                                <c:PathIcon Data="{DynamicResource IconEyeOff}"
                                                                            Visibility="{Binding ShowVerifyEmailPassword, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Button>
                                                        <Border Grid.ColumnSpan="2" Style="{StaticResource underline}" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,12,0,0"
                                                   Text="Hộp thư Hotmail/Outlook nhận mail xác minh khi Shopee yêu cầu verify đăng nhập." />
                                    </StackPanel>
                                </Border>

                                <!-- (Card "PROXY — API key KiotProxy" đã bỏ: proxy nay tự chia từ pool KiotProxy
                                     chung khi chạy, không gán cố định theo tài khoản nữa.) -->

                                <!-- Card: Địa chỉ lấy hàng mặc định (dùng cho xử lý đơn sau này) -->
                                <Border Style="{StaticResource card}" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource section}" Text="ĐỊA CHỈ LẤY HÀNG"
                                                   Margin="0,0,0,12" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource fieldLabel}" Text="Địa chỉ lấy hàng mặc định" />
                                            <ComboBox Style="{StaticResource fieldCombo}" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static vm:AccountsViewModel.PickupAddressOptions}"
                                                      SelectedItem="{Binding EditPickupAddress}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Lưu / Hủy — DƯỚI CÙNG form, căn TRÁI. Lưu = icon CAM (.primary),
                                     Hủy = icon xám (không style) — cùng cặp với các form bên suite. -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Style="{StaticResource primary}"
                                            Command="{Binding SaveCommand}"
                                            ToolTip="Lưu thay đổi">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{DynamicResource IconSave}" />
                                            <TextBlock Text="Lưu" Style="{StaticResource btnLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="8,0,0,0" Command="{Binding CancelCommand}" ToolTip="Hủy">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{DynamicResource IconClose}" />
                                            <TextBlock Text="Hủy" Style="{StaticResource btnLabel}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ───────── Tab 2: Shops — chọn ngày + lưới Shop | Chuẩn bị hàng ───────── -->
                    <TabItem>
                        <!-- Huy hiệu = SỐ SHOP đang hiện trong lưới kết quả (số thật, không phải trang trí). -->
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Shops" VerticalAlignment="Center" />
                                <Border Style="{StaticResource tabBadge}" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding ResultRows.Count, Mode=OneWay}" />
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <DockPanel Margin="24,18,16,16">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal"
                                        Margin="0,0,0,14" VerticalAlignment="Center">
                                <TextBlock Text="Ngày:" FontSize="13"
                                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <!-- ResultDate là DateTimeOffset (không-null) còn DatePicker.SelectedDate là
                                     DateTime? → phải qua converter; xóa trắng lịch KHÔNG ghi đè (Binding.DoNothing). -->
                                <DatePicker Margin="10,0,0,0" SelectedDateFormat="Short"
                                            SelectedDate="{Binding ResultDate, Converter={StaticResource DateOffset}}" />
                                <!-- Số đang hiện là số CHUNG toàn hệ thống (hub đếm từ bảng đơn) hay chỉ số của
                                     riêng máy này (chưa hỏi được hub) — 2 dòng loại trừ nhau theo DangDungSoHub. -->
                                <TextBlock Text="Số toàn hệ thống (Hub)" Margin="10,0,0,0"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DangDungSoHub, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Chưa gộp được từ Hub" Margin="10,0,0,0"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding DangDungSoHub, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                            <!-- Dòng TỔNG — nằm ngay trên lưới để liếc là thấy, khỏi cuộn hết danh sách shop.
                                 Cộng đúng cột "Chuẩn bị hàng" của MỌI shop đang hiện. -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource card}" Margin="0,0,0,10" Padding="12,7">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Tổng đã chuẩn bị hàng (trong ngày):" FontSize="13"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TongChuanBiHang}" FontSize="14"
                                               Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="đơn" FontSize="13" Margin="6,0,0,0"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- Banner lỗi địa chỉ bền: mỗi shop một dòng + nút X; không tự ẩn theo ngày/vòng. -->
                            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding AddressAlertRows}"
                                          Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,7" CornerRadius="5"
                                                Background="{StaticResource WarnSoftBg}"
                                                BorderBrush="{StaticResource WarnSoftBorder}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- CHỈ còn chữ cảnh báo + nút Đóng. Nút "Check" thủ công đã BỎ
                                                     (10/08/2026, người dùng chốt): banner nay tự hết ở vòng chạy
                                                     kế — shop nào còn treo cảnh báo là vòng lặp tự thử lại bước
                                                     đặt địa chỉ, đặt được thì tự gỡ banner + báo Hub + gỡ ở máy
                                                     khác, vẫn lỗi thì banner ở lại. Không cần ai bấm gì. -->
                                                <StackPanel Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Message}" FontSize="12.5"
                                                               Foreground="{StaticResource AmberTextBrush}"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                                <!-- Nút ĐÓNG banner: trước là ✕ ĐỎ 11px — vừa khó bấm, vừa TRÙNG
                                                     NGÔN NGỮ với ✕ đỏ ở cột tiến độ ngay dưới (dấu hiệu "shop
                                                     lỗi địa chỉ", không phải nút). Nay là nút CHỮ "Đóng" kèm ✕
                                                     nhỏ XÁM, cao 28 (vùng bấm ≥ 28px), màu theo token.
                                                     HÀNH VI KHÔNG ĐỔI: vẫn đúng command + tham số cũ (luật
                                                     rev/tombstone của banner nằm trong VM, không đụng tới). -->
                                                <Button Grid.Column="2" Style="{StaticResource alertClose}"
                                                        Margin="8,0,0,0"
                                                        ToolTip="Đóng cảnh báo địa chỉ của shop này"
                                                        Command="{Binding DataContext.DismissAddressAlertCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:PathIcon Data="{DynamicResource IconClose}" Width="9" Height="9" />
                                                        <TextBlock Text="Đóng" Style="{StaticResource btnLabel}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Lưới 3 cột: tiến độ (tick/vòng quay) | Shop (mọi shop của tài khoản) |
                                 Chuẩn bị hàng (số đơn arrange trong ngày). -->
                            <DataGrid Style="{StaticResource proxy}" ClipToBounds="True"
                                      ItemsSource="{Binding ResultRows}"
                                      IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserResizeColumns="True" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <!-- Cột tiến độ — HẸP, không tiêu đề, MỘT biểu tượng mỗi dòng: vòng quay cam
                                         = đang kiểm tra; X đỏ = lỗi địa chỉ bền (đứng TRƯỚC cột Shop); tick xanh
                                         = đã check xong (lỗi địa chỉ ưu tiên hơn tick). -->
                                    <DataGridTemplateColumn Header="" Width="40" CanUserResize="False"
                                                            CellStyle="{StaticResource cellTight}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      Width="18" Height="18">
                                                    <c:PathIcon Data="{DynamicResource IconClose}"
                                                                Width="12" Height="12"
                                                                Foreground="{StaticResource DangerBrush}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding ShowLoiDiaChi, Converter={StaticResource BoolToVis}}" />
                                                    <c:PathIcon Data="{DynamicResource IconCheck}"
                                                                Width="13" Height="13"
                                                                Foreground="{StaticResource SuccessBrush}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding ShowTick, Converter={StaticResource BoolToVis}}" />
                                                    <c:PathIcon Style="{StaticResource spin}" Data="{DynamicResource IconRefresh}"
                                                                Width="12" Height="12"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
                                                        <!-- Mỗi dòng một RotateTransform RIÊNG (đặt trong Setter thì
                                                             mọi dòng dùng chung một đối tượng → animate sai). -->
                                                        <c:PathIcon.RenderTransform>
                                                            <RotateTransform />
                                                        </c:PathIcon.RenderTransform>
                                                    </c:PathIcon>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Shop" Binding="{Binding ShopName}" Width="*" MinWidth="140" />
                                    <!-- Đang check shop này → chữ "đang kiểm tra…" THAY cho số; check xong thì số
                                         (đã cập nhật theo từng đơn) hiện lại. -->
                                    <DataGridTemplateColumn Header="Chuẩn bị hàng" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid MinWidth="90" Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding PreparedCount}" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Visibility="{Binding IsChecking, Converter={StaticResource InvBoolToVis}}" />
                                                    <TextBlock Text="đang kiểm tra…" HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontSize="11" Foreground="{StaticResource TextMuted}"
                                                               Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- ═══════════ Cột PHẢI của cột chi tiết: nhật ký của TÀI KHOẢN đang chọn (nền đen) ═══════════
                 Đứng dọc bên phải field; margin khe trái + cách viền trên/phải/dưới; bo góc thành "thẻ" log. -->
            <Border Grid.Column="1"
                    Margin="8,24,16,16" CornerRadius="6" ClipToBounds="True"
                    Background="#0F1113"
                    BorderBrush="#2A2A2A" BorderThickness="1">
                <DockPanel Margin="12,8,12,8">

                    <!-- Header: tiêu đề + nút Copy/Xóa (chỉ xóa hiển thị, không xóa file). -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <!-- Chưa chọn tài khoản → tiêu đề chung; đã chọn → "Nhật ký — {tên tài khoản}". -->
                            <TextBlock Text="Nhật ký hoạt động"
                                       FontSize="12"
                                       Foreground="#E8E8E8" VerticalAlignment="Center"
                                       Visibility="{Binding SelectedRow, Converter={StaticResource NullToVis}}" />
                            <TextBlock Text="{Binding SelectedRow.Email, StringFormat='Nhật ký — {0}'}"
                                       FontSize="12"
                                       Foreground="#E8E8E8" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding SelectedRow, Converter={StaticResource NotNullToVis}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource logClear}" Content="Copy" Click="CopyLog_Click"
                                    ToolTip="Chép toàn bộ nhật ký đang hiển thị vào clipboard (để dán ra ngoài)" />
                            <Button Style="{StaticResource logClear}" Margin="6,0,0,0"
                                    Content="Xóa" Command="{Binding ClearLogCommand}"
                                    ToolTip="Xóa các dòng đang hiển thị của tài khoản này (không xóa file log trên đĩa)" />
                        </StackPanel>
                    </Grid>

                    <!-- Đường dẫn file log (mờ) để biết nhật ký được ghi ở đâu — 1 dòng. -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding LogPath}"
                               FontSize="10" Foreground="#8A8A8A"
                               TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />

                    <!-- Log = TextBox CHỈ-ĐỌC (cả log là 1 khối text) → Ctrl+A chọn HẾT + Ctrl+C / chuột phải
                         Copy được. Tự cuộn xuống cuối ở code-behind. -->
                    <TextBox x:Name="LogBox" Style="{StaticResource logBox}"
                             Text="{Binding LogText, Mode=OneWay}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
