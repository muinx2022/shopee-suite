<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="XuLyDonShopee.App.Views.ConfirmDialog"
        Width="440" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Xác nhận">
    <StackPanel Margin="20" Spacing="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <!-- Nút chính: dáng mặc định của theme, KHÔNG tô nền (luật nút 2026-07-26); class .primary chỉ để
                 icon (nếu có) lên màu cam. Trước đây hard-code nền xanh dương #1976D2 — lạc lõng giữa app cam. -->
            <Button x:Name="OkButton" Classes="primary" Content="Đồng ý" Click="OnOk" />
            <Button x:Name="CancelButton" Content="Hủy" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
