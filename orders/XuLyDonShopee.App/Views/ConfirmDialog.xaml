<Window x:Class="XuLyDonShopee.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:XuLyDonShopee.App.Controls"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Title="Xác nhận">

    <!-- Merge tài nguyên module để dùng ĐÚNG một hệ style với các màn Đơn hàng (style `primary` + kiểu
         c:PathIcon riêng của module). Bản Avalonia không merge và mượn class của Application; ở WPF, style
         `primary` của suite chỉ tô được PathIcon KIỂU SUITE nên icon trong hộp thoại này sẽ ra xám —
         merge một dòng là hết lệch. Geometry icon vẫn tra ở Application (DynamicResource IconX). -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XuLyDonShopee.App;component/Styles/ModuleResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                   Foreground="{StaticResource TextInk}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <!-- Nút chính: dáng mặc định của theme, KHÔNG tô nền (luật nút 2026-07-26); style `primary` đưa
                 icon lên màu cam. Chế độ chỉ-báo (infoOnly) đổi NHÃN qua OkText (code-behind) chứ không gán
                 lại Content — gán chuỗi vào Content sẽ thổi bay cả icon. -->
            <Button x:Name="OkButton" Style="{StaticResource primary}" IsDefault="True" Click="OnOk">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{DynamicResource IconCheck}" />
                    <TextBlock x:Name="OkText" Text="Đồng ý" Style="{StaticResource btnLabel}" />
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Margin="8,0,0,0" IsCancel="True" Click="OnCancel">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{DynamicResource IconClose}" />
                    <TextBlock Text="Hủy" Style="{StaticResource btnLabel}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
