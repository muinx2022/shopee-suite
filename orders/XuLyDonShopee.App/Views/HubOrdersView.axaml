<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:XuLyDonShopee.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1284" d:DesignHeight="820"
             x:Class="XuLyDonShopee.App.Views.HubOrdersView"
             x:CompileBindings="False"
             x:DataType="vm:HubOrdersViewModel">

    <!-- Tài nguyên (màu + converter + icon) của module — mỗi view TỰ CHỨA vì ViewLocator dựng view độc lập
         trước khi gắn cây (xem chú thích ở OrdersView.axaml / ModuleResources.axaml). -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://XuLyDonShopee.App/Styles/ModuleResources.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- (Không có Style cục bộ: ô lọc shop dùng ComboBox — id shop là SỐ nên phải CHỌN, không gõ tự do được;
         nút/bảng lấy nguyên hệ chung từ Controls.axaml + Theme.axaml.) -->

    <DockPanel Margin="24,24,32,24">

        <!-- Tiêu đề -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Đơn toàn hệ thống" FontSize="19" FontWeight="Bold" LetterSpacing="-0.3"
                       Foreground="{StaticResource TextInk}" />
            <TextBlock Text="Đơn của MỌI shop / MỌI máy, đọc thẳng từ Hub — chỉ để xem (máy này không xử lý)"
                       FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Thanh lọc: shop · trạng thái · tìm kiếm · Tải lại. LỌC CHẠY PHÍA HUB (không lọc trong bộ nhớ). -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="260,200,*,Auto" Margin="0,0,0,12">
            <ComboBox Grid.Column="0" Classes="field" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding ShopOptions}"
                      SelectedItem="{Binding SelectedShop}"
                      ToolTip.Tip="Lọc theo shop trên Hub (mọi máy)">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch" Margin="8,0,0,0"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding SelectedStatus}" />

            <Border Grid.Column="2" Classes="field" Margin="8,0,0,0">
                <Grid>
                    <TextBox Classes="bare" Margin="12,0,32,0" Text="{Binding SearchText}"
                             Watermark="Tìm mã đơn / người mua / sản phẩm / SKU" />
                    <Border Classes="underline" />
                    <!-- Nút xóa NẰM TRONG ô nhập → dáng .ghostIcon (không viền, 24×24) như màn Đơn hàng. -->
                    <Button Classes="ghostIcon" Width="24" Height="24"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            ToolTip.Tip="Xóa từ khóa tìm kiếm">
                        <PathIcon Data="{DynamicResource IconClose}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Màn CHỈ ĐỌC: nút duy nhất là Tải lại (không in / không xuất / không sửa đơn của máy khác). -->
            <Button Grid.Column="3" Classes="primary" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsLoading}"
                    ToolTip.Tip="Hỏi lại Hub: danh sách shop + trang đơn hiện tại">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <PathIcon Data="{DynamicResource IconRefresh}" />
                    <TextBlock Text="Tải lại" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Dòng tổng số + phân trang (pager BÊN PHẢI) — tổng do HUB đếm, không phải đếm dòng đã tải. -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="{Binding TotalText}" VerticalAlignment="Center"
                       Foreground="{StaticResource Text5A}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Classes="secondary" Height="30" Padding="10,4" Content="‹ Trước"
                        Command="{Binding PrevPageCommand}" ToolTip.Tip="Trang trước" />
                <TextBlock Text="{Binding PageInfoText}" VerticalAlignment="Center"
                           Foreground="{StaticResource Text5A}" />
                <Button Classes="secondary" Height="30" Padding="10,4" Content="Sau ›"
                        Command="{Binding NextPageCommand}" ToolTip.Tip="Trang sau" />
                <ComboBox Classes="field" Width="96" MinHeight="30" VerticalAlignment="Center"
                          ItemsSource="{Binding PageSizeOptions}"
                          SelectedItem="{Binding PageSize}"
                          ToolTip.Tip="Số đơn mỗi trang" />
                <TextBlock Text="/trang" VerticalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextMuted}" />
            </StackPanel>
        </Grid>

        <!-- Vùng nội dung: LƯỚI hoặc THÔNG BÁO. Ba ca "không có dòng nào" (chưa kết nối Hub / Hub không phản
             hồi / Hub có 0 đơn) PHẢI đọc ra được khác nhau — chống "hỏng im lặng" kiểu lưới trống câm. -->
        <Grid>
            <DataGrid x:Name="HubOrdersGrid"
                      Classes="proxy"
                      ClipToBounds="True"
                      IsVisible="{Binding HasRows}"
                      ItemsSource="{Binding Rows}"
                      IsReadOnly="True"
                      AutoGenerateColumns="False"
                      CanUserResizeColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderSn}" Width="140" />
                    <DataGridTextColumn Header="Shop" Binding="{Binding ShopLabel}" Width="1.7*" MinWidth="120" />
                    <DataGridTextColumn Header="Người mua" Binding="{Binding Buyer}" Width="1.2*" />
                    <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Product}" Width="2*" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="80" />
                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding Total}" Width="105" />
                    <DataGridTextColumn Header="Ước tính" Binding="{Binding Estimate}" Width="105" />
                    <!-- Trạng thái: badge PILL nền nhạt + chữ đậm, màu theo từ khóa — Y HỆT màn "Đơn hàng". -->
                    <DataGridTemplateColumn Header="Trạng thái" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="10,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        BorderThickness="1"
                                        Background="{Binding Status, Converter={StaticResource OrderStatusPill}, ConverterParameter=bg}"
                                        BorderBrush="{Binding Status, Converter={StaticResource OrderStatusPill}, ConverterParameter=border}"
                                        IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding Status, Converter={StaticResource OrderStatusPill}, ConverterParameter=text}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Vận chuyển" Binding="{Binding Shipping}" Width="1.6*" MinWidth="140" />
                    <DataGridTextColumn Header="Đồng bộ lúc" Binding="{Binding SyncedAtDisplay}" Width="140" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Classes="card" IsVisible="{Binding ShowMessage}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <TextBlock Text="{Binding EmptyMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                           FontSize="13" Foreground="{StaticResource TextMuted}" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
