<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:XuLyDonShopee.App.Controls"
                    xmlns:b="clr-namespace:XuLyDonShopee.App.Behaviors">

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         STYLE DÙNG CHUNG của module Đơn hàng — port từ Styles/Controls.axaml (Avalonia).

         QUY ƯỚC DỊCH (giống bảng ở đầu Themes/Theme.xaml của suite):
             Classes="card"            →  Style="{StaticResource card}"
             Classes="primary iconOnly" →  Style="{StaticResource primaryIconOnly}"  (WPF không cộng dồn class)
             Selector "X:pointerover"   →  Trigger IsMouseOver / IsKeyboardFocusWithin
             Selector "X /template/ Y"  →  đặt thẳng trong ControlTemplate viết lại
         File này KHÔNG merge vào Application: mỗi view/dialog merge Styles/ModuleResources.xaml vào
         Resources RIÊNG → style + token cam của module chỉ áp trong phạm vi module.

         KHÔNG PORT (0 chỗ dùng sau khi module thành DLL của shell — nav dọc/ngang, thanh trên và thanh
         trạng thái đáy đã dời lên shell suite; danh sách log dạng ListBox đã đổi sang TextBox):
             ListBox.nav*, Border.nav-pill, TextBlock.nav-*, ListBox.navTop*, TextBlock.nav-top-*,
             Border.topbar / Border.statusBar / TextBlock.statusText / TextBlock.statusSep,
             ListBox.acct + Border.acct-card, ListBox.logDark, Button.accent/.accentOutline/.iconDanger,
             NumericUpDown.field (WPF không có NumericUpDown; ô duy nhất dùng nó — "Chu kỳ theo dõi đơn" —
             nằm ở màn Cài đặt gộp bên suite và đã đổi sang TextBox theo QĐ 15).
         ══════════════════════════════════════════════════════════════════════════════════════════════ -->

    <!-- BẮT BUỘC merge Colors NGAY TẠI ĐÂY (không chỉ ở ModuleResources): `{StaticResource TextMuted}`… bên
         dưới được phân giải trong phạm vi CHÍNH file này — tức là các entry của nó + các dictionary NÓ merge
         + (dự phòng) Application. Colors.xaml nằm CẠNH file này trong ModuleResources là "anh em", KHÔNG
         thuộc phạm vi đó. Thiếu dòng merge này, các key riêng của module (TextMuted/CardBg/Border010…) ra
         `DependencyProperty.UnsetValue` → gán vào Foreground là NÉM lúc dựng cây (đã đo: app chết ngay khi
         mở, crash log "'{DependencyProperty.UnsetValue}' is not a valid value for property 'Foreground'").
         Các key TRÙNG TÊN với suite (AccentBrush/SuccessBrush/DangerBrush) thì "may" mà rơi đúng dự phòng
         Application — càng dễ che lỗi, nên đừng dựa vào. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/XuLyDonShopee.App;component/Styles/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- =========================================================
         1. ICON TRONG NÚT — cỡ 12, mặc định xám trung tính
         =========================================================
         ĐÚNG BẰNG theme suite ("Button PathIcon" cỡ 12) để nút cùng vai của 2 module đứng cạnh nhau icon
         không to nhỏ khác nhau. Đây là style MẶC ĐỊNH của c:PathIcon (kiểu RIÊNG của module — suite có
         kiểu PathIcon riêng, style của suite không áp được sang kiểu này và ngược lại).

         Luật nút (người dùng chốt 2026-07-26): "không dùng bg cho button, chỉ dùng icon màu, button dùng
         mặc định" ⇒ các style nút dưới đây KHÔNG có setter nền/viền/chữ, chỉ đổi MÀU ICON (qua
         Style.Resources — cách WPF làm "selector con" của Avalonia). -->
    <Style TargetType="{x:Type c:PathIcon}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:PathIcon}">
                    <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}"
                          Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn chữ trong nút "icon + nhãn" (Avalonia: StackPanel Spacing="7"). WPF không có Spacing → style
         này lo cả khoảng cách lẫn canh giữa dọc, dùng cho TextBlock đứng sau icon. -->
    <Style x:Key="btnLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>

    <!-- =========================================================
         2. HỆ NÚT — MỘT DÁNG DUY NHẤT (của theme suite), MÀU NGỮ NGHĨA CHỈ Ở ICON
         ========================================================= -->

    <!-- Hành động CHÍNH → icon CAM. -->
    <Style x:Key="primary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- .secondary = ĐÚNG dáng mặc định, icon xám → không cần setter nào. Giữ tên vì view đang dùng. -->
    <Style x:Key="secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" />

    <!-- Thành công / xác nhận → icon XANH. -->
    <Style x:Key="success" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- Nguy hiểm (cảnh báo) / XÓA THẬT → icon ĐỎ. Hai tên, một biểu hiện (như bản Avalonia). -->
    <Style x:Key="danger" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="destructive" TargetType="{x:Type Button}" BasedOn="{StaticResource danger}" />

    <!-- Nút VUÔNG chỉ có icon: 30×30 (bo góc do dáng chung lo). WPF không cộng dồn class nên các tổ hợp
         đang dùng ở view được khai sẵn thành key riêng. -->
    <Style x:Key="iconOnly" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="primaryIconOnly" TargetType="{x:Type Button}" BasedOn="{StaticResource iconOnly}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="destructiveIconOnly" TargetType="{x:Type Button}" BasedOn="{StaticResource iconOnly}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- =========================================================
         3. NÚT GHOST NHỎ (con mắt mật khẩu, ✕ xóa lọc) — NGOẠI LỆ: nằm TRONG ô nhập nên không viền riêng
         ========================================================= -->
    <Style x:Key="ghostIcon" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text7A}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="#0D000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         4. CARD
         ========================================================= -->
    <Style x:Key="card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- =========================================================
         5. SECTION LABEL (tiêu đề nhóm cam, chữ HOA) + FIELD LABEL
         ========================================================= -->
<!-- LetterSpacing="0.6" của Avalonia: WPF không có → bỏ (QĐ 16 của plan tổng). -->
    <Style x:Key="section" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style x:Key="fieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Tiêu đề trang — khớp `h1` của suite (Segoe UI 17 / Medium / màu chữ chính) để đồng bộ với Workspace. -->
    <Style x:Key="h1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
    </Style>

    <!-- =========================================================
         6. FIELD INPUT (kiểu Fluent underline)
         ========================================================= -->
    <!-- Cao 30 + chữ 12.5: đúng cỡ ô nhập của suite để ô nhập & nút của 2 module cùng chiều cao. -->
    <Style x:Key="field" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Gạch dưới: xám thường, CAM khi con trỏ bàn phím đang ở TRONG ô (Avalonia: `Border.field:focus-within
         Border.underline`). WPF không có selector cha → DataTrigger leo tổ tiên Border gần nhất = chính
         Border.field bọc ngoài. -->
    <Style x:Key="underline" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="2" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{StaticResource UnderlineBrush}" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                         Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox TRẦN (không viền/nền) nằm trong Border.field. Template viết lại vì phải chèn gợi ý mờ
         (Avalonia có Watermark sẵn; WPF không) — b:WatermarkAssist là bản RIÊNG của module. PHẢI dùng
         TemplateBinding cho attached property, KHÔNG dùng {Binding (b:…), RelativeSource=TemplatedParent}:
         Path dạng chuỗi có prefix chỉ phân giải LÚC CHẠY theo xmlns của file XAML khai ô nhập → view nào
         không khai prefix sẽ ăn "BindingExpression path error 40" (bài học đợt 2 bên suite). -->
    <Style x:Key="bare" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="PART_Watermark"
                                   Text="{TemplateBinding b:WatermarkAssist.Watermark}"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   FontSize="{TemplateBinding FontSize}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="b:WatermarkAssist.HasText" Value="False" />
                                <Condition Property="IsFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô MẬT KHẨU trần trong Border.field — bản Avalonia dùng `TextBox PasswordChar="●"
         RevealPassword="{Binding …}"`; WPF không có PasswordChar trên TextBox nên ô che là PasswordBox
         (bind qua b:PasswordBoxAssist) đặt CHỒNG với một TextBox `bare` (ô hiện), nút con mắt đổi
         Visibility giữa hai ô. -->
    <Style x:Key="barePassword" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         7. COMBOBOX FIELD
         ========================================================= -->
    <!-- CornerRadius của Avalonia BỎ khỏi đây: ComboBox WPF không có thuộc tính đó — bo góc nằm trong
         TEMPLATE. Từ đợt 6 template PHẲNG do `Themes/Theme.xaml` của suite cấp (implicit style
         `{x:Type ComboBox}`, tra được nhờ dự phòng Application.Resources — cùng đường với `{x:Type Button}`),
         nên style này chỉ còn đè token màu/cỡ của module lên trên. Padding 12,0 ăn khớp với lề 13/34 của
         lớp gợi ý mờ + nút xoá lọc phủ lên ô "gõ để lọc shop" ở OrdersView — đổi Padding thì đo lại chỗ đó. -->
    <Style x:Key="fieldCombo" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- =========================================================
         7b. Ô CHỌN NGÀY (DatePicker + lịch bung ra)
         =========================================================
         Style IMPLICIT (không key) → áp cho CẢ 5 ô ngày của module: 1 ở AccountsView (tab Shops), 2 ở
         OrderStatisticsView, 2 ở OrdersView. Không có style nào cho DatePicker/Calendar ở module lẫn
         Themes/Theme.xaml của suite ⇒ trước đây 5 ô này rơi về theme Aero2 mặc định (viền xanh bo tròn, lịch
         đổ gradient) — lạc hẳn khỏi các ô nhập bên cạnh.

         HAI ĐIỂM DỄ HỎNG:
         · Language="vi-VN" đặt NGAY TRONG style: WPF lấy culture hiển thị của DatePicker từ
           FrameworkElement.Language, để mặc định thì máy đặt vùng Mỹ hiện 8/6/2026 trong khi cả app viết
           06/08/2026 — cùng một màn hai định dạng, đọc nhầm ngày↔tháng như chơi.
         · TÊN PART trong template là HỢP ĐỒNG với DatePicker.OnApplyTemplate: PART_TextBox (ô chữ),
           PART_Button (nút mở lịch), PART_Popup (khay lịch). Gõ sai một tên thì BUILD VẪN XANH mà ô ngày CHẾT
           CÂM (bấm không bung lịch) — đổi template phải soi lại 3 tên này.
         Nút PART_Button CỐ Ý không có ContentPresenter: DatePicker tự gán Content = chuỗi trợ năng khi thấy
         Content null, có ContentPresenter là chữ đó hiện ra cạnh icon. -->
    <Style TargetType="{x:Type DatePicker}">
        <Setter Property="Language" Value="vi-VN" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <!-- Lịch bung ra nằm trong Popup = cây hiển thị RIÊNG, KHÔNG tra được style implicit của view → phải
             gắn tường minh. DynamicResource (không phải Static) vì `lichBungRa` khai SAU style này trong cùng
             dictionary; đo tận nơi trước khi có dòng này: CalendarDayButton.Style = null, vẫn là Aero2. -->
        <Setter Property="CalendarStyle" Value="{DynamicResource lichBungRa}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <!-- Lề TRÁI của ô chữ (nút lịch tự lo lề phải) — khớp Padding 12,0 của fieldCombo. -->
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePicker}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Root">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                               Margin="{TemplateBinding Padding}"
                                               Focusable="{TemplateBinding Focusable}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               HorizontalContentAlignment="Stretch"
                                               VerticalContentAlignment="Center" />
                            <Button x:Name="PART_Button" Grid.Column="1" Focusable="False"
                                    Width="26" Margin="2" Padding="0"
                                    Background="Transparent" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="btnBd" Background="{TemplateBinding Background}"
                                                CornerRadius="3">
                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{StaticResource TextMuted}"
                                                  Data="M20 3h-1V1h-2v2H7V1H5v2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 18H4V8h16v13z" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="btnBd" Property="Background"
                                                        Value="{StaticResource ButtonHoverBg}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_TextBox}" StaysOpen="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="BorderBrush" Value="{StaticResource BorderHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô CHỮ bên trong DatePicker. Template mặc định Aero2 tự vẽ MỘT hộp riêng (Border lấy
         BorderBrush/Background của chính nó) → không dẹp thì lồng hai khung trong một ô. Rút còn đúng
         PART_ContentHost (giống style `bare` của TextBox); mất luôn chữ mờ "Select a date" của Aero2 —
         đúng ý (nhãn "Từ ngày"/"Đến ngày"/"Ngày:" đã đứng ngay bên trái). -->
    <Style TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lịch bung ra (Popup của DatePicker). Chỉ đè token màu — TEMPLATE giữ của theme nền tảng (Calendar
         truyền Background/BorderBrush xuống CalendarItem) nên không phải nuôi lại cả bộ nút chuyển tháng.

         BẪY ĐÃ DÍNH (06/08/2026): để style này (và style ô ngày bên dưới) ở dạng IMPLICIT là VÔ TÁC DỤNG với
         lịch của DatePicker. Lịch nằm trong Popup — cây hiển thị RIÊNG — nên tra style implicit KHÔNG với tới
         ResourceDictionary của view; đo tận nơi thấy `CalendarDayButton.Style = null`, template vẫn là Aero2
         (viền xanh + nền xám) trong khi build xanh và test vẫn xanh. Đường ĐÚNG là gắn TƯỜNG MINH qua
         `DatePicker.CalendarStyle` → `Calendar.CalendarDayButtonStyle` (xem setter ở style DatePicker phía trên).
         Giữ luôn bản implicit cho <Calendar> đứng rời trong view (hiện chưa có, nhưng khỏi lệch diện mạo). -->
    <!-- Ô NGÀY trong lịch: PHẲNG (Aero2 vẽ gradient + viền xanh cho hover/hôm nay/đang chọn). Thứ tự trigger
         quan trọng — trigger sau thắng: hôm nay (viền cam) đứng TRƯỚC đang chọn (nền cam) để ngày hôm nay mà
         đang được chọn vẫn tô nền đặc, không chỉ có viền.
         KHAI TRƯỚC style Calendar: StaticResource chỉ thấy key khai trước nó trong cùng dictionary. -->
    <Style x:Key="ngayTrongLich" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Border x:Name="dayBd" Margin="1" CornerRadius="4"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Ngày của tháng khác → chìm hẳn. -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Text9A}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dayBd" Property="Background" Value="{StaticResource ButtonHoverBg}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="dayBd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="dayBd" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="dayBd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <!-- Ngày bị khóa (BlackoutDates) — module chưa dùng, giữ cho đủ trạng thái. -->
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type CalendarDayButton}" BasedOn="{StaticResource ngayTrongLich}" />

    <Style x:Key="lichBungRa" TargetType="{x:Type Calendar}">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <!-- Gắn TƯỜNG MINH: style implicit của CalendarDayButton không với tới được lịch trong Popup. -->
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource ngayTrongLich}" />
    </Style>
    <Style TargetType="{x:Type Calendar}" BasedOn="{StaticResource lichBungRa}" />

    <!-- =========================================================
         8. TOGGLE SWITCH (track + núm trượt)
         ========================================================= -->
    <!-- Núm PHẲNG (không đổ bóng) theo hướng UI phẳng Win 11. Bản Avalonia không có animation nên WPF chỉ
         cần Trigger IsChecked đổi HorizontalAlignment của núm. (Hiện chưa view nào dùng — giữ để không mất
         từ vựng style khi module cần công tắc trở lại.) -->
    <Style x:Key="switch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Padding="2"
                            Background="{StaticResource ToggleOffBrush}">
                        <Border x:Name="knob" Width="20" Height="20" CornerRadius="10"
                                Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         9. DATAGRID (theme sáng — lưới đơn hàng & lưới kết quả)
         ========================================================= -->
    <!-- CornerRadius="6" của Avalonia BỎ: DataGrid WPF không có CornerRadius (bọc trong Border nếu cần).
         Nền/hover/chọn của DÒNG lấy nguyên style DataGridRow nền tảng của suite: hover #FFFAF8, chọn
         #FFF3EF — TRÙNG khớp AccentSoft1 mà bản Avalonia dùng cho `DataGridRow:selected`, nên không phải
         khai lại RowStyle. -->
    <!-- Đầu cột: dải nền #F7F7F7, chữ 12/SemiBold màu phụ (Avalonia: `DataGrid.proxy DataGridColumnHeader`).
         PHẢI khai TRƯỚC style `proxy` — StaticResource trong ResourceDictionary chỉ thấy key khai trước nó. -->
    <Style x:Key="proxyHeader" TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="#F7F7F7" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="proxy" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border06}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource proxyHeader}" />
    </Style>

    <!-- =========================================================
         10. PANEL NHẬT KÝ ĐEN — nút "Copy"/"Xóa" trên nền đen
         ========================================================= -->
    <Style x:Key="logClear" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#D8D8D8" />
        <Setter Property="Background" Value="#2A2A2A" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="#363636" />
                            <Setter TargetName="PART_bd" Property="BorderBrush" Value="#4A4A4A" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
