<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:XuLyDonShopee.App.Controls"
                    xmlns:b="clr-namespace:XuLyDonShopee.App.Behaviors">

    <!-- ══════════════════════════════════════════════════════════════════════════════════════════════
         STYLE DÙNG CHUNG của module Đơn hàng — port từ Styles/Controls.axaml (Avalonia).

         QUY ƯỚC DỊCH (giống bảng ở đầu Themes/Theme.xaml của suite):
             Classes="card"            →  Style="{StaticResource card}"
             Classes="primary iconOnly" →  Style="{StaticResource primaryIconOnly}"  (WPF không cộng dồn class)
             Selector "X:pointerover"   →  Trigger IsMouseOver / IsKeyboardFocusWithin
             Selector "X /template/ Y"  →  đặt thẳng trong ControlTemplate viết lại
         File này KHÔNG merge vào Application: mỗi view/dialog merge Styles/ModuleResources.xaml vào
         Resources RIÊNG → style + token cam của module chỉ áp trong phạm vi module.

         KHÔNG PORT (0 chỗ dùng sau khi module thành DLL của shell — nav dọc/ngang, thanh trên và thanh
         trạng thái đáy đã dời lên shell suite; danh sách log dạng ListBox đã đổi sang TextBox):
             ListBox.nav*, Border.nav-pill, TextBlock.nav-*, ListBox.navTop*, TextBlock.nav-top-*,
             Border.topbar / Border.statusBar / TextBlock.statusText / TextBlock.statusSep,
             ListBox.acct + Border.acct-card, ListBox.logDark, Button.accent/.accentOutline/.iconDanger,
             NumericUpDown.field (WPF không có NumericUpDown; ô duy nhất dùng nó — "Chu kỳ theo dõi đơn" —
             nằm ở màn Cài đặt gộp bên suite và đã đổi sang TextBox theo QĐ 15).
         ══════════════════════════════════════════════════════════════════════════════════════════════ -->

    <!-- BẮT BUỘC merge Colors NGAY TẠI ĐÂY (không chỉ ở ModuleResources): `{StaticResource TextMuted}`… bên
         dưới được phân giải trong phạm vi CHÍNH file này — tức là các entry của nó + các dictionary NÓ merge
         + (dự phòng) Application. Colors.xaml nằm CẠNH file này trong ModuleResources là "anh em", KHÔNG
         thuộc phạm vi đó. Thiếu dòng merge này, các key riêng của module (TextMuted/CardBg/Border010…) ra
         `DependencyProperty.UnsetValue` → gán vào Foreground là NÉM lúc dựng cây (đã đo: app chết ngay khi
         mở, crash log "'{DependencyProperty.UnsetValue}' is not a valid value for property 'Foreground'").
         Các key TRÙNG TÊN với suite (AccentBrush/SuccessBrush/DangerBrush) thì "may" mà rơi đúng dự phòng
         Application — càng dễ che lỗi, nên đừng dựa vào. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/XuLyDonShopee.App;component/Styles/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- =========================================================
         1. ICON TRONG NÚT — cỡ 14, mặc định xám trung tính
         =========================================================
         ĐÚNG BẰNG theme suite ("Button PathIcon" cỡ 14) để nút cùng vai của 2 module đứng cạnh nhau icon
         không to nhỏ khác nhau. Đây là style MẶC ĐỊNH của c:PathIcon (kiểu RIÊNG của module — suite có
         kiểu PathIcon riêng, style của suite không áp được sang kiểu này và ngược lại).

         Luật nút (người dùng chốt 2026-07-26): "không dùng bg cho button, chỉ dùng icon màu, button dùng
         mặc định" ⇒ các style nút dưới đây KHÔNG có setter nền/viền/chữ, chỉ đổi MÀU ICON (qua
         Style.Resources — cách WPF làm "selector con" của Avalonia). -->
    <Style TargetType="{x:Type c:PathIcon}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:PathIcon}">
                    <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}"
                          Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Nhãn chữ trong nút "icon + nhãn" (Avalonia: StackPanel Spacing="7"). WPF không có Spacing → style
         này lo cả khoảng cách lẫn canh giữa dọc, dùng cho TextBlock đứng sau icon. -->
    <Style x:Key="btnLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="7,0,0,0" />
    </Style>

    <!-- =========================================================
         2. HỆ NÚT — MỘT DÁNG DUY NHẤT (của theme suite), MÀU NGỮ NGHĨA CHỈ Ở ICON
         ========================================================= -->

    <!-- Hành động CHÍNH → icon CAM. -->
    <Style x:Key="primary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- .secondary = ĐÚNG dáng mặc định, icon xám → không cần setter nào. Giữ tên vì view đang dùng. -->
    <Style x:Key="secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" />

    <!-- Thành công / xác nhận → icon XANH. -->
    <Style x:Key="success" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- Nguy hiểm (cảnh báo) / XÓA THẬT → icon ĐỎ. Hai tên, một biểu hiện (như bản Avalonia). -->
    <Style x:Key="danger" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="destructive" TargetType="{x:Type Button}" BasedOn="{StaticResource danger}" />

    <!-- Nút VUÔNG chỉ có icon: 30×30 (bo góc do dáng chung lo). WPF không cộng dồn class nên các tổ hợp
         đang dùng ở view được khai sẵn thành key riêng. -->
    <Style x:Key="iconOnly" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="primaryIconOnly" TargetType="{x:Type Button}" BasedOn="{StaticResource iconOnly}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            </Style>
        </Style.Resources>
    </Style>
    <Style x:Key="destructiveIconOnly" TargetType="{x:Type Button}" BasedOn="{StaticResource iconOnly}">
        <Style.Resources>
            <Style TargetType="{x:Type c:PathIcon}" BasedOn="{StaticResource {x:Type c:PathIcon}}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- =========================================================
         3. NÚT GHOST NHỎ (con mắt mật khẩu, ✕ xóa lọc) — NGOẠI LỆ: nằm TRONG ô nhập nên không viền riêng
         ========================================================= -->
    <Style x:Key="ghostIcon" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Text7A}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="#0D000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         4. CARD
         ========================================================= -->
    <Style x:Key="card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- =========================================================
         5. SECTION LABEL (tiêu đề nhóm cam, chữ HOA) + FIELD LABEL
         ========================================================= -->
<!-- LetterSpacing="0.6" của Avalonia: WPF không có → bỏ (QĐ 16 của plan tổng). -->
    <Style x:Key="section" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style x:Key="fieldLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Tiêu đề trang — khớp `h1` của suite (Segoe UI 17 / Medium / màu chữ chính) để đồng bộ với Workspace. -->
    <Style x:Key="h1" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
    </Style>

    <!-- =========================================================
         6. FIELD INPUT (kiểu Fluent underline)
         ========================================================= -->
    <!-- Cao 30 + chữ 12.5: đúng cỡ ô nhập của suite để ô nhập & nút của 2 module cùng chiều cao. -->
    <Style x:Key="field" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- Gạch dưới: xám thường, CAM khi con trỏ bàn phím đang ở TRONG ô (Avalonia: `Border.field:focus-within
         Border.underline`). WPF không có selector cha → DataTrigger leo tổ tiên Border gần nhất = chính
         Border.field bọc ngoài. -->
    <Style x:Key="underline" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="2" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Background" Value="{StaticResource UnderlineBrush}" />
        <Setter Property="Margin" Value="1,0,1,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType={x:Type Border}}}"
                         Value="True">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- TextBox TRẦN (không viền/nền) nằm trong Border.field. Template viết lại vì phải chèn gợi ý mờ
         (Avalonia có Watermark sẵn; WPF không) — b:WatermarkAssist là bản RIÊNG của module. PHẢI dùng
         TemplateBinding cho attached property, KHÔNG dùng {Binding (b:…), RelativeSource=TemplatedParent}:
         Path dạng chuỗi có prefix chỉ phân giải LÚC CHẠY theo xmlns của file XAML khai ô nhập → view nào
         không khai prefix sẽ ăn "BindingExpression path error 40" (bài học đợt 2 bên suite). -->
    <Style x:Key="bare" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid Background="Transparent">
                        <TextBlock x:Name="PART_Watermark"
                                   Text="{TemplateBinding b:WatermarkAssist.Watermark}"
                                   Foreground="{StaticResource PlaceholderBrush}"
                                   FontSize="{TemplateBinding FontSize}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="b:WatermarkAssist.HasText" Value="False" />
                                <Condition Property="IsFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ô MẬT KHẨU trần trong Border.field — bản Avalonia dùng `TextBox PasswordChar="●"
         RevealPassword="{Binding …}"`; WPF không có PasswordChar trên TextBox nên ô che là PasswordBox
         (bind qua b:PasswordBoxAssist) đặt CHỒNG với một TextBox `bare` (ô hiện), nút con mắt đổi
         Visibility giữa hai ô. -->
    <Style x:Key="barePassword" TargetType="{x:Type PasswordBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="PasswordChar" Value="●" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         7. COMBOBOX FIELD
         ========================================================= -->
    <!-- CornerRadius của Avalonia BỎ khỏi đây: ComboBox WPF không có thuộc tính đó — bo góc nằm trong
         TEMPLATE. Từ đợt 6 template PHẲNG do `Themes/Theme.xaml` của suite cấp (implicit style
         `{x:Type ComboBox}`, tra được nhờ dự phòng Application.Resources — cùng đường với `{x:Type Button}`),
         nên style này chỉ còn đè token màu/cỡ của module lên trên. Padding 12,0 ăn khớp với lề 13/34 của
         lớp gợi ý mờ + nút xoá lọc phủ lên ô "gõ để lọc shop" ở OrdersView — đổi Padding thì đo lại chỗ đó. -->
    <Style x:Key="fieldCombo" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{StaticResource InputBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextInk}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!-- =========================================================
         8. TOGGLE SWITCH (track + núm trượt)
         ========================================================= -->
    <!-- Núm PHẲNG (không đổ bóng) theo hướng UI phẳng Win 11. Bản Avalonia không có animation nên WPF chỉ
         cần Trigger IsChecked đổi HorizontalAlignment của núm. (Hiện chưa view nào dùng — giữ để không mất
         từ vựng style khi module cần công tắc trở lại.) -->
    <Style x:Key="switch" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="track" Width="42" Height="24" CornerRadius="12" Padding="2"
                            Background="{StaticResource ToggleOffBrush}">
                        <Border x:Name="knob" Width="20" Height="20" CornerRadius="10"
                                Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================================================
         9. DATAGRID (theme sáng — lưới đơn hàng & lưới kết quả)
         ========================================================= -->
    <!-- CornerRadius="6" của Avalonia BỎ: DataGrid WPF không có CornerRadius (bọc trong Border nếu cần).
         Nền/hover/chọn của DÒNG lấy nguyên style DataGridRow nền tảng của suite: hover #FFFAF8, chọn
         #FFF3EF — TRÙNG khớp AccentSoft1 mà bản Avalonia dùng cho `DataGridRow:selected`, nên không phải
         khai lại RowStyle. -->
    <!-- Đầu cột: dải nền #F7F7F7, chữ 12/SemiBold màu phụ (Avalonia: `DataGrid.proxy DataGridColumnHeader`).
         PHẢI khai TRƯỚC style `proxy` — StaticResource trong ResourceDictionary chỉ thấy key khai trước nó. -->
    <Style x:Key="proxyHeader" TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="#F7F7F7" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="proxy" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource CardBg}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border010}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Border06}" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource proxyHeader}" />
    </Style>

    <!-- =========================================================
         10. PANEL NHẬT KÝ ĐEN — nút "Copy"/"Xóa" trên nền đen
         ========================================================= -->
    <Style x:Key="logClear" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="#D8D8D8" />
        <Setter Property="Background" Value="#2A2A2A" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="PART_bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_bd" Property="Background" Value="#363636" />
                            <Setter TargetName="PART_bd" Property="BorderBrush" Value="#4A4A4A" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
