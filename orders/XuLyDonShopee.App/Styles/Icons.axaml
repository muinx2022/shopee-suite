<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ BỘ ICON HÀNH ĐỘNG DÙNG CHUNG TOÀN APP (Material filled, viewbox 24×24, ĐƠN SẮC) ═══
         Đặt ở project TẦNG DƯỚI (XuLyDonShopee.App) vì chiều tham chiếu là Shopee.Suite → XuLyDonShopee.App:
         để ở suite thì module Đơn hàng KHÔNG với tới được. Cả 2 module merge CHUNG file này:
           · orders — `Styles/ModuleResources.axaml` (mỗi view orders đã merge file đó);
           · suite  — `App.axaml` qua `avares://XuLyDonShopee.App/Styles/Icons.axaml`.
         MỘT NGUỒN DUY NHẤT — không nhân bản path data ở nơi khác. (`Shopee.Suite/Infrastructure/AppIcons.cs`
         nay CHỈ còn 10 icon ĐIỀU HƯỚNG của ribbon, vì ribbon bind icon qua ViewModel nên cần `string` ở C#.)

         Dùng: <PathIcon Data="{DynamicResource IconSave}" />  — KHÔNG đặt Foreground tại chỗ dùng, để class
         của nút quyết màu (Themes/Theme.axaml: .primary → cam · .destructive/.danger → đỏ · .success → xanh ·
         mặc định → xám).

         ══════════ BẢNG ÁNH XẠ CHUẨN — HÀNH ĐỘNG → ICON ══════════
         MỖI HÀNH ĐỘNG ĐÚNG MỘT ICON. Thêm icon mới thì PHẢI cập nhật bảng này; hành động đã có trong bảng
         thì dùng lại đúng key ở đây, KHÔNG tự chế glyph/emoji mới.

         | Hành động                | Key              | Thay cho glyph cũ            |
         |══════════════════════════|══════════════════|══════════════════════════════|
         | Chạy / Bắt đầu           | IconPlay         | ▶ · "Chạy"                   |
         | Dừng                     | IconStop         | ■ · ✕ (nghĩa dừng) · "Dừng"  |
         | Tạm dừng                 | IconPause        | ⏸                            |
         | Tiếp tục                 | IconResume       | ⏯ (cùng hình mũi tên Play)   |
         | Tải lại / Làm mới        | IconRefresh      | ↻ ⟳ ⟲ ↺ 🔄 · "Làm mới"       |
         | Lưu                      | IconSave         | 💾 ✔ ✓ · "Lưu"               |
         | Xóa                      | IconDelete       | 🗑 − ✖ · "Xóa"               |
         | Thêm                     | IconAdd          | + ➕                          |
         | Nhập (import)            | IconImport       | ⬇ ⇧ · "Import"               |
         | Xuất (export)            | IconExport       | ⬆ 📦 · "Xuất CSV"            |
         | Mở thư mục / duyệt       | IconFolder       | 📂 📁 …                       |
         | Mở liên kết ngoài        | IconOpenExternal | ↗                            |
         | Lọc                      | IconFilter       | 🔍 ▽ · "Lọc"                 |
         | Sửa                      | IconEdit         | ✎ ✏                          |
         | Đồng ý / Xác nhận        | IconCheck        | ✓ ✔ · "Đồng ý" · "OK"        |
         | Chọn tất cả              | IconCheckAll     | ✓ ✔ ☑                        |
         | Bỏ chọn                  | IconUncheck      | ✖ ✕ (nghĩa bỏ chọn)          |
         | Cập nhật app             | IconUpgrade      | ⬆ 🔄                          |
         | Thống kê                 | IconChart        | 📊 ▤                          |
         | Đăng nhập / khoá         | IconLogin        | 🔐                            |
         | Sinh mới / AI            | IconSparkle      | 🆕 🤖 📄 ●                    |
         | Đồng bộ                  | IconSync         | ⇅ ⟲ 🔌                        |
         | Hủy / đóng               | IconClose        | ✕ ↶ · "Hủy" · "Đóng"         |
    -->

    <!-- Mũi tên play — Chạy / Bắt đầu. -->
    <StreamGeometry x:Key="IconPlay">M8 5v14l11-7z</StreamGeometry>

    <!-- Tiếp tục sau khi tạm dừng — CÙNG hình mũi tên với IconPlay (đúng quy ước Material); giữ key riêng
         để chỗ dùng đọc ra đúng ý nghĩa "resume". -->
    <StreamGeometry x:Key="IconResume">M8 5v14l11-7z</StreamGeometry>

    <!-- Ô vuông đặc — Dừng. -->
    <StreamGeometry x:Key="IconStop">M6 6h12v12H6z</StreamGeometry>

    <!-- Hai vạch dọc — Tạm dừng. -->
    <StreamGeometry x:Key="IconPause">M6 19h4V5H6v14zm8-14v14h4V5h-4z</StreamGeometry>

    <!-- Mũi tên vòng tròn — Tải lại / Làm mới. -->
    <StreamGeometry x:Key="IconRefresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-8 8s3.58 8 8 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</StreamGeometry>

    <!-- Đĩa mềm — Lưu. -->
    <StreamGeometry x:Key="IconSave">M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z</StreamGeometry>

    <!-- Thùng rác — Xóa. -->
    <StreamGeometry x:Key="IconDelete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>

    <!-- Dấu cộng — Thêm. -->
    <StreamGeometry x:Key="IconAdd">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>

    <!-- Mũi tên xuống khay — Nhập (import). -->
    <StreamGeometry x:Key="IconImport">M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z</StreamGeometry>

    <!-- Mũi tên lên khỏi khay — Xuất (export). -->
    <StreamGeometry x:Key="IconExport">M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z</StreamGeometry>

    <!-- Thư mục — Mở thư mục / duyệt đường dẫn. -->
    <StreamGeometry x:Key="IconFolder">M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z</StreamGeometry>

    <!-- Ô vuông + mũi tên chéo — Mở liên kết ngoài. -->
    <StreamGeometry x:Key="IconOpenExternal">M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z</StreamGeometry>

    <!-- Phễu lọc — Lọc. -->
    <StreamGeometry x:Key="IconFilter">M4.25 5.61C6.27 8.2 10 13 10 13v6c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-6s3.72-4.8 5.74-7.39c.51-.66.04-1.61-.79-1.61H5.04c-.83 0-1.3.95-.79 1.61z</StreamGeometry>

    <!-- Bút chì — Sửa. -->
    <StreamGeometry x:Key="IconEdit">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>

    <!-- MỘT dấu tích — Đồng ý / Xác nhận (nút OK của hộp thoại). KHÁC IconCheckAll (hai dấu tích = "chọn
         tất cả" trong danh sách) — đừng dùng lẫn. -->
    <StreamGeometry x:Key="IconCheck">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</StreamGeometry>

    <!-- HAI dấu tích chồng nhau — Chọn tất cả. -->
    <StreamGeometry x:Key="IconCheckAll">M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19 23.66 7l-1.42-1.41zM.41 13.41L6 19l1.41-1.41L1.83 12 .41 13.41z</StreamGeometry>

    <!-- Ô vuông rỗng — Bỏ chọn. -->
    <StreamGeometry x:Key="IconUncheck">M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z</StreamGeometry>

    <!-- Mũi tên lên trên vạch — Cập nhật app. -->
    <StreamGeometry x:Key="IconUpgrade">M16 18v2H8v-2h8zM11 7.99V16h2V7.99h3L12 4 8 7.99h3z</StreamGeometry>

    <!-- Biểu đồ cột — Thống kê. -->
    <StreamGeometry x:Key="IconChart">M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z</StreamGeometry>

    <!-- Ổ khóa — Đăng nhập / khoá. -->
    <StreamGeometry x:Key="IconLogin">M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z</StreamGeometry>

    <!-- Chùm tia lấp lánh — Sinh mới / AI. -->
    <StreamGeometry x:Key="IconSparkle">M19 9l1.25-2.75L23 5l-2.75-1.25L19 1l-1.25 2.75L15 5l2.75 1.25L19 9zm-7.5.5L9 4 6.5 9.5 1 12l5.5 2.5L9 20l2.5-5.5L17 12l-5.5-2.5zM19 15l-1.25 2.75L15 19l2.75 1.25L19 23l1.25-2.75L23 19l-2.75-1.25L19 15z</StreamGeometry>

    <!-- Hai mũi tên vòng — Đồng bộ. -->
    <StreamGeometry x:Key="IconSync">M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z</StreamGeometry>

    <!-- Dấu nhân — Hủy / đóng. -->
    <StreamGeometry x:Key="IconClose">M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z</StreamGeometry>
</ResourceDictionary>
