<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Shopee.Hub.Web</RootNamespace>
    <AssemblyName>Shopee.Hub.Web</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Kho code dùng chung (POCO/DTO) được LINK từ suite\ thay vì di chuyển, để KHÔNG đụng project WPF
         đang được agent Avalonia sửa song song. Nếu file gốc bị đổi tên/di chuyển → build gãy rõ ràng. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="Npgsql" Version="8.0.7" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.60.0" />
  </ItemGroup>

  <!-- ── Nguồn dùng chung được LINK (file gốc giữ nguyên trong suite\Shopee.Core & Shopee.Module.Search) ── -->
  <ItemGroup>
    <Compile Include="..\..\suite\Shopee.Core\Coordination\HubDtos.cs" Link="Shared\Coordination\HubDtos.cs" />
    <!-- Suất làm việc (workspace / đơn hàng) + quy ước suy diễn cho client CŨ — hub & client PHẢI cùng một luật. -->
    <Compile Include="..\..\suite\Shopee.Core\Coordination\MachineSlots.cs" Link="Shared\Coordination\MachineSlots.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Coordination\ICoordinationHub.cs" Link="Shared\Coordination\ICoordinationHub.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Coordination\HubDefaults.cs" Link="Shared\Coordination\HubDefaults.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Coordination\HubRoutes.cs" Link="Shared\Coordination\HubRoutes.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Coordination\ProductDtos.cs" Link="Shared\Coordination\ProductDtos.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Coordination\OrderDtos.cs" Link="Shared\Coordination\OrderDtos.cs" />
    <!-- DTO ĐỌC đơn về client (GET /api/orders + /api/shops) — màn "Đơn toàn hệ thống" đọc THẲNG từ hub. -->
    <Compile Include="..\..\suite\Shopee.Core\Coordination\HubOrderDtos.cs" Link="Shared\Coordination\HubOrderDtos.cs" />
    <!-- Cấu hình dùng chung của module Đơn hàng (khối GSheet) — hub là nguồn sự thật, client kéo/đẩy qua /orders-config. -->
    <Compile Include="..\..\suite\Shopee.Core\Coordination\OrdersSharedConfig.cs" Link="Shared\Coordination\OrdersSharedConfig.cs" />
    <!-- Báo "đơn mới" về Slack/Discord/Telegram: helper thuần BCL + POCO đơn — LINK từ module đơn Shopee,
         KHÔNG sửa 2 file gốc (OrderNotifyService cần type SyncedOrder nên link cả hai). -->
    <Compile Include="..\..\orders\XuLyDonShopee.Core\Services\OrderNotifyService.cs" Link="Shared\Notify\OrderNotifyService.cs" />
    <Compile Include="..\..\orders\XuLyDonShopee.Core\Models\SyncedOrder.cs" Link="Shared\Notify\SyncedOrder.cs" />
    <!-- Luật đồng bộ GSheet (validate URL + quyết định áp bản hub) — LINK để trang /config/orders validate
         ĐÚNG CÙNG luật với client, khỏi hub nhận URL mà client từ chối. Thuần BCL. -->
    <Compile Include="..\..\orders\XuLyDonShopee.Core\Services\GsheetConfigSync.cs" Link="Shared\Notify\GsheetConfigSync.cs" />
    <!-- Tách cột "Phân loại" từ items_json — LINK để trang /orders của hub hiện ĐÚNG CÙNG luật với màn Đơn hàng
         của app và với payload Google Sheet (hai nơi tự tính riêng là lệch). Thuần BCL. -->
    <Compile Include="..\..\orders\XuLyDonShopee.Core\Services\PhanLoaiExtractor.cs" Link="Shared\Notify\PhanLoaiExtractor.cs" />
    <!-- Chọn items_json giàu hơn khi upsert — LINK để hub không cho bản nghèo (trang danh sách) đè bản giàu
         (trang chi tiết). SanPhamDonParser phụ thuộc ShopeeShippingNav.ParseVndAmount (thuần BCL). -->
    <Compile Include="..\..\orders\XuLyDonShopee.Core\Services\SanPhamDonParser.cs" Link="Shared\Notify\SanPhamDonParser.cs" />
    <Compile Include="..\..\orders\XuLyDonShopee.Core\Services\ShopeeShippingNav.cs" Link="Shared\Notify\ShopeeShippingNav.cs" />
    <!-- Cổng thao tác kho + exception + LÕI lưới dùng chung — ProductDbDataOps (hub) hiện thực IProductDataOps;
         ProductGridEngine là lõi lưới cho trang /data + tab 📋 Dữ liệu của Fleet. KHÔNG link HubApiProductDataOps:
         adapter-client cần HubClient (chưa link vào hub). -->
    <Compile Include="..\..\suite\Shopee.Core\Products\IProductDataOps.cs" Link="Shared\Products\IProductDataOps.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Products\ProductStoreNotReadyException.cs" Link="Shared\Products\ProductStoreNotReadyException.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Products\ProductGridEngine.cs" Link="Shared\Products\ProductGridEngine.cs" />
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\BigSellerAccount.cs" Link="Shared\BigSeller\BigSellerAccount.cs" />
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\BigSellerRunConfig.cs" Link="Shared\BigSeller\BigSellerRunConfig.cs" />
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\BigSellerShop.cs" Link="Shared\BigSeller\BigSellerShop.cs" />
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\BigSellerColumnMap.cs" Link="Shared\BigSeller\BigSellerColumnMap.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Accounts\ShopeeAccount.cs" Link="Shared\Accounts\ShopeeAccount.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Ai\AiConfig.cs" Link="Shared\Ai\AiConfig.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Ai\AiPrompts.cs" Link="Shared\Ai\AiPrompts.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Ai\AiChat.cs" Link="Shared\Ai\AiChat.cs" />
    <Compile Include="..\..\suite\Shopee.Core\Ai\AiHttpException.cs" Link="Shared\Ai\AiHttpException.cs" />
    <!-- LÕI viết-lại-tên (dedup + gọi AI + ghép SKU/cắt 120) — dùng chung với client; RewriteJobService chạy trên hub. -->
    <Compile Include="..\..\suite\Shopee.Core\Ai\NameRewriteEngine.cs" Link="Shared\Ai\NameRewriteEngine.cs" />
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\BigSellerCaptchaSolver.cs" Link="Shared\BigSeller\BigSellerCaptchaSolver.cs" />
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\BigSellerLoginForm.cs" Link="Shared\BigSeller\BigSellerLoginForm.cs" />
    <!-- Reader tự mở Hotmail/Outlook đọc mã verify 6 số BigSeller (hub tự giải OTP thay vì chờ admin gõ tay). -->
    <Compile Include="..\..\suite\Shopee.Core\BigSeller\HotmailOtpReader.cs" Link="Shared\BigSeller\HotmailOtpReader.cs" />
    <Compile Include="..\..\suite\Shopee.Module.Search\Engine\ProductResult.cs" Link="Shared\Search\ProductResult.cs" />
    <Compile Include="..\..\suite\Shopee.Module.Search\Engine\ExcelExporter.cs" Link="Shared\Search\ExcelExporter.cs" />
    <!-- Cắt tên SP giữ SKU ở đuôi (TruncateProductNamePreservingSku) — REUSE để vá đuôi name_rewritten khi đổi SKU
         khớp BYTE-ĐÚNG cách ProductNameRewriteRunner tạo tên. File static thuần BCL. -->
    <Compile Include="..\..\suite\Shopee.Module.UpdateProduct\Engine\BigSellerText.cs" Link="Shared\UpdateProduct\BigSellerText.cs" />
  </ItemGroup>
</Project>
