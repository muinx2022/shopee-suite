@* Dashboard gọn của ACC (panel phải trang BigSeller "/" khi chưa chọn shop): 4 ô tổng quan theo op (tổng dòng +
   số shop ✓) + việc đang chạy + máy giữ acc + ma-trận shop (trạng thái · số dòng, bấm dòng mở shop). Tab Thống kê
   mức acc đã GỘP vào đây (dòng Tổng nằm cuối bảng). Thuần hiển thị — cú bấm dòng báo lên cha. *@

<div class="kpis acct">
    @foreach (var op in FleetRowsBuilder.OpOrder)
    {
        var s = AcctOpSummary(op);
        <div class="kpi">
            <div>
                <div class="kpi-val">@s.Rows.ToString("N0")</div>
                <div class="kpi-label">@OpLabel(op) · @s.Done/@s.Total shop ✓</div>
            </div>
        </div>
    }
</div>
@foreach (var l in AcctLeases())
{
    <div class="busyline running"><span class="dot"></span> Đang chạy: <b>@ShopNameOf(l.ShopId)</b> · @OpLabel(l.Op) · máy <b>@l.Hostname</b></div>
}
@if (!AcctLeases().Any() && OwnerOf(AccountId) is { } om)
{
    <div class="hint" style="margin:2px 0 8px">🔒 Acc đang do máy <b>@HostName(om)</b> giữ — việc mới của acc sẽ vào máy này.</div>
}
<div class="tablewrap" style="margin-top:10px">
<table class="grid sm stack-sm">
    <thead><tr><th>Shop</th><th>Scrape</th><th>Import</th><th>Update</th><th>Tên SP</th></tr></thead>
    <tbody>
        @foreach (var r in Shops)
        {
            <tr @onclick="() => OnSelectShop.InvokeAsync(r)">
                <td class="shop" data-label="Shop">@r.ShopName</td>
                @foreach (var op in FleetRowsBuilder.OpOrder)
                {
                    <td data-label="@OpLabel(op)">
                        @if (string.IsNullOrEmpty(r.Sheet))
                        {
                            <span class="sub">—</span>
                        }
                        else
                        {
                            var cell = FleetStateService.OpCell(Snap, r.AccountId, r.ShopId, op);
                            var st = r.Ops.GetValueOrDefault(op);
                            <span class="pill @cell.Css" title="@(st is null ? "" : $"{st.Machine} · {st.LastAgo}")">@cell.Text@(st is { RowCount: > 0 } ? $" · {st.RowCount:N0}" : "")</span>
                        }
                    </td>
                }
            </tr>
        }
        @if (Shops.Any())
        {
            <tr class="acctrow">
                <td data-label="Shop">Tổng</td>
                @foreach (var op in FleetRowsBuilder.OpOrder)
                {
                    var tot = Shops.Sum(r => r.Ops.GetValueOrDefault(op)?.RowCount ?? 0);
                    <td data-label="@OpLabel(op)">@tot.ToString("N0")</td>
                }
            </tr>
        }
        else
        {
            <tr><td colspan="5" class="empty">Tài khoản chưa có shop nào.</td></tr>
        }
    </tbody>
</table>
</div>
@* Acc mồ côi (chỉ còn trong ledger) không giao việc được → không dựng lối sang. *@
@if (InConfig)
{
    <div class="bar">
        <a class="btn primary sm" href="@DispatchHref"
           title="Sang trang Giao việc, lọc sẵn tài khoản này — ở đó chọn máy rồi bấm việc cho từng shop (hoặc cả acc).">🎯 Giao việc cho tài khoản này</a>
    </div>
}

@code {
    [Parameter] public FleetSnapshot Snap { get; set; } = new();
    [Parameter] public string AccountId { get; set; } = "";

    /// <summary>Mọi shop của acc đang chọn (cha đã lọc từ danh sách dòng).</summary>
    [Parameter] public List<FleetShopRow> Shops { get; set; } = new();

    /// <summary>Acc còn trong cấu hình? Acc mồ côi (chỉ còn ledger) không dựng lối sang trang Giao việc.</summary>
    [Parameter] public bool InConfig { get; set; }

    /// <summary>Link trang Giao việc đã lọc sẵn acc này (cha dựng — cùng chỗ dựng link mức shop).</summary>
    [Parameter] public string DispatchHref { get; set; } = "";

    [Parameter] public EventCallback<FleetShopRow> OnSelectShop { get; set; }

    /// <summary>Tổng quan 1 op trên toàn acc: tổng dòng đã làm + số shop đã ✓ / tổng shop.</summary>
    private (long Rows, int Done, int Total) AcctOpSummary(string op)
    {
        long rows = 0; var done = 0;
        foreach (var r in Shops)
        {
            rows += r.Ops.GetValueOrDefault(op)?.RowCount ?? 0;
            if (FleetStateService.OpCell(Snap, r.AccountId, r.ShopId, op).Text.StartsWith("✓")) done++;
        }
        return (rows, done, Shops.Count);
    }

    /// <summary>Lease sống của acc đang chọn — mỗi lease = 1 việc đang chạy thật (shop/op/máy).</summary>
    private List<LeaseRecord> AcctLeases() =>
        AccountId.Length == 0 ? new() : Snap.Leases.Where(l => l.BigsellerId == AccountId).ToList();

    private string ShopNameOf(string shopId) =>
        Shops.FirstOrDefault(r => r.ShopId == shopId)?.ShopName
        ?? (shopId.Length > 8 ? shopId[..8] : shopId);

    private string? OwnerOf(string bs)
    {
        // Máy đang giữ lease tươi hoặc assignment running của acc này.
        var lease = Snap.Leases.FirstOrDefault(l => l.BigsellerId == bs);
        if (lease is not null) return lease.MachineId;
        var asn = Snap.Assignments.FirstOrDefault(a => a.BigsellerId == bs && a.Status == "running");
        return asn?.ClaimedByMachineId;
    }

    private string HostName(string machineId) => FleetRowsBuilder.HostName(Snap, machineId);

    private static string OpLabel(string op) => FleetViewProjection.OperationLabel(op);
}
