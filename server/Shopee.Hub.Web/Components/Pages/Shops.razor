@page "/shops"
@attribute [Authorize(Policy = "Web")]
@inject HubDatabase Db

<p class="hint m-hide">Danh bạ shop nhóm theo <b>subacc</b> (email đăng nhập) — quan hệ lấy từ gương client
   (<code>orders_account_shops</code>). Mỗi shop trên hub khoá theo login shop (<code>ShopUsername</code> khi
   push đơn). Ở đây sửa tên/ghi chú hoặc xoá shop hub (xoá kèm mọi đơn). Shop chỉ có trong gương, chưa push đơn
   → hiện tên nhưng chưa Sửa/Xoá được.</p>

<div class="bar">
    <span class="stat">@_subCount subacc · @_shopCount shop</span>
    <span class="action">@_status</span>
</div>

@if (_editStatus.Length > 0)
{
    <div class="bar"><span class="action">@_editStatus</span></div>
}

<div class="tablewrap">
<table class="grid sm stack-sm shops-grouped">
    <thead><tr><th>Tên shop</th><th>Login shop</th><th class="m-hide">Ghi chú</th><th>Đơn</th><th></th></tr></thead>
    <tbody>
    @foreach (var g in _groups)
    {
        var groupOrders = g.Items.Sum(i => i.Hub is { } h ? _orderCounts.GetValueOrDefault(h.Id) : 0);
        <tr class="acctrow" @key="@(g.IsOrphan ? "__orphan__" : g.SubLogin)">
            <td colspan="5">
                @(g.IsOrphan ? "— Chưa gắn subacc —" : g.SubLogin)
                <span class="cnt">· @g.Items.Count shop</span>
                <span class="cnt">· @groupOrders đơn</span>
            </td>
        </tr>
        @* Sửa TẠI CHỖ: ô Tên/Ghi chú của ĐÚNG dòng đang sửa thành input, bảng không xê dịch. Enter = lưu,
           Esc = huỷ (bắt ở @onkeydown của từng input). *@
        @foreach (var item in g.Items)
        {
            var editing = _edit is not null && item.Hub is not null && _edit.Id == item.Hub.Id;
            <tr @key="@(g.SubLogin + "|" + item.ShopLogin)" class="@(editing ? "sel" : "")">
                <td data-label="Tên shop">
                    @if (editing)
                    {
                        <input class="inline-edit" @bind="_edit!.Name" @bind:event="oninput" @onkeydown="OnEditKey"
                               placeholder="vd Shop A" title="Tên shop (bắt buộc) — Enter lưu, Esc huỷ" />
                    }
                    else
                    {
                        <b>@item.DisplayName</b>
                        @if (item.Hub is null)
                        {
                            <span class="pill warn" title="Chỉ có trong gương client — chưa có hàng shops trên hub (chưa push đơn).">chưa trên hub</span>
                        }
                    }
                </td>
                <td data-label="Login shop">@item.ShopLogin</td>
                @* Cột Ghi chú vốn ẩn ở khung hẹp (m-hide); DÒNG ĐANG SỬA phải hiện, kẻo trên điện thoại
                   không sửa được ghi chú nữa. *@
                <td class="@(editing ? "" : "m-hide")" data-label="Ghi chú">
                    @if (editing)
                    {
                        <input class="inline-edit" @bind="_edit!.Note" @bind:event="oninput" @onkeydown="OnEditKey"
                               placeholder="ghi chú" title="Ghi chú — Enter lưu, Esc huỷ" />
                    }
                    else
                    {
                        @(item.Hub?.Note)
                    }
                </td>
                <td data-label="Đơn">@(item.Hub is { } hub ? _orderCounts.GetValueOrDefault(hub.Id).ToString() : "—")</td>
                <td data-label="">
                    @if (editing)
                    {
                        <button class="btn primary sm" title="Lưu (Enter)" @onclick="Save">✓ Lưu</button>
                        <button class="btn sm" title="Huỷ (Esc)" @onclick="CancelEdit">✕</button>
                    }
                    else if (item.Hub is { } s)
                    {
                        <button class="btn sm" title="Sửa tên / ghi chú ngay tại dòng này" @onclick="() => Edit(s)">✎ Sửa</button>
                        <button class="btn danger sm" @onclick="() => Delete(s)">🗑 Xoá</button>
                    }
                    else
                    {
                        <span class="stat" title="Chưa có bản ghi hub — đợi client push đơn của shop này.">—</span>
                    }
                </td>
            </tr>
        }
    }
    @if (_groups.Count == 0)
    {
        <tr><td colspan="5" class="empty">Chưa có shop nào — client chưa push đơn / chưa đẩy gương danh bạ.</td></tr>
    }
    </tbody>
</table>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private List<ShopSubAccountGroup> _groups = new();
    private Dictionary<long, int> _orderCounts = new();
    private int _subCount;
    private int _shopCount;
    private ShopEdit? _edit;          // null = không dòng nào đang sửa; Id trỏ hàng shops đang sửa
    private ConfirmDialog? _confirm;
    private string _status = "";
    private string _editStatus = "";  // lỗi/nhắc của lượt sửa đang mở (hiện ngay trên bảng)

    protected override void OnInitialized() => Reload();

    private void Reload()
    {
        _groups = Db.ListShopGroupsBySubAccount();
        _subCount = _groups.Count(g => !g.IsOrphan);
        _shopCount = _groups.Sum(g => g.Items.Count);
        _orderCounts = Db.OrderCountsByShop();
    }

    // Nạp ĐỦ trường vào ShopEdit (kể cả username/password/cookie/proxy) để UpsertShop KHÔNG xoá mất giá trị
    // hiện có khi ta chỉ hiện Tên + Ghi chú trên dòng.
    private void Edit(Shop s)
    {
        _editStatus = "";
        _edit = new ShopEdit
        {
            Id = s.Id, Name = s.Name, Username = s.Username, Password = s.Password,
            Cookie = s.Cookie, ProxyKey = s.ProxyKey, Note = s.Note,
        };
    }

    private void CancelEdit() { _edit = null; _editStatus = ""; }

    private void OnEditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Save();
        else if (e.Key == "Escape") CancelEdit();
    }

    private void Save()
    {
        if (_edit is null) return;
        if (string.IsNullOrWhiteSpace(_edit.Name)) { _editStatus = "⚠ Tên shop không được trống."; return; }
        Db.UpsertShop(new Shop
        {
            Id = _edit.Id, Name = _edit.Name.Trim(), Username = _edit.Username, Password = _edit.Password,
            Cookie = _edit.Cookie, ProxyKey = _edit.ProxyKey, Note = _edit.Note,
        });
        _status = $"✔ Đã lưu shop \"{_edit.Name.Trim()}\".";
        _edit = null;
        _editStatus = "";
        Reload();
    }

    private async Task Delete(Shop s)
    {
        if (_confirm is null) return;
        var n = _orderCounts.GetValueOrDefault(s.Id);
        if (!await _confirm.AskAsync($"Xoá shop \"{s.Name}\"?",
                n > 0
                    ? $"Xoá shop khỏi hub KÈM {n} đơn của shop này (kể cả phiếu PDF đã lưu). Không thể hoàn tác — "
                      + "client push đơn lần sau sẽ tạo lại shop rỗng."
                    : "Xoá shop khỏi hub. Client push đơn lần sau sẽ tạo lại shop rỗng.",
                "🗑 Xoá shop", danger: true))
            return;
        Db.DeleteShop(s.Id);
        if (_edit is not null && _edit.Id == s.Id) _edit = null;   // đang sửa đúng shop vừa xoá
        _status = $"🗑 Đã xoá shop \"{s.Name}\".";
        Reload();
    }

    private sealed class ShopEdit
    {
        public long Id { get; set; }
        public string Name { get; set; } = "";
        public string? Username { get; set; }
        public string? Password { get; set; }
        public string? Cookie { get; set; }
        public string? ProxyKey { get; set; }
        public string? Note { get; set; }
    }
}
