@page "/logs-view"
@attribute [Authorize(Policy = "Web")]
@implements IAsyncDisposable
@inject HubDatabase Db
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="logpage">
    <div class="bar">
        <label>Máy
            <select @bind="_machineFilter" @bind:after="UpdateUrl">
                <option value="">— tất cả —</option>
                @foreach (var h in _hosts)
                {
                    <option value="@h">@h</option>
                }
            </select>
        </label>
        <label>Mức
            <select @bind="_levelFilter" @bind:after="UpdateUrl">
                <option value="">— tất cả —</option>
                <option value="info">info</option>
                <option value="ok">ok</option>
                <option value="warn">warn</option>
                <option value="error">error</option>
            </select>
        </label>
        <button class="btn danger" @onclick="Clear">🗑 Xoá log</button>
        <span class="stat">@_logs.Count dòng</span>
    </div>

    <div class="logbox">
        @{ var lines = Filtered().ToList(); }
        @if (lines.Count == 0)
        {
            <div class="empty">Chưa có log.</div>
        }
        else
        {
            @foreach (var e in lines)
            {
                <div class="logline @e.Level">
                    <span class="t">@e.Ts.LocalDateTime.ToString("HH:mm:ss")</span>
                    <span class="h">@e.Hostname</span>
                    <span class="lv @e.Level">@e.Level</span>
                    <span class="tx">@e.Text</span>
                </div>
            }
        }
    </div>
</div>

@code {
    private static readonly string[] Levels = ["info", "ok", "warn", "error"];

    private List<LogEntry> _logs = new();
    private List<string> _hosts = new();
    private string _machineFilter = "";
    private string _levelFilter = "";
    private readonly CancellationTokenSource _pollCts = new();
    private Task? _pollTask;

    protected override void OnInitialized()
    {
        Load();
        // F5/deep-link: khôi phục 2 ô lọc SAU khi Load() dựng xong danh sách máy. KHÔNG navigate ở đây (còn
        // prerender → NavigateTo sẽ ném redirect); URL chỉ được ghi lại khi user đổi ô lọc.
        RestoreFromUrl();
        _pollTask = PollAsync(_pollCts.Token);
    }

    // ── Ô lọc ↔ URL query (?machine=&level=) — F5 / chia sẻ link giữ nguyên ──
    private void RestoreFromUrl() => UrlState.Restore(Nav,
        // Máy trong URL không còn dòng log nào → BỎ QUA (kẻo ô chọn hiện trống mà khung log lại rỗng không rõ vì sao).
        ("machine", v => _machineFilter = _hosts.Contains(v) ? v : ""),
        ("level", v => _levelFilter = Levels.Contains(v) ? v : ""));

    private void UpdateUrl() => UrlState.Update(Nav, replace: true,
        ("machine", _machineFilter),
        ("level", _levelFilter));

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(() => { Load(); StateHasChanged(); });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Component dang dong.
        }
    }

    private void Load()
    {
        _logs = Db.GetLogs(0, 500);
        _hosts = _logs.Select(l => l.Hostname).Where(h => !string.IsNullOrEmpty(h)).Distinct().OrderBy(x => x).ToList();
    }

    private IEnumerable<LogEntry> Filtered() => _logs
        .Where(l => string.IsNullOrEmpty(_machineFilter) || l.Hostname == _machineFilter)
        .Where(l => string.IsNullOrEmpty(_levelFilter) || l.Level == _levelFilter)
        .OrderByDescending(l => l.Id);

    private async Task Clear()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "Xoá toàn bộ log trên hub?")) return;
        Db.ClearLogs();
        Load();
    }

    public async ValueTask DisposeAsync()
    {
        await _pollCts.CancelAsync();
        if (_pollTask is not null)
        {
            try { await _pollTask; }
            catch (OperationCanceledException) { }
        }
        _pollCts.Dispose();
    }
}
