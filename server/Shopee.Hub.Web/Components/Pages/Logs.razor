@page "/logs-view"
@attribute [Authorize(Policy = "Web")]
@implements IAsyncDisposable
@inject HubDatabase Db
@inject NavigationManager Nav

@{ var lines = Filtered().ToList(); }
<div class="logpage">
    <div class="bar">
        <label>Máy
            <select @bind="_machineFilter" @bind:after="UpdateUrl">
                <option value="">— tất cả —</option>
                @foreach (var h in _hosts)
                {
                    <option value="@h">@h</option>
                }
            </select>
        </label>
        <label>Mức
            <select @bind="_levelFilter" @bind:after="UpdateUrl">
                <option value="">— tất cả —</option>
                <option value="info">info</option>
                <option value="ok">ok</option>
                <option value="warn">warn</option>
                <option value="error">error</option>
            </select>
        </label>
        @* Lọc chuỗi CHẠY TRÊN 500 dòng đã nạp (không đụng DB) → gõ tới đâu lọc tới đó, khỏi debounce. *@
        <label>Tìm
            <input class="opt-search" @bind="_textFilter" @bind:event="oninput" @bind:after="UpdateUrl"
                   placeholder="mã đơn / tên shop / chuỗi bất kỳ" title="Lọc trong 500 dòng đang xem — không phân biệt hoa thường. Khớp cả tên máy." />
        </label>
        @* Tạm dừng: vòng poll vẫn chạy nhưng BỎ QUA lượt nạp → khung log đứng yên để soi/bôi đen, bấm ▶ là bắt kịp. *@
        <button class="btn @(_paused ? "primary" : "")"
                title="@(_paused ? "Đang tạm dừng làm tươi — bấm để chạy lại (nhịp 2s)." : "Tạm dừng làm tươi (khung log đang nhảy mỗi 2s).")"
                @onclick="TogglePause">@(_paused ? "▶ Chạy lại" : "⏸ Tạm dừng")</button>
        <button class="btn danger" @onclick="Clear">🗑 Xoá log</button>
        <span class="stat">@(lines.Count == _logs.Count ? $"{_logs.Count} dòng" : $"{lines.Count}/{_logs.Count} dòng")@(_paused ? " · ⏸ đang dừng" : "")</span>
    </div>

    <div class="logbox">
        @if (lines.Count == 0)
        {
            <div class="empty">@(_logs.Count == 0 ? "Chưa có log." : "Không dòng nào khớp bộ lọc.")</div>
        }
        else
        {
            @foreach (var e in lines)
            {
                <div class="logline @e.Level">
                    <span class="t">@e.Ts.LocalDateTime.ToString("HH:mm:ss")</span>
                    <span class="h">@e.Hostname</span>
                    <span class="lv @e.Level">@e.Level</span>
                    <span class="tx">@e.Text</span>
                </div>
            }
        }
    </div>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    private static readonly string[] Levels = ["info", "ok", "warn", "error"];

    private List<LogEntry> _logs = new();
    private List<string> _hosts = new();
    private string _machineFilter = "";
    private string _levelFilter = "";
    private string _textFilter = "";
    private bool _paused;             // true = vòng poll bỏ qua lượt nạp (KHÔNG persist vào URL — trạng thái tức thời)
    private ConfirmDialog? _confirm;
    private readonly CancellationTokenSource _pollCts = new();
    private Task? _pollTask;

    protected override void OnInitialized()
    {
        Load();
        // F5/deep-link: khôi phục 2 ô lọc SAU khi Load() dựng xong danh sách máy. KHÔNG navigate ở đây (còn
        // prerender → NavigateTo sẽ ném redirect); URL chỉ được ghi lại khi user đổi ô lọc.
        RestoreFromUrl();
        _pollTask = PollAsync(_pollCts.Token);
    }

    // ── Ô lọc ↔ URL query (?machine=&level=&q=) — F5 / chia sẻ link giữ nguyên ──
    private void RestoreFromUrl() => UrlState.Restore(Nav,
        // Máy trong URL không còn dòng log nào → BỎ QUA (kẻo ô chọn hiện trống mà khung log lại rỗng không rõ vì sao).
        ("machine", v => _machineFilter = _hosts.Contains(v) ? v : ""),
        ("level", v => _levelFilter = Levels.Contains(v) ? v : ""),
        ("q", v => _textFilter = v));

    private void UpdateUrl() => UrlState.Update(Nav, replace: true,
        ("machine", _machineFilter),
        ("level", _levelFilter),
        ("q", _textFilter));

    private void TogglePause() => _paused = !_paused;

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Tạm dừng: vẫn giữ nhịp timer (bấm ▶ là bắt kịp ngay nhịp sau), chỉ bỏ lượt nạp + vẽ lại.
                if (_paused) continue;
                // Lỗi DB nhất thời (hub đang ghi, file bận…) KHÔNG được giết cả vòng poll — giữ nguyên bản log
                // đang hiện, nhịp sau thử lại. Lúc ĐANG huỷ thì để lỗi bay ra ngoài cho catch dưới đóng vòng.
                try { await InvokeAsync(() => { Load(); StateHasChanged(); }); }
                catch (Exception) when (!ct.IsCancellationRequested) { }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // Component dang dong.
        }
    }

    private void Load()
    {
        _logs = Db.GetLogs(0, 500);
        _hosts = _logs.Select(l => l.Hostname).Where(h => !string.IsNullOrEmpty(h)).Distinct().OrderBy(x => x).ToList();
    }

    private IEnumerable<LogEntry> Filtered() => _logs
        .Where(l => string.IsNullOrEmpty(_machineFilter) || l.Hostname == _machineFilter)
        .Where(l => string.IsNullOrEmpty(_levelFilter) || l.Level == _levelFilter)
        .Where(MatchesText)
        .OrderByDescending(l => l.Id);

    // Khớp chuỗi tìm trên NỘI DUNG lẫn TÊN MÁY, không phân biệt hoa/thường (dán mã đơn từ Slack là ra).
    private bool MatchesText(LogEntry l)
    {
        if (_textFilter.Length == 0) return true;
        return l.Text.Contains(_textFilter, StringComparison.OrdinalIgnoreCase)
            || l.Hostname.Contains(_textFilter, StringComparison.OrdinalIgnoreCase);
    }

    private async Task Clear()
    {
        if (_confirm is null) return;
        if (!await _confirm.AskAsync("Xoá toàn bộ log trên hub?",
                "Xoá sạch bảng log của hub (mọi máy, mọi mức). Không thể hoàn tác — log mới sẽ tiếp tục chảy về sau đó.",
                "🗑 Xoá log", danger: true))
            return;
        Db.ClearLogs();
        Load();
    }

    public async ValueTask DisposeAsync()
    {
        await _pollCts.CancelAsync();
        if (_pollTask is not null)
        {
            // Vòng poll đã tự nuốt lỗi nhất thời; ở đây chặn nốt mọi thứ còn sót lúc đóng (huỷ / circuit đã chết)
            // vì DisposeAsync ném ra sẽ làm hỏng cả lượt dispose của trang.
            try { await _pollTask; }
            catch (Exception) { }
        }
        _pollCts.Dispose();
    }
}
