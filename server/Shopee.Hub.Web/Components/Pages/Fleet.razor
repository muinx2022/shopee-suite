@page "/"
@* KHÔNG dùng @@page "/fleet": route đó thuộc API client (GET /fleet trả JSON). Trang này ở "/".
   Trang SOI & SỬA (số liệu · đặt tay ledger · rewrite · cấu hình · dữ liệu) — bố cục WORKSPACE master-detail:
   KPI + danh sách acc→shop bên TRÁI, bên PHẢI các tab cho mục đang chọn.
   GIAO VIỆC (ghim/huỷ/tiếp tục/điều phối tự động) nằm hẳn ở trang 🎯 Giao việc (/dispatch).
   Mã của trang nằm ở code-behind Fleet.razor.cs; dựng dòng/nhóm/tóm tắt ở FleetRowsBuilder.cs. *@
@attribute [Authorize(Policy = "Web")]
@inherits FleetPageBase
@inject FileStoreConfigService Config
@inject HubDatabase Db
@inject NavigationManager Nav
@inject RewriteJobService Rewrite
@inject IServiceProvider Sp

<div class="fleetpage">
<div class="kpis">
    <div class="kpi">
        <div class="kpi-ic green">@HubIcons.Svg("machines", 22)</div>
        <div><div class="kpi-val">@_kMachines</div><div class="kpi-label">Máy online</div></div>
    </div>
    <div class="kpi">
        <div class="kpi-ic blue">@HubIcons.Svg("run", 22)</div>
        <div><div class="kpi-val">@_kRunning</div><div class="kpi-label">Việc đang chạy</div></div>
    </div>
    <div class="kpi">
        <div class="kpi-ic amber">@HubIcons.Svg("clock", 22)</div>
        <div><div class="kpi-val">@_kQueued</div><div class="kpi-label">Việc chờ</div></div>
    </div>
    <div class="kpi m-hide">
        <div class="kpi-ic blue">@HubIcons.Svg("cookie", 22)</div>
        <div><div class="kpi-val">@_kCookies</div><div class="kpi-label">Acc có cookie</div></div>
    </div>
</div>

@* Trang này chỉ SOI & SỬA (số liệu · đặt tay ledger · rewrite · cấu hình · dữ liệu). Mọi lối GIAO VIỆC
   (điều phối tự động, ghim/huỷ/tiếp tục việc) đã chuyển hẳn sang trang 🎯 Giao việc (/dispatch). *@
<div class="bar">
    <span class="stat m-hide">@_summary</span>
</div>

<div class="workspace">
    <WorkspaceShopList Groups="Filtered()" Search="@_search" SearchChanged="OnSearchChanged"
                       SelectedAccountId="@_selAcctId" SelectedRow="_selRow" SelectedShopKey="_selShopKey"
                       Snap="Snap" IsHubAcct="IsHubAcct" EmptyText="@ListEmptyText"
                       OnAddAccount="AddAccount" OnSelectAcct="SelectAcct" OnSelectShop="SelectShop" />

    <div class="wsmain">
        <h2>@AcctName@(_selRow is not null ? " › " + _selRow.ShopName : "")</h2>
        <div class="tabs">
            <button class="@(_tab == "action" ? "active" : "")" @onclick='() => SetTab("action")'>⚡ Hành động</button>
            @* Thống kê chỉ còn ở mức SHOP; mức ACC đã gộp vào dashboard của tab Hành động. *@
            @if (_selRow is not null)
            {
                <button class="@(_tab == "stats" ? "active" : "")" @onclick='() => SetTab("stats")'>📊 Thống kê</button>
                <button class="@(_tab == "data" ? "active" : "")" @onclick='() => SetTab("data")'>📋 Dữ liệu</button>
            }
            <button class="@(_tab == "config" ? "active" : "")" @onclick='() => SetTab("config")'>⚙ Cấu hình</button>
        </div>

        @if (_selRow is not null)
        {
            var row = _selRow!;
            @if (_tab == "action")
            {
                @* (a) Trạng thái 4 op của shop + combo đặt-tay ledger *@
                <div class="tablewrap">
                <table class="grid sm stack-sm">
                    <thead><tr><th>Việc</th><th>Trạng thái</th><th>Dòng</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var op in FleetRowsBuilder.OpOrder)
                        {
                            var cell = FleetStateService.OpCell(Snap, row.AccountId, row.ShopId, op);
                            var st = row.Ops.GetValueOrDefault(op);
                            <tr>
                                <td data-label="Việc">@OpLabel(op)</td>
                                <td data-label="Trạng thái"><span class="pill @cell.Css" title="@(st is null ? "" : $"{st.Machine} · {st.LastAgo}")">@cell.Text</span></td>
                                <td data-label="Dòng">@(st is { RowCount: > 0 } ? st.RowCount.ToString("N0") : "")</td>
                                <td data-label="">
                                    @* Máy đang chạy (Locked) → ẩn combo. Rewrite + shop mồ côi + shop chưa gán sheet cũng không đặt-tay được. *@
                                    @if (op != AssignmentOps.Rewrite && row.InConfig && !cell.Locked && !string.IsNullOrEmpty(row.Sheet))
                                    {
                                        @* Select UNCONTROLLED → PHẢI @key theo (acc|shop|op|thế hệ): thiếu key thì Blazor tái dùng
                                           đúng element DOM cũ khi đổi shop → lựa chọn vừa đặt (vd "Chưa (reset)") hiện dính sang
                                           MỌI shop khác; sau khi đặt-tay xong cũng nhảy thế hệ để combo dựng lại, quay về ⋯. *@
                                        <select class="cellset" @key="@($"{row.AccountId}|{row.ShopId}|{op}|{_cellsetGen}")"
                                                @onchange="e => SetLedger(row.AccountId, row.ShopId, row.Sheet, op, e.Value?.ToString())">
                                            <option value="">⋯</option>
                                            <option value="@LedgerStatus.Completed">✓ Xong</option>
                                            <option value="@LedgerStatus.Idle">Chưa (reset)</option>
                                            <option value="@LedgerStatus.Stopped">■ Dừng</option>
                                        </select>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>

                @* (b) Giao việc đã chuyển hẳn sang trang /dispatch → chỉ còn LỐI SANG đó, lọc sẵn acc + shop. *@
                @if (!row.InConfig)
                {
                    <p class="hint">Shop không còn trong cấu hình — chỉ xem tiến độ.</p>
                }
                else if (string.IsNullOrEmpty(row.Sheet))
                {
                    <p class="hint">@(IsHubAcct(row.AccountId)
                        ? "Shop thiếu ngăn dữ liệu — mở tab ⚙ Cấu hình bấm Lưu để vá."
                        : "Shop chưa gán sheet — vào tab ⚙ Cấu hình.")</p>
                }
                else
                {
                    <div class="bar">
                        <a class="btn primary sm" href="@DispatchLink(row)"
                           title="Sang trang Giao việc, lọc sẵn tài khoản + shop này — ở đó chọn máy rồi bấm thẳng việc.">🎯 Giao việc cho shop này</a>
                    </div>
                }

                @* (c) Rewrite tên CHẠY TRÊN HUB — chỉ acc kho-Hub (client excel-mode tự lo qua module Update). *@
                @if (IsHubAcct(row.AccountId) && row.InConfig && !string.IsNullOrEmpty(row.Sheet))
                {
                    var rw = Rewrite.GetState(row.AccountId, row.Sheet);
                    var rwBusy = rw is not null && rw.Status is "running" or "queued";
                    <div class="pinpanel" style="margin-top:14px">
                        <div class="subhead">✎ Rewrite tên (chạy trên hub)</div>
                        @if (!PgReady)
                        {
                            <p class="hint">Kho Postgres chưa sẵn sàng — cấu hình <span class="wbname">HUB_PG_CONN</span> để bật rewrite trên hub.</p>
                            <div class="pin pinbtns">
                                <button class="btn primary" disabled>▶ Chạy</button>
                            </div>
                        }
                        else
                        {
                            <p class="hint">
                                @if (_rwPendingKey == RwKey(row) && _rwPending is { } pc)
                                {
                                    <span>Còn <b>@pc.ToString("N0")</b> dòng chờ rewrite (tên gốc + SKU, chưa có tên-sửa).</span>
                                }
                                else
                                {
                                    <span>Đang đếm dòng chờ…</span>
                                }
                                <button class="linkbtn" @onclick="() => RefreshRewritePending(row.AccountId, row.Sheet)">⟳ làm mới</button>
                            </p>
                            <div class="pin pinbtns">
                                <button class="btn primary" disabled="@rwBusy" @onclick="() => StartRewrite(row)">▶ Chạy</button>
                                @if (rwBusy)
                                {
                                    <button class="btn danger" @onclick="() => Rewrite.Cancel(row.AccountId, row.Sheet)">■ Dừng</button>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_rwActionMsg))
                            {
                                <div class="warn" style="margin-top:8px">@_rwActionMsg</div>
                            }
                            @if (rw is not null)
                            {
                                <div class="action" style="margin-top:10px">@RewriteStatusLine(rw)</div>
                                var rwLog = rw.LogSnapshot();   // bản sao an toàn-thread (worker mutate list gốc song song)
                                @if (rwLog.Count > 0)
                                {
                                    <div style="margin-top:8px; max-height:150px; overflow:auto; font-family:var(--mono); font-size:11.5px; line-height:1.5; color:var(--body); overflow-wrap:anywhere">
                                        @foreach (var line in rwLog)
                                        {
                                            <div>@line</div>
                                        }
                                    </div>
                                }
                            }
                        }
                    </div>
                }
            }
            else if (_tab == "stats")
            {
                <ShopStatsCards Snap="Snap" Row="row" OnOpenMap="OpenMap" />
            }
            else if (_tab == "data")
            {
                <ProductGridPanel AccountId="@row.AccountId" Sheet="@row.Sheet" InitialState="_gridInitial" OnViewChanged="OnGridViewChanged" />
            }
            else
            {
                @if (row.InConfig)
                {
                    <ShopConfigPanel AccountId="@row.AccountId" ShopId="@row.ShopId" OnChanged="OnConfigChanged" OnDeleted="OnShopDeleted" />
                }
                else
                {
                    <p class="hint">Shop không còn trong cấu hình — chỉ xem tiến độ.</p>
                }
            }
        }
        else if (_selAcctId is not null)
        {
            @if (_tab == "action")
            {
                <AcctDashboard Snap="Snap" AccountId="@(_selAcctId!)" Shops="AcctShops()"
                               InConfig="@_accounts.Any(a => a.Id == _selAcctId)" DispatchHref="@DispatchLink(_selAcctId!)"
                               OnSelectShop="SelectShop" />
            }
            else
            {
                @if (_accounts.Any(a => a.Id == _selAcctId))
                {
                    <AccountConfigPanel AccountId="@(_selAcctId!)" OnChanged="OnConfigChanged" OnDeleted="OnAcctDeleted" OnShopAdded="OnShopAdded" OnShopOpen="OnShopOpen" />
                    <DataStorePanel AccountId="@(_selAcctId!)" OnChanged="OnConfigChanged" />
                }
                else
                {
                    <p class="hint">Tài khoản không còn trong cấu hình (chỉ còn lịch sử).</p>
                }
            }
        }
        else
        {
            <p class="hint">Chọn 1 tài khoản hoặc shop ở danh sách bên trái.</p>
        }
    </div>
</div>
</div>

@if (_map is not null)
{
    <RowMapModal Title="@_map.Title" Op="@_map.Op" OpLabel="@_map.OpLabel" AccountId="@_map.AccountId"
                 Sheet="@_map.Sheet" Ledger="_map.Ledger" OnClose="() => _map = null" />
}
