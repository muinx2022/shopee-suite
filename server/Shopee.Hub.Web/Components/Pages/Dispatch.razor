    // ── Cân tải + giao việc hàng loạt ────────────────────────────────────────────
    private List<DispatchTarget> PickedTargets() => _visible
        .Where(r => _picked.Contains(r.Key))
        .Select(r => new DispatchTarget(r.AccountId, r.ShopId, r.Sheet, r.ShopName, r.AccountName))
        .ToList();

    private void BuildPreview() => _preview = BuildPlan();

    /// <summary>Số việc sẽ tạo nếu bấm Giao việc bây giờ (mỗi shop-được-xếp = 1 assignment).</summary>
    private int PreviewTotal => _preview.ByMachine.Sum(kv => kv.Value.Count);

    /// <summary>Kế hoạch giao việc của tập đang tick: để trống máy = ⚖ tự cân tải; chọn máy cụ thể = dồn hết vào
    /// máy đó, TRỪ nhóm acc đang bị máy khác giữ (giao vào sẽ nằm chờ mãi vì khoá 1-acc-1-máy).</summary>
    private BalancePlan BuildPlan()
    {
        var targets = PickedTargets();
        if (_bulkMachine.Length == 0)
            return DispatchBalancer.Balance(targets, _budgets, _holds, _homes);

        var byMachine = new Dictionary<string, List<DispatchTarget>>(StringComparer.Ordinal);
        var skipped = new List<string>();
        foreach (var g in targets.GroupBy(t => t.AccountId, StringComparer.Ordinal))
        {
            if (_holds.TryGetValue(g.Key, out var owner) && !string.Equals(owner, _bulkMachine, StringComparison.Ordinal))
            {
                skipped.Add($"{AcctName(g.Key)} ({g.Count()} shop): acc đang do máy {HostName(owner)} giữ");
                continue;
            }
            if (!byMachine.TryGetValue(_bulkMachine, out var list)) byMachine[_bulkMachine] = list = new List<DispatchTarget>();
            list.AddRange(g);
        }
        return new BalancePlan(byMachine, skipped);
    }

    /// <summary>Lý do option máy bị khoá (null = chọn được): offline · vi phạm 1-acc-1-máy với tập ĐANG chọn · hết quỹ.</summary>
    private string? BlockReason(MachineBudget m)
    {
        if (!m.Online) return "máy offline";
        foreach (var g in PickedTargets().GroupBy(t => t.AccountId, StringComparer.Ordinal))
            if (_holds.TryGetValue(g.Key, out var owner) && !string.Equals(owner, m.MachineId, StringComparison.Ordinal))
                return $"acc {AcctName(g.Key)} đang do {HostName(owner)} giữ";
        return m.Free <= 0 ? "hết quỹ Brave" : null;
    }

    private string MachineOptionText(MachineBudget m)
    {
        var cap = m.Free + m.Running;
        var text = $"{(m.Online ? "🟢" : "⚪")} {m.Hostname} · còn {m.Free}/{cap} brave · {m.Running} việc";
        return BlockReason(m) is { } why ? $"{text} — {why}" : text;
    }

    private void Assign()
    {
        _confirmAssign = false;
        var plan = BuildPlan();
        var payload = _bulkOp == "import"
            ? JsonSerializer.Serialize(new ImportJobPayload { FromClaimedTab = _optFromClaimed })
            : "";
        var n = 0;
        var parts = new List<string>();
        foreach (var kv in plan.ByMachine)
        {
            foreach (var t in kv.Value)
            {
                // FrameSize chỉ scrape đọc, Reload chỉ import/update đọc → op khác truyền 0 để sạch dữ liệu.
                Db.CreateAssignment(new CreateAssignmentRequest(
                    t.AccountId, t.ShopId, t.Sheet, _bulkOp, kv.Key, Pinned: true,
                    Math.Max(0, _optStart), Math.Max(0, _optEnd), payload,
                    Processes: Math.Max(0, _optProcs),
                    FrameSize: _bulkOp == "scrape" ? Math.Max(0, _optFrame) : 0,
                    ReloadSeconds: _bulkOp is "import" or "update" ? Math.Max(0, _optReload) : 0));
                n++;
            }
            var off = FleetStateService.MachineOffline(Snap, kv.Key);
            parts.Add($"{(off ? "⚠ " : "")}{HostName(kv.Key)} ← {kv.Value.Count}");
        }

        _result = n == 0
            ? "✘ Không giao được việc nào — xem lý do ở dòng xem trước."
            : $"✔ Đã giao {n} việc {OpLabel(_bulkOp)}: {string.Join(", ", parts)}";
        if (plan.Skipped.Count > 0) _result += " · bỏ qua: " + string.Join("; ", plan.Skipped);
        _picked.Clear();
        BuildPreview();
        FleetState.Refresh();   // 1 lần sau vòng lặp (KHÔNG gọi trong vòng lặp)
    }

    // ── View-state ↔ URL query (?tab=&f=&acct=&mac=&q=) — F5 / chia sẻ link giữ nguyên ──
    private bool _restored;      // cờ once: chỉ khôi phục lúc init, KHÔNG re-restore mỗi tick
    private bool _suppressUrl;   // chặn ghi URL trong lúc restore

    private void UpdateUrl()
    {
        if (_suppressUrl) return;
        var want = new (string K, string V)[]
        {
            ("tab",  _tab == "bs" ? "" : _tab),
            ("f",    _fState == "todo" ? "" : _fState),
            ("acct", _fAcct),
            ("mac",  _fMachine),
            ("q",    _fQuery.Trim()),
        };
        var q = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        string cur(string k) => q.TryGetValue(k, out var v) ? v.ToString() : "";
        if (want.All(w => cur(w.K) == w.V)) return;   // query đã khớp → khỏi navigate

        var query = string.Join("&", want.Where(w => w.V.Length > 0).Select(w => w.K + "=" + Uri.EscapeDataString(w.V)));
        Nav.NavigateTo(query.Length == 0 ? "/dispatch" : "/dispatch?" + query, forceLoad: false, replace: true);
    }

    private void RestoreFromUrl()
    {
        if (_restored) return;
        _restored = true;
        var q = QueryHelpers.ParseQuery(new Uri(Nav.Uri).Query);
        string get(string k) => q.TryGetValue(k, out var v) ? v.ToString() : "";
        _suppressUrl = true;
        try
        {
            _tab = get("tab") == "orders" ? "orders" : "bs";
            var f = get("f");
            if (StateChips.Any(c => c.Key == f)) _fState = f;
            var acct = get("acct");
            if (acct.Length > 0 && _accounts.Any(a => a.Id == acct)) _fAcct = acct;
            var mac = get("mac");
            if (mac.Length > 0 && Snap.Machines.Any(m => m.MachineId == mac)) _fMachine = mac;
            _fQuery = get("q");
            Rebuild();
            if (_tab == "orders") ReloadOrders();
        }
        finally { _suppressUrl = false; }
    }
}
