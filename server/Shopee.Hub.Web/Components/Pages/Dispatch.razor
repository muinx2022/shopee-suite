    /// <summary>Máy nhận được việc của acc này: acc đang bị giữ → CHỈ máy đó; ngược lại mọi máy online.</summary>
    private IEnumerable<MachineBudget> MachinesFor(string accountId)
    {
        if (_holds.TryGetValue(accountId, out var owner))
            return _budgets.Where(m => m.MachineId == owner);
        return _budgets.Where(m => m.Online);
    }

    /// <summary>Giao 1 ô (shop + op) cho 1 máy — tham số 0 = client dùng cấu hình của nó (giống ▶ Tiếp tục của Fleet).</summary>
    private void AssignOne(Row r, string op, string machineId)
    {
        _menuKey = null;
        Db.CreateAssignment(new CreateAssignmentRequest(r.AccountId, r.ShopId, r.Sheet, op, machineId, Pinned: true));
        var host = HostName(machineId);
        _result = FleetStateService.MachineOffline(Snap, machineId)
            ? $"⚠ Đã giao {OpLabel(op)} · {r.ShopName} → {host} (máy đang TẮT — chờ tới khi mở app)."
            : $"✔ Đã giao {OpLabel(op)} · {r.ShopName} → {host}.";
        FleetState.Refresh();
    }

