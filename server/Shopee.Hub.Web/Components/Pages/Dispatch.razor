@page "/dispatch"
@* Trang GIAO VIỆC hàng loạt, trục MÁY-first: chọn một máy client ở hàng thẻ đầu trang ("tôi đang đứng ở máy
   PC-01"), rồi bấm THẲNG nút hành động trên từng dòng shop — một click = một lệnh, không qua bước trung gian.
   Trang Fleet ("/") vẫn là chỗ xem SÂU 1 shop; trang này chỉ lo giao việc cho NHIỀU shop.
   Nguồn dữ liệu dùng lại nguyên của Fleet (FleetStateService.OpCell / Snap / HubDatabase) — CỐ Ý không chép
   Rebuild() của Fleet: Fleet phải overlay ledger để hiện shop mồ côi, trang này chỉ cần shop trong config có sheet. *@
@attribute [Authorize(Policy = "Web")]
@using Microsoft.AspNetCore.WebUtilities
@inherits FleetPageBase
@inject DispatcherService Dispatcher
@inject FileStoreConfigService Config
@inject HubDatabase Db
@inject NavigationManager Nav

<div class="dispatch">
@* Thẻ KPI có số > 0 = NÚT xổ bảng chi tiết ("đang chạy cái gì, ở đâu"); thẻ số 0 giữ nguyên <div> KHÔNG bấm
   được (không có gì để xem — render nút rồi disable chỉ tổ mời bấm hụt). *@
<div class="kpis">
    @foreach (var c in KpiCards)
    {
        var n = KpiCount(c.Key);
        if (n > 0)
        {
            var open = _kpi == c.Key;
            <button class="kpi kpi-btn @(open ? "open" : "")" @key="c.Key"
                    title="@(open ? $"Đang xem {n} {c.Label.ToLowerInvariant()} — bấm để đóng." : $"Xem chi tiết {n} {c.Label.ToLowerInvariant()}.")"
                    @onclick="() => ToggleKpi(c.Key)">
                <div class="kpi-ic @c.Tone">@HubIcons.Svg(c.Icon, 22)</div>
                <div>
                    <div class="kpi-val">@n</div>
                    <div class="kpi-label">@c.Label@(open ? " ▾" : "")</div>
                </div>
            </button>
        }
        else
        {
            <div class="kpi" @key="c.Key">
                <div class="kpi-ic @c.Tone">@HubIcons.Svg(c.Icon, 22)</div>
                <div><div class="kpi-val">@n</div><div class="kpi-label">@c.Label</div></div>
            </div>
        }
    }
</div>

@* Bảng chi tiết của thẻ đang mở — xổ NGAY DƯỚI hàng KPI, trên hàng tab (không modal: trang đã có .tablewrap
   cuộn ngang, modal trên mobile thì bí). Mọi cột nói TÊN (shop/tài khoản/máy), không phô GUID. *@
@if (_kpi.Length > 0)
{
    <div class="kpipanel">
        <div class="subhead">@KpiPanelTitle()</div>

        @if (_kpi == "machines")
        {
            <div class="tablewrap">
            <table class="grid sm">
                <thead><tr>
                    <th>Máy</th><th>Chế độ</th><th>Suất</th><th class="m-hide">Quỹ Brave</th>
                    <th>Số việc</th><th class="m-hide">Bản app</th><th>Nhịp cuối</th><th></th>
                </tr></thead>
                <tbody>
                @foreach (var m in _onlineMachines)
                {
                    var orders = m.Kind == MachineSlots.Orders;
                    var run = _used.GetValueOrDefault(m.MachineId);
                    var cap = m.MaxBrave > 0 ? m.MaxBrave : DefaultBrave;
                    <tr @key="m.MachineId">
                        <td class="acct">@(string.IsNullOrWhiteSpace(m.Hostname) ? Short(m.MachineId) : m.Hostname)</td>
                        <td>@(string.IsNullOrWhiteSpace(m.Mode) ? "—" : m.Mode)</td>
                        <td>@(orders ? "Đơn hàng" : "Workspace")</td>
                        @* Suất đơn hàng KHÔNG claim việc BigSeller → quỹ Brave ở đây vô nghĩa, hiện "—" thay vì số đánh lừa. *@
                        <td class="m-hide" title="@(orders ? "Suất đơn hàng không nhận việc BigSeller." : "Khung Brave còn trống / trần máy tự báo.")">
                            @(orders ? "—" : $"{Math.Max(0, cap - run)}/{cap}")
                        </td>
                        <td>@run</td>
                        <td class="m-hide">@(string.IsNullOrWhiteSpace(m.AppVersion) ? "—" : m.AppVersion)</td>
                        <td>@FleetStateService.Ago(m.LastSeen)</td>
                        <td>
                            @if (orders)
                            {
                                <span class="stat" title="Suất đơn hàng — không giao việc BigSeller vào đây được.">—</span>
                            }
                            else
                            {
                                <button class="btn sm" title="Chọn @m.Hostname làm máy nhận việc rồi đóng bảng này."
                                        @onclick="() => PickMachine(m.MachineId)">→ Chọn máy này</button>
                            }
                        </td>
                    </tr>
                }
                @if (_onlineMachines.Count == 0)
                {
                    <tr><td colspan="8" class="empty">Không còn máy nào online.</td></tr>
                }
                </tbody>
            </table>
            </div>
        }
        else if (_kpi == "running")
        {
            <div class="tablewrap">
            <table class="grid sm">
                <thead><tr>
                    <th>Việc</th><th>Shop</th><th>Tài khoản</th><th>Máy</th><th>Chạy từ</th>
                    <th class="m-hide">Dải dòng</th><th></th>
                </tr></thead>
                <tbody>
                @foreach (var w in _running)
                {
                    <tr @key="w.Key">
                        <td><span class="pill run">@OpLabel(w.Op)</span></td>
                        <td class="shop">@w.ShopName</td>
                        <td class="acct">@w.AcctName</td>
                        <td>@w.Host</td>
                        <td>@FleetStateService.Ago(w.Since)</td>
                        <td class="m-hide">@w.Rows</td>
                        <td>
                            @if (w.Manual)
                            {
                                <span class="stat" title="Việc chạy TAY (không do hub giao) — hub không huỷ được; dừng bằng nút ■ trong app trên máy @w.Host.">chạy tay</span>
                            }
                            else
                            {
                                <button class="btn danger sm" @onclick="() => OnWorkCancel(w)"
                                        title="Huỷ @OpLabel(w.Op) · @w.ShopName trên máy @w.Host (tham số giữ nguyên, ▶ Tiếp tục chạy lại được).">
                                    @(_confirmWork == w.AsnId ? "Bấm lần nữa để huỷ" : "✖ Huỷ")
                                </button>
                            }
                        </td>
                    </tr>
                }
                @if (_running.Count == 0)
                {
                    <tr><td colspan="7" class="empty">Không còn việc nào đang chạy.</td></tr>
                }
                </tbody>
            </table>
            </div>
        }
        else if (_kpi == "queued")
        {
            <div class="tablewrap">
            <table class="grid sm">
                <thead><tr>
                    <th>Việc</th><th>Shop</th><th>Tài khoản</th><th>Máy đích</th><th>Xếp lúc</th>
                    <th class="m-hide">Dải dòng</th><th></th>
                </tr></thead>
                <tbody>
                @foreach (var w in _queued)
                {
                    <tr @key="w.Key">
                        <td><span class="pill queued">@OpLabel(w.Op)</span></td>
                        <td class="shop">@w.ShopName</td>
                        <td class="acct">@w.AcctName</td>
                        <td title="@(w.Host == "—" ? "Việc chờ KHÔNG ghim máy nào — máy nào rảnh đúng vai trò sẽ nhận." : "")">@w.Host</td>
                        <td>@FleetStateService.Ago(w.Since)</td>
                        <td class="m-hide">@w.Rows</td>
                        <td>
                            <button class="btn danger sm" @onclick="() => OnWorkCancel(w)"
                                    title="Huỷ @OpLabel(w.Op) · @w.ShopName (tham số giữ nguyên, ▶ Tiếp tục chạy lại được).">
                                @(_confirmWork == w.AsnId ? "Bấm lần nữa để huỷ" : "✖ Huỷ")
                            </button>
                        </td>
                    </tr>
                }
                @if (_queued.Count == 0)
                {
                    <tr><td colspan="7" class="empty">Không còn việc nào đang chờ.</td></tr>
                }
                </tbody>
            </table>
            </div>
        }
        else if (_kpi == "interrupted")
        {
            <div class="tablewrap">
            <table class="grid sm">
                <thead><tr>
                    <th>Việc</th><th>Shop</th><th>Tài khoản</th><th>Máy cuối</th><th>Lý do</th><th>Lúc</th><th></th>
                </tr></thead>
                <tbody>
                @foreach (var a in Snap.Interrupted)
                {
                    var shop = ShopLabel(a.ShopId);
                    var acct = AcctLabel(a.BigsellerId);
                    <tr @key="a.Id">
                        <td><span class="pill warn">@OpLabel(a.Op)</span></td>
                        <td class="shop" title="@shop.Title">@shop.Text</td>
                        <td class="acct" title="@acct.Title">@acct.Text</td>
                        <td>@IntMachine(a)</td>
                        <td class="kpi-why">@IntReason(a)</td>
                        <td>@FleetStateService.Ago(a.UpdatedAt)</td>
                        <td>
                            <button class="btn primary sm" @onclick="() => OnResume(a)"
                                    title="Đưa @OpLabel(a.Op) · @shop.Text về hàng chờ để client chạy lại (giữ nguyên tham số).">▶ Tiếp tục</button>
                        </td>
                    </tr>
                }
                @if (Snap.Interrupted.Count == 0)
                {
                    <tr><td colspan="7" class="empty">Không còn việc gián đoạn nào.</td></tr>
                }
                </tbody>
            </table>
            </div>
            @* HubDatabase CHỈ có DismissAllInterrupted() (bỏ HẾT) — không có API bỏ TỪNG việc → nút đặt ở CHÂN
               panel và nói rõ là bỏ tất cả (khuôn nút "✕ Bỏ … việc gián đoạn" cũ của trang Fleet). Xác nhận 2 bước. *@
            @if (Snap.Interrupted.Count > 0)
            {
                <div class="bar">
                    <button class="btn sm" @onclick="OnDismissAll"
                            title="Bỏ hẳn MỌI việc gián đoạn khỏi danh sách (hub chưa có đường bỏ từng việc) — không tiếp tục lại được từ đây; ledger/thống kê giữ nguyên.">
                        @(_confirmDismiss ? $"Bấm lần nữa để BỎ HẲN cả {Snap.Interrupted.Count} việc" : $"✕ Bỏ cả {Snap.Interrupted.Count} việc gián đoạn")
                    </button>
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_kpiMsg))
        {
            <div class="bar"><span class="action">@_kpiMsg</span></div>
        }
    </div>
}

<div class="tabs">
    <button class="@(_tab == "bs" ? "active" : "")" @onclick='() => SetTab("bs")'>🛒 BigSeller — theo shop</button>
    <button class="@(_tab == "orders" ? "active" : "")" @onclick='() => SetTab("orders")'>📦 Đơn hàng — theo tài khoản</button>
</div>

@if (_tab == "bs")
{
    @* Hai công tắc của TOÀN HỆ THỐNG (chuyển từ trang Fleet sang) — KHÔNG thuộc máy đang chọn nên đặt ngay dưới
       hàng tab, tách hẳn khỏi panel tham số của máy bên dưới. Kết quả hiện ở dòng @_result trên lưới. *@
    <div class="bar">
        <label class="toggle" title="Bật: cứ 10s hub tự tạo việc kế tiếp cho MỌI shop theo dây chuyền scrape → import → update. Tắt: chỉ chạy việc giao tay ở trang này.">
            <input type="checkbox" checked="@Dispatcher.Enabled" @onchange="ToggleDispatch" />
            Điều phối tự động (scrape→import→update)
        </label>
        <button class="btn danger sm" disabled="@(AllOpenCount == 0)"
                title="Huỷ MỌI việc hub-giao đang chạy/chờ của TOÀN HỆ THỐNG — mọi máy, mọi tài khoản. (Nút '✖ Huỷ mọi việc trên máy này' bên dưới chỉ đụng máy đang chọn.) Tham số giữ nguyên, ▶ Tiếp tục chạy lại được."
                @onclick="CancelAllWork">
            @(_confirmCancel == "all"
                ? $"Bấm lần nữa để huỷ {AllOpenCount} việc TOÀN HỆ THỐNG"
                : $"✖ Huỷ MỌI việc ({AllOpenCount})")
        </button>
    </div>

    <div class="subhead">🖥 Chọn máy client</div>
    <div class="mcards">
        @foreach (var m in _budgets)
        {
            @* Máy offline: thuộc tính disabled THẬT (không chỉ làm mờ) — việc giao vào máy tắt nằm chờ mãi. *@
            <button class="mcard @(m.MachineId == _selMachine ? "sel" : "")" disabled="@(!m.Online)"
                    title="@MachineTitle(m)" @key="m.MachineId" @onclick="() => SelectMachine(m.MachineId)">
                <span class="mc-host">@(m.Online ? "🟢" : "⚪") @m.Hostname@(m.Mode is "" or "Workspace" ? "" : " · " + m.Mode)</span>
                <span class="mc-sub">@(m.Online ? $"còn {m.Free}/{m.Free + m.Running} brave" : "offline · " + FleetStateService.Ago(m.LastSeen))</span>
                <span class="mc-sub">@(m.Online ? $"{m.Running} việc{(m.Version.Length > 0 ? " · " + m.Version : "")}" : "(không bấm được)")</span>
            </button>
        }
        @if (_budgets.Count == 0)
        {
            <span class="stat">Chưa máy client nào kết nối hub.</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(_machineMsg))
    {
        <div class="warn">@_machineMsg</div>
    }

    @if (_selMachine.Length > 0)
    {
        @* Tham số của LƯỢT GIAO (không phải của từng ô): giữ nguyên giữa các lần bấm tới khi người dùng đổi.
           Mô hình mới không biết trước op nào sẽ bấm → hiện HẾT field, chú thích rõ op nào đọc field nào;
           lúc tạo assignment vẫn lọc theo op y như Fleet.Pin(). *@
        <div class="optspanel">
            <div class="subhead">⚙ Tham số cho lượt giao của @HostName(_selMachine)</div>
            <div class="optsrow">
                <label>Từ dòng <input type="number" @bind="_optStart" style="width:80px" /></label>
                <label>Đến dòng <input type="number" @bind="_optEnd" style="width:80px" /></label>
                <label title="Import LUÔN chạy 1 lane — khoá cứng ở client, ô này KHÔNG ghi đè được.">Số process (chỉ Scrape/Update đọc — Import luôn 1 lane) <input type="number" @bind="_optProcs" style="width:70px" /></label>
                <label>Số tk / khung (chỉ Scrape đọc) <input type="number" @bind="_optFrame" style="width:70px" /></label>
                <label>Reload giây (chỉ Import/Update đọc) <input type="number" @bind="_optReload" style="width:70px" /></label>
                <label><input type="checkbox" @bind="_optFromClaimed" /> Import từ tab "Đã nhận" (chỉ Import đọc)</label>
            </div>
            <div class="optsrow">
                <span class="stat">0 = dùng cấu hình của máy client.</span>
                <span class="grow"></span>
                @* Huỷ theo MÁY: dọn sạch mọi việc hub-giao đang chạy/chờ của máy đang chọn — không phải bấm ✖ từng ô. *@
                <button class="btn danger sm" disabled="@(MachineOpenCount == 0)"
                        title="Huỷ MỌI việc hub-giao đang chạy/chờ trên máy @HostName(_selMachine). Việc chạy TAY không huỷ được từ hub."
                        @onclick="CancelByMachine">
                    @(_confirmCancel == "mach"
                        ? $"Bấm lần nữa để huỷ {MachineOpenCount} việc trên {HostName(_selMachine)}"
                        : $"✖ Huỷ mọi việc trên máy này ({MachineOpenCount})")
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="warn">Chọn một máy client ở trên để giao việc.</div>
    }

    <div class="bar">
        <label>Tài khoản
            <select @bind="_fAcct" @bind:after="OnFilterChanged">
                <option value="">— tất cả —</option>
                @foreach (var a in _accounts)
                {
                    <option value="@a.Id">@a.DisplayName</option>
                }
            </select>
        </label>
        <span class="chips">
            @foreach (var (key, label) in StateChips)
            {
                <button class="chip @(_fState == key ? "on" : "")" @onclick="() => SetState(key)">@label</button>
            }
        </span>
        <label>Tìm
            <input type="text" @bind="_fQuery" @bind:event="oninput" @bind:after="OnFilterChanged"
                   placeholder="tên shop / tài khoản" title="Gõ tên shop → giữ cả tài khoản chứa shop đó cùng mọi shop của nó."
                   style="width:200px" />
        </label>
        <span class="stat m-hide">@_visible.Count/@_rows.Count shop@(_hiddenNoSheet > 0 ? $" · ẩn {_hiddenNoSheet} shop chưa gán ngăn dữ liệu" : "")</span>
    </div>

    @if (!string.IsNullOrEmpty(_result))
    {
        <div class="bar"><span class="action">@_result</span></div>
    }

    <div class="tablewrap">
    <table class="grid sm">
        <thead><tr>
            <th>Shop</th>
            @foreach (var op in DispatchOps)
            {
                <th>@OpLabel(op)</th>
            }
            <th class="m-hide">Máy đang giữ</th>
            <th class="m-hide">Cập nhật</th>
        </tr></thead>
        <tbody>
        @foreach (var g in VisibleGroups())
        {
            <tr class="acctrow" @key="@("g|" + g.AccountId)">
                <td colspan="6">
                    @g.AccountName <span class="cnt">· @g.Rows.Count shop</span>
                    @if (HoldHostOf(g.AccountId) is { } gh)
                    {
                        <span class="cnt">· đang do <b>@gh</b> giữ</span>
                    }
                    @* Cụm nút mức tài khoản = "chọn nhiều" duy nhất còn lại → xác nhận 2 bước (1 bấm tạo N việc). *@
                    <span class="acctacts">
                        @foreach (var op in DispatchOps)
                        {
                            var ab = AcctBtn(g, op);
                            <button class="opbtn @ab.Css" disabled="@ab.Disabled" title="@ab.Title"
                                    @onclick="() => OnAcctClick(g, op)">@ab.Label</button>
                        }
                        @* Huỷ theo ACC: 1 acc chỉ chạy 1 máy nên huỷ ở đây là dọn sạch acc đó, không cần chọn đúng
                           máy trước. Hiện cả khi acc đang do máy KHÁC giữ (đó chính là lúc cần huỷ nhất). *@
                        @{ var accOpen = AcctOpenCount(g); }
                        <button class="opbtn @(accOpen > 0 ? "cancel" : "blocked")" disabled="@(accOpen == 0)"
                                title="Huỷ MỌI việc hub-giao đang chạy/chờ của tài khoản @g.AccountName (kể cả trên máy khác)."
                                @onclick="() => CancelByAcct(g)">
                            @(_confirmCancel == "acct|" + g.AccountId
                                ? $"Bấm lần nữa để huỷ {accOpen} việc"
                                : $"✖ Huỷ cả acc ({accOpen})")
                        </button>
                    </span>
                </td>
            </tr>
            @foreach (var r in g.Rows)
            {
                <tr @key="r.Key">
                    @* Tên shop = lối sang trang BigSeller ("/") của đúng shop đó. Là <a> trong ô RIÊNG, không bọc
                       cả dòng → cú bấm không lẫn sang nút hành động ở các ô bên cạnh. *@
                    <td class="shop">
                        <a href="@FleetLink(r)" title="Mở @r.ShopName ở trang BigSeller (tiến độ · đặt tay ledger · rewrite · dữ liệu).">@r.ShopName</a>
                    </td>
                    @foreach (var op in DispatchOps)
                    {
                        var b = Btn(r, op);
                        <td>
                            <button class="opbtn @b.Css" disabled="@b.Disabled" title="@b.Title"
                                    @onclick="() => OnOpClick(r, op)">@b.Label</button>
                            @* Lý do lượt trước hỏng — ô chỉ báo "✘ lỗi" đúng 3 phút rồi im, không có dòng này thì
                               job "chạy tí rồi dừng" mà người vận hành không biết vì sao. Cắt bằng CSS, đủ chữ ở title. *@
                            @if (b.Note.Length > 0)
                            {
                                <div class="opnote" title="@b.Note">⚠ @b.Note</div>
                            }
                        </td>
                    }
                    <td class="m-hide">@(HoldHostOf(r.AccountId) ?? "—")</td>
                    <td class="m-hide">@LastUpdate(r)</td>
                </tr>
            }
        }
        @if (_visible.Count == 0)
        {
            <tr><td colspan="6" class="empty">@EmptyText()</td></tr>
        }
        </tbody>
    </table>
    </div>
}
else
{
    @* Trục MÁY → TÀI KHOẢN (y tab BigSeller, chỉ khác đơn vị việc). BẤT BIẾN BỐ CỤC: mọi nút hành động nằm ở
       mức TÀI KHOẢN; shop chỉ để XEM, nằm DƯỚI tài khoản của nó và mặc định thu gọn. Lý do kỹ thuật: một phiên
       = đăng nhập subaccount rồi lặp LẦN LƯỢT mọi shop của nó — client KHÔNG có chế độ "chỉ chạy shop X". *@
    <div class="subhead">🖥 Chọn máy client (suất đơn hàng)</div>
    <div class="mcards">
        @foreach (var m in _oMachines)
        {
            @* Máy offline: disabled THẬT — lệnh gửi vào máy tắt sẽ nằm chờ rồi tự hỏng sau 5'. *@
            <button class="mcard @(m.MachineId == _oMach ? "sel" : "")" disabled="@(!m.Online)"
                    title="@OrdersMachineTitle(m)" @key="m.MachineId" @onclick="() => SelectOrdersMachine(m.MachineId)">
                <span class="mc-host">@(m.Online ? "🟢" : "⚪") @m.Hostname</span>
                <span class="mc-sub">@(m.Online ? $"{m.Accounts} tài khoản" : "offline · " + FleetStateService.Ago(m.LastSeen))</span>
                <span class="mc-sub">@(m.Online ? $"{m.Running} đang chạy{(m.Version.Length > 0 ? " · " + m.Version : "")}" : "(không bấm được)")</span>
            </button>
        }
        @if (_oMachines.Count == 0)
        {
            <span class="stat">Chưa máy client nào chạy chế độ Shopee/Full kết nối hub.</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(_oMachineMsg))
    {
        <div class="warn">@_oMachineMsg</div>
    }

    @if (_oMach.Length == 0)
    {
        <div class="warn">Chọn một máy client ở trên để xem tài khoản Đơn hàng của máy đó.</div>
    }

    @if (!string.IsNullOrEmpty(_oResult))
    {
        <div class="bar"><span class="action">@_oResult</span></div>
    }

    <div class="tablewrap">
    <table class="grid sm">
        <thead><tr>
            <th>Tài khoản (login)</th><th>Shop</th><th>Trạng thái</th>
            <th class="m-hide">Đơn chờ</th><th class="m-hide">Sync cuối</th><th>Hành động</th>
        </tr></thead>
        <tbody>
        @foreach (var a in _oAccounts)
        {
            <tr @key="a.Login">
                <td class="acct">@a.Login</td>
                <td>
                    @if (a.Shops.Count == 0)
                    {
                        <span class="stat" title="Máy chưa đọc được danh sách shop của tài khoản này (chưa chạy lần nào).">—</span>
                    }
                    else
                    {
                        <button class="linkbtn" @onclick="() => ToggleOrdersShops(a.Login)"
                                title="@(_oOpen == a.Login ? "Thu gọn danh sách shop." : $"Xem {a.Shops.Count} shop của {a.Login} (chỉ để xem — chạy/dừng là ở mức tài khoản).")">
                            @a.Shops.Count shop @(_oOpen == a.Login ? "▴" : "▾")
                        </button>
                    }
                </td>
                <td>
                    <span class="pill @OrdersStateCss(a.SessionState)">@OrdersStateLabel(a.SessionState)</span>
                    @if (a.VerifyFailed)
                    {
                        <span class="pill warn" title="Lượt chạy gần nhất không tự xác minh được — cần vào máy đó xác minh tay.">⚠ Cần xác minh</span>
                    }
                </td>
                <td class="m-hide" title="Tổng đơn '@WaitingStatus' của mọi shop thuộc tài khoản này (hub đếm từ bảng đơn).">@OrdersWaiting(a).ToString("N0")</td>
                <td class="m-hide">@(a.LastSyncAt is { } t ? FleetStateService.Ago(t) : "—")</td>
                <td>
                    @* Cụm nút mức TÀI KHOẢN — chỗ DUY NHẤT có hành động ở tab này. *@
                    <span class="oacts">
                        @{ var rb = OrdersRunBtn(a); }
                        <button class="opbtn @rb.Css" disabled="@rb.Disabled" title="@rb.Title"
                                @onclick="() => OnOrdersRunClick(a)">@rb.Label</button>
                        @* 2 lệnh dưới CHƯA làm được ở đợt này: client không có điểm vào cấp service (một phiên là
                           vòng liên tục login→mọi shop→sync), nhái lại logic phiên rủi ro hơn lợi ích. *@
                        <button class="opbtn blocked" disabled
                                title="Đồng bộ đơn một lượt — sẽ làm ở đợt sau (bản client hiện chưa có điểm vào cho lệnh này).">↻ Đồng bộ 1 lượt</button>
                        <button class="opbtn blocked" disabled
                                title="Đăng nhập lại / kiểm tra tài khoản — sẽ làm ở đợt sau (bản client hiện chưa có điểm vào cho lệnh này).">🔑 Đăng nhập lại</button>
                    </span>
                    @if (rb.Note.Length > 0)
                    {
                        <div class="opnote" title="@rb.Note">⚠ @rb.Note</div>
                    }
                </td>
            </tr>
            @if (_oOpen == a.Login && a.Shops.Count > 0)
            {
                @* Shop CHỈ để xem: không nút nào ở đây (xem chú thích đầu tab). *@
                <tr @key="@("shops|" + a.Login)">
                    <td colspan="6" class="shoplist">
                        @foreach (var s in a.Shops)
                        {
                            <span class="shopchip" title="Shop @s.Login của @a.Login — @OrdersWaitingOfShop(s).ToString("N0") đơn @WaitingStatus.ToLowerInvariant()">
                                🛍 @s.Name <b>@OrdersWaitingOfShop(s).ToString("N0")</b>
                            </span>
                        }
                    </td>
                </tr>
            }
        }
        @if (_oAccounts.Count == 0)
        {
            <tr><td colspan="6" class="empty">@OrdersEmptyText()</td></tr>
        }
        </tbody>
    </table>
    </div>
}
</div>

@code {
    // 3 op hub giao được cho client BigSeller (rewrite chạy trên hub → không có ở đây).
    private static readonly string[] DispatchOps = ["scrape", "import", "update"];
    private static readonly (string Key, string Label)[] StateChips =
    [
        ("todo", "Chưa xong"), ("run", "Đang chạy"), ("int", "Gián đoạn"), ("all", "Tất cả"),
    ];
    /// <summary>4 thẻ KPI đầu trang, theo thứ tự hiện. <c>Key</c> cũng là giá trị của query <c>?kpi=</c>.</summary>
    private static readonly (string Key, string Icon, string Tone, string Label)[] KpiCards =
    [
        ("machines", "machines", "green", "Máy online"),
        ("running", "run", "blue", "Việc đang chạy"),
        ("queued", "clock", "amber", "Việc chờ"),
        ("interrupted", "alert", "red", "Việc gián đoạn"),
    ];
    /// <summary>Trần Brave mặc định khi máy chưa báo <c>MaxBrave</c> (0 = CHƯA BÁO, không phải "không có quỹ").</summary>
    private const int DefaultBrave = 2;
    private const string WaitingStatus = "Chờ lấy hàng";

    private sealed class Row
    {
        public string AccountId = "", AccountName = "", ShopId = "", ShopName = "", Sheet = "", Key = "";
    }

    private sealed record RowGroup(string AccountId, string AccountName, List<Row> Rows);

    /// <summary>Quỹ chạy + hiện diện của 1 máy, dựng cho hàng thẻ chọn máy: <c>Free</c> = số khung Brave còn
    /// trống (trần máy tự báo trừ việc đang chạy/chờ), <c>Running</c> = số việc đang chạy/chờ.</summary>
    private sealed record MachineBudget(
        string MachineId, string Hostname, bool Online, int Free, int Running, string Version, DateTimeOffset LastSeen,
        string Mode);

    /// <summary>Thẻ chọn máy ở tab Đơn hàng — CHỈ suất đơn hàng. <c>Accounts</c>/<c>Running</c> lấy từ GƯƠNG danh
    /// bạ máy đó tự đẩy lên (0/0 = client bản cũ chưa biết đẩy gương). Không có quỹ Brave ở đây: suất đơn hàng
    /// không claim việc BigSeller.</summary>
    private sealed record OrdersMachineCard(
        string MachineId, string Hostname, bool Online, string Version, DateTimeOffset LastSeen,
        int Accounts, int Running);

    /// <summary>Một dòng bảng chi tiết KPI "đang chạy" / "đang chờ": việc gì · shop nào · máy nào · từ lúc nào.
    /// <c>Manual</c> = việc chạy TAY trên app client (chỉ có lease, KHÔNG có assignment) → hub không huỷ được,
    /// <c>AsnId</c> rỗng. Tên shop/tài khoản đã tra sẵn ở đây để markup khỏi đụng GUID.</summary>
    private sealed record WorkItem(
        string Key, string AsnId, string Op, string ShopName, string AcctName, string Host,
        DateTimeOffset Since, string Rows, bool Manual);

    /// <summary>Trạng thái 1 nút hành động trên lưới. <c>Act</c> = việc nút làm khi bấm: "" = KHÔNG bấm được
    /// (render kèm thuộc tính <c>disabled</c>), "run" = tạo assignment, "cancel" = huỷ assignment đang mở.</summary>
    /// <summary><see cref="Note"/> = LÝ DO lượt chạy TRƯỚC của ô này hỏng (rỗng = lượt trước không hỏng). Ô chỉ
    /// hiện "✘ lỗi (máy)" trong 3 phút rồi rơi về "· chờ" (xem FleetStateService.OpCell) — không có dòng này thì
    /// người vận hành thấy job "chạy tí rồi dừng, không rõ vì sao". Nguồn: Snap.Interrupted (giữ 7 ngày).</summary>
    private sealed record OpBtn(string Label, string Act, string Css, string Title, string Note = "")
    {
        public bool Disabled => Act.Length == 0;
    }

    // ── Nguồn (đọc lại chậm hơn nhịp fleet) ──
    private List<BigSellerAccount> _accounts = new();
    private DateTimeOffset _staticLoadedAt;

    private List<Row> _rows = new();
    private List<Row> _visible = new();
    private int _hiddenNoSheet;
    private int _kMachines, _kRunning, _kQueued, _kInterrupted;
    // Tên tài khoản / shop theo GUID — dựng từ TOÀN BỘ config (kể cả shop chưa gán ngăn dữ liệu, tức không có
    // trong _rows) vì Snap.Interrupted có thể trỏ tới shop như vậy. Id không tra được → Short() + title đầy đủ.
    private Dictionary<string, string> _acctNames = new(StringComparer.Ordinal);
    private Dictionary<string, string> _shopNames = new(StringComparer.Ordinal);

    // ── Bảng chi tiết của thẻ KPI đang mở ──
    // Dựng CÙNG một lượt quét với 3 số KPI (xem RecomputeKpis) → số trên thẻ LUÔN bằng số dòng bảng.
    private List<WorkItem> _running = new(), _queued = new();
    private List<MachinePresence> _onlineMachines = new();
    private string _kpi = "";           // "" = đóng; còn lại là Key trong KpiCards (cũng nằm trong URL ?kpi=)
    private string _kpiMsg = "";        // kết quả ngắn của hành động vừa bấm trong panel
    private string _confirmWork = "";   // id assignment đang chờ bấm-lần-nữa để huỷ (rỗng = không có)
    private bool _confirmDismiss;       // arm 2-bước nút "Bỏ cả N việc gián đoạn"
    private int _kpiEmptyTicks;         // số nhịp fleet liên tiếp panel đang mở mà KPI = 0 (2 nhịp → tự đóng)

    // ── Bộ lọc (đều nằm trong URL) ──
    private string _tab = "bs";
    private string _fState = "todo";
    private string _fAcct = "", _fQuery = "";

    // ── Máy đang chọn (trục của cả trang) + tham số của lượt giao ──
    private string _selMachine = "", _selHost = "";
    private string _machineMsg = "";      // "máy vừa offline — đã bỏ chọn" (nhịp fleet 2s tự phát hiện)
    private int _optStart, _optEnd, _optProcs, _optFrame, _optReload;   // 0 = dùng cấu hình client
    private bool _optFromClaimed;
    private string _result = "";
    private string _confirmAcct = "";     // "accountId|op" đang chờ bấm-lần-nữa (rỗng = không có)
    /// <summary>Nút HUỶ hàng loạt đang chờ bấm-lần-nữa: "mach" (theo máy) hoặc "acct|&lt;id&gt;" (theo tài khoản).
    /// Rỗng = không có. Tách khỏi <see cref="_confirmAcct"/> để hai cụm không tranh nhau một biến.</summary>
    private string _confirmCancel = "";

    private List<MachineBudget> _budgets = new();
    private Dictionary<string, string> _holds = new(StringComparer.Ordinal);
    /// <summary>Số việc hub-giao đang chạy/chờ gắn từng máy (khoá = machineId) — BuildBudgets tính 1 lần, cả
    /// hàng thẻ chọn máy lẫn bảng "Máy online" đọc lại.</summary>
    private Dictionary<string, int> _used = new(StringComparer.Ordinal);

    // ── Tab Đơn hàng (trục máy → tài khoản) ──
    private List<Shop> _shops = new();
    private Dictionary<long, ShopOrderSummary> _orderSums = new();
    /// <summary>shop_login (= <c>shops.username</c>) → id shop trên hub. Client đẩy đơn theo ĐÚNG khoá này nên
    /// gương tra ra được số đơn; so khớp KHÔNG phân biệt hoa/thường (nhãn shop giữa hai bên có thể lệch HOA/thường).</summary>
    private Dictionary<string, long> _shopIdByLogin = new(StringComparer.OrdinalIgnoreCase);
    private DateTimeOffset _ordersLoadedAt;

    /// <summary>Máy đang chọn ở tab Đơn hàng (nằm trong URL <c>?omach=</c>) + tên hiển thị của nó. Tách hẳn khỏi
    /// <see cref="_selMachine"/> của tab BigSeller: hai tab chọn hai TẬP máy khác nhau (suất workspace vs suất đơn hàng).</summary>
    private string _oMach = "", _oHost = "";
    private string _oMachineMsg = "";     // "máy vừa offline — đã bỏ chọn"
    private string _oResult = "";         // kết quả cú bấm gần nhất
    private string _oOpen = "";           // login tài khoản đang bung danh sách shop ("" = thu gọn hết)
    private List<OrdersMachineCard> _oMachines = new();
    private List<OrdersMirrorAccount> _oAccounts = new();
    private List<OrdersCommandRow> _oCmds = new();
    private Dictionary<string, OrdersMirrorCount> _oCounts = new(StringComparer.Ordinal);
    /// <summary>login (đã hạ chữ) → máy đang GIỮ khoá chạy tài khoản đó. Nguồn <c>Snap.AccountLeases</c> —
    /// ĐÚNG bảng cho tab này (khoá "orders:&lt;login&gt;"), khác tab BigSeller (tab đó phải dùng <c>Snap.Leases</c>).</summary>
    private Dictionary<string, string> _oHolders = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ReloadStatic();
        Rebuild();
        // F5/deep-link: khôi phục bộ lọc SAU KHI _rows dựng xong. KHÔNG navigate ở đây (còn prerender →
        // NavigateTo ném redirect); URL chỉ được ghi lại khi user thao tác sau đó.
        RestoreFromUrl();
    }

    protected override void OnFleetTick()
    {
        if ((DateTimeOffset.UtcNow - _staticLoadedAt).TotalSeconds > 10) ReloadStatic();
        Rebuild();
        SyncKpiPanel();   // CHỈ ở đây, KHÔNG trong Rebuild(): hàm này navigate được, mà Rebuild còn chạy lúc prerender
    }

    /// <summary>Đọc nguồn CHẬM (file config) — tối đa mỗi 10s, khỏi đọc mỗi nhịp 2s.</summary>
    private void ReloadStatic()
    {
        _accounts = Config.BigSellerAccounts();
        _staticLoadedAt = DateTimeOffset.UtcNow;
    }

    // Thứ tự BẮT BUỘC: quỹ/hold dựng TRƯỚC bộ lọc (mọi luật khoá nút đọc _holds).
    private void Rebuild()
    {
        BuildRows();
        BuildBudgets();
        ApplyFilter();
        RecomputeKpis();
        if (_tab != "orders") return;
        // Nguồn chậm (bảng shop + bảng đơn) 10s một lượt; gương + lệnh của máy đang chọn thì mỗi nhịp (nút phải
        // bám ACK của client). Thứ tự BẮT BUỘC: gương trước, thẻ máy sau (thẻ máy đọc số đếm của gương).
        if ((DateTimeOffset.UtcNow - _ordersLoadedAt).TotalSeconds > 10) ReloadOrders();
        ReloadOrdersLive();
        BuildOrdersMachines();
    }

    // Dòng bảng = MỌI shop trong config ĐÃ gán ngăn dữ liệu (shop chưa gán thì không giao việc được → chỉ đếm
    // để nói ở dòng hint). KHÔNG overlay ledger như Fleet: shop mồ côi không giao việc được nữa.
    private void BuildRows()
    {
        var rows = new List<Row>();
        var hidden = 0;
        _acctNames = _accounts.GroupBy(a => a.Id, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.First().DisplayName, StringComparer.Ordinal);
        _shopNames = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var acct in _accounts)
        foreach (var shop in acct.Shops)
        {
            _shopNames[shop.Id] = shop.DisplayName;
            if (string.IsNullOrWhiteSpace(shop.ShopeeDataSheet)) { hidden++; continue; }
            rows.Add(new Row
            {
                AccountId = acct.Id,
                AccountName = acct.DisplayName,
                ShopId = shop.Id,
                ShopName = shop.DisplayName,
                Sheet = shop.ShopeeDataSheet!,
                Key = acct.Id + "__" + shop.Id,
            });
        }
        _hiddenNoSheet = hidden;
        _rows = rows
            .OrderBy(r => r.AccountName, StringComparer.CurrentCultureIgnoreCase)
            .ThenBy(r => r.ShopName, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
    }

    private void ApplyFilter()
    {
        var q = _fQuery.Trim();
        // Ô TÌM lọc ở mức TÀI KHOẢN, không phải mức shop: gõ tên một shop (vd "delica") → giữ nguyên CẢ tài khoản
        // chứa shop đó cùng MỌI shop của nó. Vì 1 acc chỉ chạy 1 máy tại 1 thời điểm — thấy thiếu shop cùng acc là
        // dễ thao tác sai (nút "cả acc" cũng chỉ đúng nghĩa khi nhìn đủ shop của acc).
        var hit = q.Length == 0 ? null : _rows
            .Where(r => r.ShopName.Contains(q, StringComparison.OrdinalIgnoreCase)
                     || r.AccountName.Contains(q, StringComparison.OrdinalIgnoreCase))
            .Select(r => r.AccountId)
            .ToHashSet(StringComparer.Ordinal);

        _visible = _rows.Where(r =>
            (_fAcct.Length == 0 || r.AccountId == _fAcct)
            && MatchState(r)
            && (hit is null || hit.Contains(r.AccountId)))
            .ToList();

        // Cụm nút cả-acc đang chờ bấm-lần-nữa mà acc rơi khỏi bộ lọc → huỷ chờ (kẻo bấm lần 2 trúng acc khác).
        if (_confirmAcct.Length > 0)
        {
            var bar = _confirmAcct.LastIndexOf('|');
            if (bar <= 0 || !_visible.Any(r => r.AccountId == _confirmAcct[..bar])) _confirmAcct = "";
        }
        // Cụm HUỶ-theo-acc đang chờ mà acc rơi khỏi bộ lọc → huỷ chờ (cú bấm thứ 2 sẽ trúng acc khác).
        if (_confirmCancel.StartsWith("acct|", StringComparison.Ordinal)
            && !_visible.Any(r => r.AccountId == _confirmCancel[5..])) _confirmCancel = "";
    }

    private bool MatchState(Row r) => _fState switch
    {
        "run" => DispatchOps.Any(op => Cell(r, op).Kind == 1),
        "int" => DispatchOps.Any(op => Cell(r, op).Kind == 3)
                 || Snap.Interrupted.Any(a => a.BigsellerId == r.AccountId && a.ShopId == r.ShopId),
        "all" => true,
        _ => DispatchOps.Any(op => !Cell(r, op).Text.StartsWith('✓')),   // "todo": còn op chưa xong
    };

    private OpCellState Cell(Row r, string op) => FleetStateService.OpCell(Snap, r.AccountId, r.ShopId, op);

    private static string LedgerKey(Row r, string op) => $"{r.AccountId}__{r.ShopId}__{op}";

    /// <summary>Assignment hub-giao ĐANG MỞ của đúng ô (acc, shop, op) — <c>Snap.Assignments</c> chứa cả việc op
    /// 'rewrite' lẫn của shop khác nên phải lọc đủ 3 khoá.</summary>
    private Assignment? OpenAsn(Row r, string op) => Snap.Assignments.FirstOrDefault(a =>
        a.BigsellerId == r.AccountId && a.ShopId == r.ShopId && a.Op == op && a.Status is "queued" or "running");

    // Quỹ máy: trần Brave máy tự báo (0 = chưa báo → coi như DefaultBrave) trừ số việc đang chạy/chờ gắn máy đó.
    private void BuildBudgets()
    {
        _holds = Holds();
        var used = new Dictionary<string, int>(StringComparer.Ordinal);
        foreach (var a in Snap.Assignments.Where(a => a.Status is "queued" or "running"))
        {
            var mid = !string.IsNullOrEmpty(a.ClaimedByMachineId) ? a.ClaimedByMachineId : a.TargetMachineId ?? "";
            if (mid.Length == 0) continue;
            used[mid] = used.GetValueOrDefault(mid) + 1;
        }
        _used = used;
        _budgets = Snap.Machines
            // CHỈ suất Workspace: suất đơn hàng KHÔNG claim việc BigSeller (hub cũng chặn cứng ở ClaimNext/
            // CreateAssignment) → hiện ra chỉ tổ giao nhầm rồi việc nằm chờ mãi.
            .Where(m => m.Kind != MachineSlots.Orders)
            .Select(m =>
            {
                var cap = m.MaxBrave > 0 ? m.MaxBrave : DefaultBrave;
                var run = used.GetValueOrDefault(m.MachineId);
                return new MachineBudget(
                    m.MachineId,
                    string.IsNullOrWhiteSpace(m.Hostname) ? m.MachineId : m.Hostname,
                    !FleetStateService.MachineOffline(Snap, m.MachineId),
                    Math.Max(0, cap - run), run,
                    m.AppVersion ?? "", m.LastSeen, m.Mode);
            })
            .OrderByDescending(m => m.Online)
            .ThenBy(m => m.Hostname, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        // Máy đang chọn TẮT/biến mất giữa chừng (nhịp fleet 2s) → tự bỏ chọn + nói rõ, khỏi giao vào một máy
        // không claim được việc (việc sẽ nằm chờ mãi).
        if (_selMachine.Length == 0) return;
        var sel = _budgets.FirstOrDefault(m => m.MachineId == _selMachine);
        if (sel is null) DropMachine($"Máy {_selHost} vừa rời fleet — đã bỏ chọn.");
        else if (!sel.Online) DropMachine($"Máy {sel.Hostname} vừa offline — đã bỏ chọn.");
        else _selHost = sel.Hostname;
    }

    private void DropMachine(string why)
    {
        _selMachine = "";
        _confirmCancel = "";
        _confirmAcct = "";
        _machineMsg = why;
    }

    /// <summary>Máy đang GIỮ từng acc BigSeller (khoá 1-acc-1-máy) — CÙNG luật hub dùng lúc client claim việc
    /// (HubDatabase.AccountOwnersLocked): lease việc còn tươi, rồi tới assignment đang 'running'.
    /// CHÚ Ý: KHÔNG dùng <c>Snap.AccountLeases</c> — bảng đó khoá acc SHOPEE (và khoá "orders:&lt;login&gt;" của
    /// module Đơn hàng), khác hẳn không gian Id của acc BigSeller.</summary>
    private Dictionary<string, string> Holds()
    {
        var map = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var l in Snap.Leases)
            if (l.BigsellerId.Length > 0 && l.MachineId.Length > 0 && !map.ContainsKey(l.BigsellerId))
                map[l.BigsellerId] = l.MachineId;
        foreach (var a in Snap.Assignments.Where(a => a.Status == "running"))
            if (a.BigsellerId.Length > 0 && a.ClaimedByMachineId.Length > 0 && !map.ContainsKey(a.BigsellerId))
                map[a.BigsellerId] = a.ClaimedByMachineId;
        return map;
    }

    /// <summary>Số 4 thẻ KPI + DÒNG của 4 bảng chi tiết, dựng trong CÙNG một lượt: mỗi số là <c>Count</c> của
    /// đúng danh sách mà bảng đó vẽ ra, nên thẻ không bao giờ nói một đằng bảng một nẻo. Cụ thể "đang chạy" vẫn
    /// quét theo Ô LƯỚI (giữ nguyên ý nghĩa số cũ) — mà ô lưới ⏳ có thể do LEASE (việc chạy TAY, không có
    /// assignment) → những việc đó vẫn hiện trong bảng, đánh dấu <c>Manual</c> thay vì bị giấu đi.</summary>
    private void RecomputeKpis()
    {
        _onlineMachines = Snap.Machines
            .Where(m => (DateTimeOffset.Now - m.LastSeen).TotalSeconds < 45)
            .OrderBy(m => m.Kind == MachineSlots.Orders)   // suất workspace (giao việc được) lên trước
            .ThenBy(m => m.Hostname, StringComparer.CurrentCultureIgnoreCase)
            .ToList();
        _kMachines = _onlineMachines.Count;

        var running = new List<WorkItem>();
        var queued = new List<WorkItem>();
        foreach (var r in _rows)
        foreach (var op in DispatchOps)
        {
            var k = Cell(r, op).Kind;
            if (k == 1) running.Add(RunningItem(r, op));
            else if (k == 2 && OpenAsn(r, op) is { Status: "queued" } asn) queued.Add(QueuedItem(r, op, asn));
        }
        _running = running;
        _queued = queued;
        _kRunning = running.Count;
        _kQueued = queued.Count;
        _kInterrupted = Snap.Interrupted.Count;

        // Dòng đang chờ bấm-lần-nữa mà đã rơi khỏi bảng (nhịp fleet 2s) → huỷ chờ, kẻo cú bấm thứ 2 trúng việc
        // khác — đúng lỗi đã phải vá cho cụm nút "cả acc".
        if (_confirmWork.Length > 0
            && !running.Any(w => w.AsnId == _confirmWork) && !queued.Any(w => w.AsnId == _confirmWork))
            _confirmWork = "";
        if (_confirmDismiss && _kInterrupted == 0) _confirmDismiss = false;
        // Nút "Huỷ MỌI việc" đang chờ bấm-lần-nữa mà hệ thống vừa hết việc → huỷ chờ (nút cũng thành disabled).
        if (_confirmCancel == "all" && AllOpenCount == 0) _confirmCancel = "";
    }

    /// <summary>Dòng "đang chạy" của ô (shop, op). Nguồn thật của ô ⏳ theo đúng thứ tự OpCell xét: lease tươi
    /// (chạy tay HOẶC hub-giao) trước, rồi assignment 'running'. Không có assignment ⇒ việc chạy TAY.</summary>
    private WorkItem RunningItem(Row r, string op)
    {
        // CHỈ nhận lease còn nhịp: bảng leases không xoá khi client chết, nên bản CHẾT của lượt chạy hôm qua
        // vẫn nằm đó — lấy AcquiredAt của nó thì "Chạy từ" báo "1 ngày trước" cho việc vừa khởi động.
        // 120s = đúng ngưỡng FleetStateService dùng để quyết ô có còn ⏳ hay không.
        var lease = Snap.Leases.FirstOrDefault(l => l.Key == LedgerKey(r, op)
            && (DateTimeOffset.Now - l.HeartbeatAt).TotalSeconds < 120);
        var asn = Snap.Assignments.FirstOrDefault(a =>
            a.BigsellerId == r.AccountId && a.ShopId == r.ShopId && a.Op == op && a.Status == "running");
        // "Chạy từ": lease.AcquiredAt là mốc bắt đầu THẬT; assignment.UpdatedAt bị nhịp 'running' đẩy liên tục
        // nên vô dụng ở đây → cạn lease thì lấy CreatedAt (lúc xếp việc).
        var since = lease is not null ? lease.AcquiredAt : asn?.CreatedAt ?? default;
        var host = asn is not null
            ? HostLabel(asn.ClaimedByMachineId, asn.ClaimedByHostname)
            : HostLabel(lease?.MachineId ?? "", lease?.Hostname ?? "");
        return new WorkItem(
            LedgerKey(r, op), asn?.Id ?? "", op, r.ShopName, r.AccountName, host, since,
            RowRange(asn?.StartRow ?? 0, asn?.EndRow ?? 0), Manual: asn is null);
    }

    private WorkItem QueuedItem(Row r, string op, Assignment asn) => new(
        LedgerKey(r, op), asn.Id, op, r.ShopName, r.AccountName,
        // Máy đích rỗng = việc chờ KHÔNG ghim máy nào (bản cũ / điều phối tự động theo vai trò).
        string.IsNullOrEmpty(asn.TargetMachineId) ? "—" : HostLabel(asn.TargetMachineId, ""),
        asn.CreatedAt, RowRange(asn.StartRow, asn.EndRow), Manual: false);

    // ── Bảng chi tiết KPI: nhãn + hành động ───────────────────────────────────────
    private int KpiCount(string key) => key switch
    {
        "machines" => _kMachines, "running" => _kRunning, "queued" => _kQueued,
        "interrupted" => _kInterrupted, _ => 0,
    };

    private string KpiPanelTitle() => _kpi switch
    {
        "machines" => $"🖥 Máy online ({_kMachines})",
        "running" => $"▶ Việc đang chạy ({_kRunning})",
        "queued" => $"⏳ Việc chờ ({_kQueued})",
        "interrupted" => $"⚠ Việc gián đoạn ({_kInterrupted})",
        _ => "",
    };

    // Bấm lại đúng thẻ đang mở = đóng.
    private void ToggleKpi(string key)
    {
        _kpi = _kpi == key ? "" : key;
        _kpiMsg = "";
        _confirmWork = "";
        _confirmDismiss = false;
        _kpiEmptyTicks = 0;
        UpdateUrl();
    }

    /// <summary>Panel đang mở mà KPI về 0 (vừa huỷ hết): nhịp này còn hiện dòng "không còn việc nào" cho người
    /// dùng biết chuyện gì vừa xảy ra, nhịp sau tự đóng — thẻ 0 không bấm được nên không tự đóng thì panel kẹt.</summary>
    private void SyncKpiPanel()
    {
        if (_kpi.Length == 0 || KpiCount(_kpi) > 0) { _kpiEmptyTicks = 0; return; }
        if (++_kpiEmptyTicks < 2) return;
        _kpi = "";
        _kpiMsg = "";
        _kpiEmptyTicks = 0;
        UpdateUrl();
    }

    /// <summary>"→ Chọn máy này" ở bảng Máy online: ĐẶT máy đang chọn (khác <see cref="SelectMachine"/> — hàm đó
    /// bấm-lại-là-bỏ-chọn) rồi đóng panel để mắt về thẳng lưới shop bên dưới.</summary>
    private void PickMachine(string machineId)
    {
        _selMachine = machineId;
        _selHost = HostName(machineId);
        _confirmAcct = ""; _confirmCancel = "";
        _result = "";
        _machineMsg = "";
        _kpi = "";
        _kpiMsg = "";
        _kpiEmptyTicks = 0;
        UpdateUrl();
    }

    // Huỷ là thao tác một chiều → xác nhận 2 bước (bấm lần nữa), giống cụm nút "cả acc".
    private void OnWorkCancel(WorkItem w)
    {
        if (w.Manual || w.AsnId.Length == 0) return;   // việc chạy tay: hub không có gì để huỷ
        if (_confirmWork != w.AsnId) { _confirmWork = w.AsnId; _kpiMsg = ""; return; }
        _confirmWork = "";
        Db.CancelAssignment(w.AsnId);
        _kpiMsg = $"✖ Đã huỷ {OpLabel(w.Op)} · {w.ShopName} (tham số giữ nguyên — ▶ Tiếp tục để chạy lại).";
        FleetState.Refresh();
    }

    // Tiếp tục KHÔNG cần xác nhận: chỉ đưa việc về hàng chờ, không mất gì.
    private void OnResume(Assignment a)
    {
        var shop = ShopLabel(a.ShopId).Text;
        _kpiMsg = Db.ResumeAssignment(a.Id) is { } err
            ? $"✘ {OpLabel(a.Op)} · {shop}: {err}"
            : $"▶ Đã cho {OpLabel(a.Op)} · {shop} chạy lại (về hàng chờ).";
        FleetState.Refresh();
    }

    // Hub chỉ có DismissAllInterrupted() (không có API bỏ TỪNG việc) → nút này bỏ HẾT, y nút cùng tên trên Fleet.
    private void OnDismissAll()
    {
        if (!_confirmDismiss) { _confirmDismiss = true; _kpiMsg = ""; return; }
        _confirmDismiss = false;
        _kpiMsg = $"✕ Đã bỏ {Db.DismissAllInterrupted()} việc gián đoạn khỏi danh sách.";
        FleetState.Refresh();
    }

    // Máy cuối của việc gián đoạn: hostname đã claim (failed), fallback máy đích (canceled lúc còn queued chỉ có target).
    private string IntMachine(Assignment a) =>
        !string.IsNullOrWhiteSpace(a.ClaimedByHostname) ? a.ClaimedByHostname
        : (!string.IsNullOrEmpty(a.TargetMachineId) ? HostLabel(a.TargetMachineId, "") : "—");

    private static string IntReason(Assignment a) =>
        !string.IsNullOrWhiteSpace(a.LastError) ? a.LastError : (a.Status == "canceled" ? "đã huỷ" : "lỗi");

    /// <summary>Lý do lượt chạy TRƯỚC của (shop, op) hỏng — rỗng khi lượt trước không hỏng, hoặc hỏng vì bị HUỶ
    /// TAY (không phải sự cố, nói ra chỉ gây nhiễu). Nguồn Snap.Interrupted: đã lọc sẵn "bản mới nhất mỗi nhóm,
    /// chưa bị Bỏ, không còn việc đang mở, ledger chưa completed" — đúng tập việc còn đáng nói lý do.</summary>
    private string LastFailReason(Row r, string op)
    {
        var a = Snap.Interrupted.FirstOrDefault(x =>
            x.BigsellerId == r.AccountId && x.ShopId == r.ShopId && x.Op == op);
        return a is null || string.IsNullOrWhiteSpace(a.LastError) ? "" : a.LastError;
    }

    /// <summary>Tên máy đọc được: ưu tiên hostname máy đang báo nhịp, rồi hostname đóng dấu lúc claim; cạn cả hai
    /// thì id rút gọn. KHÔNG bao giờ trả rỗng — cột Máy trống là dòng vô dụng với người vận hành.</summary>
    private string HostLabel(string machineId, string storedHost)
    {
        if (machineId.Length > 0
            && Snap.Machines.FirstOrDefault(x => x.MachineId == machineId) is { } m
            && !string.IsNullOrWhiteSpace(m.Hostname)) return m.Hostname;
        if (!string.IsNullOrWhiteSpace(storedHost)) return storedHost;
        return machineId.Length > 0 ? Short(machineId) : "—";
    }

    /// <summary>Tên tài khoản / shop từ GUID cho bảng gián đoạn (nguồn <c>Snap.Interrupted</c> có thể trỏ tới
    /// shop đã xoá khỏi cấu hình). Tra được → tên, Title rỗng; không tra được → id rút gọn + Title là id đầy đủ.</summary>
    private (string Text, string Title) AcctLabel(string id) => NameLabel(_acctNames, id);
    private (string Text, string Title) ShopLabel(string id) => NameLabel(_shopNames, id);

    private static (string Text, string Title) NameLabel(Dictionary<string, string> map, string id)
    {
        if (id.Length == 0) return ("—", "");
        return map.TryGetValue(id, out var name) ? (name, "") : (Short(id), "Không còn trong cấu hình · id " + id);
    }

    private static string Short(string id) => id.Length <= 12 ? id : id[..8] + "…";

    /// <summary>Khoảng dòng hub đặt cho lượt chạy; 0 = dùng cấu hình của client (hiện "—", không phải "0–0").</summary>
    private static string RowRange(int start, int end) => start <= 0 && end <= 0
        ? "—"
        : $"{(start > 0 ? start.ToString() : "đầu")}–{(end > 0 ? end.ToString() : "cuối")}";

    // ── Tab Đơn hàng: nguồn dữ liệu ───────────────────────────────────────────────
    /// <summary>Nguồn CHẬM của tab Đơn hàng (quét cả bảng shop + bảng đơn) — tối đa mỗi 10s, khỏi chạy mỗi nhịp 2s.</summary>
    private void ReloadOrders()
    {
        try
        {
            _shops = Db.ListShops();
            _orderSums = Db.ShopOrderSummaries(WaitingStatus).ToDictionary(s => s.ShopId);
            _shopIdByLogin = new Dictionary<string, long>(StringComparer.OrdinalIgnoreCase);
            foreach (var s in _shops)
            {
                // Indexer (không ToDictionary): hub có thể có 2 shop cùng username khác hoa/thường → khỏi ném.
                if (!string.IsNullOrWhiteSpace(s.Username)) _shopIdByLogin[s.Username!.Trim()] = s.Id;
            }
        }
        catch { /* khoá DB nhất thời → giữ bản cũ */ }
        _ordersLoadedAt = DateTimeOffset.UtcNow;
    }

    /// <summary>Nguồn NHANH của tab Đơn hàng (gương + lệnh của MÁY ĐANG CHỌN) — chạy mỗi nhịp fleet để nút bám
    /// được ACK của client (⏳ → ✓) thay vì chờ 10s.</summary>
    private void ReloadOrdersLive()
    {
        try
        {
            _oCounts = Db.OrdersMirrorCounts();
            _oAccounts = _oMach.Length == 0 ? new List<OrdersMirrorAccount>() : Db.OrdersAccountsOf(_oMach);
            _oCmds = _oMach.Length == 0 ? new List<OrdersCommandRow>() : Db.OrdersCommandsOf(_oMach);
        }
        catch { /* khoá DB nhất thời → giữ bản cũ */ }

        // Khoá acc của module Đơn hàng nằm CHUNG bảng account_leases, phân biệt bằng tiền tố "orders:" và
        // khoá là LOGIN đã hạ chữ (xem OrdersModuleHost.LeaseKey) — tra đúng như client ghi.
        _oHolders = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var l in Snap.AccountLeases)
        {
            if (!l.AccountId.StartsWith(OrdersLeasePrefix, StringComparison.Ordinal)) continue;
            var login = l.AccountId[OrdersLeasePrefix.Length..];
            if (login.Length > 0 && l.MachineId.Length > 0) _oHolders[login] = l.MachineId;
        }

        // Tài khoản đang bung shop mà rơi khỏi danh sách (đổi máy / máy vừa bỏ tài khoản) → thu gọn.
        if (_oOpen.Length > 0 && !_oAccounts.Any(a => a.Login == _oOpen)) _oOpen = "";
    }

    private const string OrdersLeasePrefix = "orders:";

    /// <summary>Thẻ chọn máy tab Đơn hàng: CHỈ suất đơn hàng (<see cref="MachineSlots.Orders"/>) — suất workspace
    /// không chạy module Đơn hàng nên hiện ra chỉ tổ ra lệnh vào chỗ không ai nghe. Kèm luật tự bỏ chọn khi máy
    /// đang chọn offline/biến mất, y <see cref="BuildBudgets"/> của tab BigSeller.</summary>
    private void BuildOrdersMachines()
    {
        _oMachines = Snap.Machines
            .Where(m => m.Kind == MachineSlots.Orders)
            .Select(m =>
            {
                var cnt = _oCounts.GetValueOrDefault(m.MachineId);
                return new OrdersMachineCard(
                    m.MachineId,
                    string.IsNullOrWhiteSpace(m.Hostname) ? m.MachineId : m.Hostname,
                    !FleetStateService.MachineOffline(Snap, m.MachineId),
                    m.AppVersion ?? "", m.LastSeen,
                    cnt?.Accounts ?? 0, cnt?.Running ?? 0);
            })
            .OrderByDescending(m => m.Online)
            .ThenBy(m => m.Hostname, StringComparer.CurrentCultureIgnoreCase)
            .ToList();

        if (_oMach.Length == 0) return;
        var sel = _oMachines.FirstOrDefault(m => m.MachineId == _oMach);
        if (sel is null) DropOrdersMachine($"Máy {_oHost} vừa rời fleet — đã bỏ chọn.");
        else if (!sel.Online) DropOrdersMachine($"Máy {sel.Hostname} vừa offline — đã bỏ chọn.");
        else _oHost = sel.Hostname;
    }

    private void DropOrdersMachine(string why)
    {
        _oMach = "";
        _oOpen = "";
        _oAccounts = new List<OrdersMirrorAccount>();
        _oCmds = new List<OrdersCommandRow>();
        _oMachineMsg = why;
    }

    // ── Tab Đơn hàng: nhãn + hành động ───────────────────────────────────────────
    private string OrdersMachineTitle(OrdersMachineCard m)
    {
        if (!m.Online) return $"Máy {m.Hostname} đang offline ({FleetStateService.Ago(m.LastSeen)}) — không ra lệnh được.";
        if (m.MachineId == _oMach) return $"Đang xem tài khoản của {m.Hostname} — bấm lần nữa để bỏ chọn.";
        return m.Accounts == 0
            ? $"Chọn {m.Hostname} (máy chưa đẩy danh bạ tài khoản lên hub — có thể là bản client cũ)."
            : $"Xem {m.Accounts} tài khoản Đơn hàng của {m.Hostname}.";
    }

    private void SelectOrdersMachine(string machineId)
    {
        // Bấm lại đúng thẻ đang chọn = bỏ chọn (y tab BigSeller).
        _oMach = _oMach == machineId ? "" : machineId;
        _oHost = HostName(_oMach);
        _oOpen = "";
        _oResult = "";
        _oMachineMsg = "";
        ReloadOrdersLive();
        UpdateUrl();
    }

    private void ToggleOrdersShops(string login)
    {
        _oOpen = _oOpen == login ? "" : login;
        UpdateUrl();   // view-state vào URL: F5 / chia sẻ link giữ nguyên tài khoản đang bung shop
    }

    private static string OrdersStateCss(string state) => state switch
    {
        OrdersSessionStates.Running or OrdersSessionStates.Opening => "run",
        OrdersSessionStates.Queued => "queued",
        OrdersSessionStates.Stopping => "warn",
        _ => "idle",
    };

    private static string OrdersStateLabel(string state) => state switch
    {
        OrdersSessionStates.Running => "▶ Đang chạy",
        OrdersSessionStates.Opening => "▶ Đang mở",
        OrdersSessionStates.Queued => "⏱ Chờ đến lượt",
        OrdersSessionStates.Stopping => "■ Đang dừng",
        _ => "— Dừng",
    };

    private static string OrdersActionLabel(string action) => action switch
    {
        OrdersCommandActions.Run => "▶ Chạy",
        OrdersCommandActions.Stop => "✖ Dừng",
        _ => action,
    };

    /// <summary>Số đơn đang chờ của MỘT shop trong gương — tra bảng đơn của hub theo <c>shop_login</c> (client đẩy
    /// đơn theo ĐÚNG khoá này). Shop chưa có đơn nào trên hub → 0.</summary>
    private int OrdersWaitingOfShop(OrdersMirrorShop s) =>
        _shopIdByLogin.TryGetValue(s.Login, out var id) && _orderSums.TryGetValue(id, out var sum) ? sum.Waiting : 0;

    private int OrdersWaiting(OrdersMirrorAccount a) => a.Shops.Sum(OrdersWaitingOfShop);

    /// <summary>Lệnh của tài khoản này còn ĐANG BAY (chưa ack) — nút bám theo ack, KHÔNG lạc quan theo cú bấm.</summary>
    private OrdersCommandRow? PendingOrdersCmd(string login) => _oCmds.FirstOrDefault(c =>
        string.Equals(c.Login, login, StringComparison.OrdinalIgnoreCase)
        && c.Status is OrdersCommandStatuses.Pending or OrdersCommandStatuses.Sent);

    /// <summary>Lý do lệnh gần nhất của tài khoản này HỎNG — chỉ nói trong 3 phút rồi im (như ô lưới tab BigSeller),
    /// đủ để người vận hành biết "bấm rồi mà không chạy" vì sao.</summary>
    private string LastOrdersCmdError(string login)
    {
        var c = _oCmds.FirstOrDefault(x => string.Equals(x.Login, login, StringComparison.OrdinalIgnoreCase));
        return c is { Status: OrdersCommandStatuses.Failed } && c.Error.Length > 0
               && (DateTimeOffset.Now - (c.AckAt ?? c.CreatedAt)).TotalMinutes < 3
            ? c.Error
            : "";
    }

    /// <summary>Máy đang GIỮ khoá chạy tài khoản (1 tài khoản = 1 máy tại một thời điểm); null = tự do.</summary>
    private string? OrdersHolder(string login) =>
        _oHolders.TryGetValue(login.Trim().ToLowerInvariant(), out var m) ? m : null;

    /// <summary>Nút hành động DUY NHẤT của một dòng tài khoản, xét theo THỨ TỰ: lệnh đang bay → đang chạy (Dừng)
    /// → tài khoản đang bị máy KHÁC giữ (khoá) → còn lại (Chạy).</summary>
    private OpBtn OrdersRunBtn(OrdersMirrorAccount a)
    {
        if (PendingOrdersCmd(a.Login) is { } p)
            return new($"⏳ {OrdersActionLabel(p.Action)}…", "", "blocked",
                $"Đã gửi lệnh {FleetStateService.Ago(p.CreatedAt)} — chờ máy {_oHost} xác nhận (tự bỏ sau 5' nếu máy không phản hồi).");

        var note = LastOrdersCmdError(a.Login);
        if (a.SessionState.Length > 0)
            return new("✖ Dừng", "stop", "cancel",
                $"Dừng phiên của {a.Login} trên máy {_oHost} (huỷ vòng lặp shop + đóng trình duyệt).", note);

        if (OrdersHolder(a.Login) is { } holder && !string.Equals(holder, _oMach, StringComparison.Ordinal))
            return new("▶ Chạy", "", "blocked",
                $"Tài khoản {a.Login} đang chạy ở máy {HostName(holder)} — 1 tài khoản chỉ chạy 1 máy tại một thời điểm.", note);

        return new("▶ Chạy", "run", "run",
            $"Chạy {a.Login} trên máy {_oHost}: đăng nhập subaccount rồi lặp lần lượt {a.Shops.Count} shop.", note);
    }

    // Một click = MỘT lệnh (huỷ lại được bằng chính nút đó khi phiên đã chạy) — không xác nhận 2 bước.
    private void OnOrdersRunClick(OrdersMirrorAccount a)
    {
        var b = OrdersRunBtn(a);
        if (b.Disabled || _oMach.Length == 0) return;   // phòng thân: browser đã chặn bằng thuộc tính disabled

        var action = b.Act == "stop" ? OrdersCommandActions.Stop : OrdersCommandActions.Run;
        // Idempotent phía hub: bấm 2 lần (hoặc 2 tab) chỉ ra MỘT lệnh đang mở cho cùng (máy, tài khoản, hành động).
        Db.CreateOrdersCommand(_oMach, a.Login, action);
        _oResult = $"⏳ Đã gửi lệnh {OrdersActionLabel(action)} · {a.Login} → {_oHost} (chờ máy nhận ở nhịp 12s rồi xác nhận).";
        ReloadOrdersLive();
        FleetState.Refresh();
    }

    private string OrdersEmptyText() => _oMach.Length == 0
        ? "Chưa chọn máy."
        : $"Máy {_oHost} chưa đẩy danh bạ tài khoản Đơn hàng lên hub (bản client cũ, hoặc máy chưa có tài khoản nào).";

    // ── Nhóm hiển thị + nhãn ──────────────────────────────────────────────────────
    private List<RowGroup> VisibleGroups() => _visible
        .GroupBy(r => r.AccountId, StringComparer.Ordinal)
        .Select(g => new RowGroup(g.Key, g.First().AccountName, g.ToList()))
