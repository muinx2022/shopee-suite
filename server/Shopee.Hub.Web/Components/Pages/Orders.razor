@page "/orders"
@attribute [Authorize(Policy = "Web")]
@implements IDisposable
@using XuLyDonShopee.Core.Services
@inject HubDatabase Db

<p class="hint m-hide">Đơn hàng client đẩy lên hub qua <code>POST /api/orders/push</code>. Lọc theo shop / trạng thái / tìm kiếm (mã đơn, người mua, tên SP, SKU) + phân trang.</p>

<div class="bar bar-stack">
    <label>Shop
        <select @bind="_shopId" @bind:after="OnFilterChanged">
            <option value="0">— tất cả —</option>
            @foreach (var s in _shops)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
    </label>
    <label>Trạng thái
        <select @bind="_status" @bind:after="OnFilterChanged">
            <option value="">— tất cả —</option>
            @foreach (var st in _statuses)
            {
                <option value="@st">@st</option>
            }
        </select>
    </label>
    <label>Tìm
        <input class="opt-search" @bind="_search" @bind:event="oninput" @bind:after="OnSearchDebounced" placeholder="mã đơn / người mua / SP / SKU" />
    </label>
    <label>Mỗi trang
        <select @bind="_pageSize" @bind:after="OnPageSizeChanged">
            @foreach (var size in PageSizeOptions)
            {
                <option value="@size">@size</option>
            }
        </select>
    </label>
    <span class="stat">@_total đơn</span>
    <button class="btn sm" title="Hủy lọc — bỏ mọi bộ lọc, xem tất cả đơn" @onclick="ClearFilters">Hủy lọc</button>
</div>

<Pagination Page="_page" TotalPages="_totalPages" TotalItems="_total" PageSize="_pageSize"
            ItemLabel="đơn" PageChanged="GoPage" />

<div class="tablewrap">
<table class="grid sm stack-sm">
    <thead><tr>
        <th>Mã đơn</th><th>Shop</th><th>Người mua</th><th>Sản phẩm</th><th class="m-hide">SKU</th><th class="m-hide">Phân loại</th><th class="m-hide">Đơn trả hàng</th>
        <th>Tổng tiền</th><th class="m-hide">Cuối cùng</th><th>Trạng thái</th><th class="m-hide">Vận chuyển</th><th class="m-hide">Phiếu</th><th class="m-hide">Sync</th>
    </tr></thead>
    <tbody>
    @foreach (var o in _orders)
    {
        // Cột "Phân loại" / "SKU" suy từ items_json (từng sản phẩm) ⇒ đơn nhiều SP hiện đủ; không có khóa sku → lùi về o.Sku.
        var phanLoai = PhanLoaiExtractor.TuItemsJson(o.ItemsJson);
        var sku = PhanLoaiExtractor.SkuTuItemsJson(o.ItemsJson);
        if (string.IsNullOrEmpty(sku)) sku = o.Sku;
        <tr>
            <td class="mono" data-label="Mã đơn">@o.OrderSn</td>
            <td data-label="Shop">@ShopName(o.ShopId)</td>
            <td data-label="Người mua">@(o.BuyerUsername ?? "—")</td>
            <td data-label="Sản phẩm" title="@o.ItemSummary">@Trim(o.ItemSummary)@(o.ItemCount > 1 ? $" (+{o.ItemCount - 1})" : "")</td>
            <td class="m-hide" data-label="SKU" title="@sku">@(string.IsNullOrEmpty(sku) ? "—" : Trim(sku))</td>
            <td class="m-hide" data-label="Phân loại" title="@phanLoai">@Trim(phanLoai)</td>
            <td class="mono m-hide" data-label="Đơn trả hàng">@(o.ReturnRequestCode ?? "—")</td>
            <td data-label="Tổng tiền">@(o.TotalPriceText ?? (o.TotalPrice?.ToString("N0") ?? "—"))</td>
            <td class="m-hide" data-label="Cuối cùng">@(o.FinalAmountText ?? (o.FinalAmount?.ToString("N0") ?? "—"))</td>
            <td data-label="Trạng thái">
                <span class="pill @StatusCss(o.Status)">@(o.Status ?? "—")</span>
                <button type="button" class="linkbtn m-only order-detail-toggle"
                        aria-expanded="@(_expandedOrderId == o.Id)"
                        @onclick="() => ToggleDetails(o.Id)">@(_expandedOrderId == o.Id ? "Thu gọn" : "Chi tiết")</button>
                @if (_expandedOrderId == o.Id)
                {
                    <div class="m-only order-detail">
                        <div><b>SKU</b><span>@(string.IsNullOrEmpty(sku) ? "—" : sku)</span></div>
                        <div><b>Phân loại</b><span>@Trim(phanLoai)</span></div>
                        <div><b>Đơn trả hàng</b><span>@(o.ReturnRequestCode ?? "—")</span></div>
                        <div><b>Số tiền cuối</b><span>@(o.FinalAmountText ?? (o.FinalAmount?.ToString("N0") ?? "—"))</span></div>
                        <div><b>Vận chuyển</b><span>@(string.IsNullOrEmpty(o.Carrier) ? (o.Channel ?? "—") : o.Carrier)@(string.IsNullOrEmpty(o.TrackingNumber) ? "" : $" · {o.TrackingNumber}")</span></div>
                        <div><b>Đồng bộ</b><span>@(o.SyncedAt == default ? "—" : GioVietNam.DinhDang(o.SyncedAt, "MM-dd HH:mm"))</span></div>
                        @if (o.SlipAt is not null)
                        {
                            <a class="btn sm" href="@($"/slips/{o.ShopId}/{o.OrderSn}")" target="_blank" rel="noopener">Mở phiếu PDF</a>
                        }
                    </div>
                }
            </td>
            <td class="m-hide" data-label="Vận chuyển">@(string.IsNullOrEmpty(o.Carrier) ? (o.Channel ?? "—") : o.Carrier)@(string.IsNullOrEmpty(o.TrackingNumber) ? "" : $" · {o.TrackingNumber}")</td>
            <td class="m-hide" data-label="Phiếu">
                @if (o.SlipAt is not null)
                {
                    <a class="linkbtn" href="@($"/slips/{o.ShopId}/{o.OrderSn}")" target="_blank" rel="noopener" title="Mở phiếu PDF (tab mới)">📄 Phiếu</a>
                }
            </td>
            <td class="m-hide" data-label="Sync">@GioVietNam.DinhDang(o.SyncedAt, "MM-dd HH:mm")</td>
        </tr>
    }
    @if (_orders.Count == 0)
    {
        <tr><td colspan="13" class="empty">Không có đơn nào khớp bộ lọc.</td></tr>
    }
    </tbody>
</table>
</div>

@if (_totalPages > 1)
{
    <Pagination Page="_page" TotalPages="_totalPages" TotalItems="_total" PageSize="_pageSize"
                ItemLabel="đơn" PageChanged="GoPage" />
}

@code {
    private static readonly int[] PageSizeOptions = [25, 50, 100];

    private List<Shop> _shops = new();
    private List<string> _statuses = new();
    private List<OrderRecord> _orders = new();
    private Dictionary<long, string> _shopNames = new();

    private long _shopId;      // 0 = tất cả
    private string _status = "Chờ lấy hàng";   // MẶC ĐỊNH lọc đơn đang cần xử lý (đổi được sang "— tất cả —")
    private string _search = "";
    private int _pageSize = 50;
    private int _page = 1;
    private int _total;
    private int _totalPages = 1;
    private long? _expandedOrderId;

    protected override void OnInitialized()
    {
        _shops = Db.ListShops();
        _shopNames = _shops.ToDictionary(s => s.Id, s => s.Name);
        _statuses = Db.DistinctOrderStatuses();
        // Đảm bảo option "Chờ lấy hàng" LUÔN có trong dropdown (kể cả khi hiện chưa có đơn nào trạng thái đó) —
        // vì đây là filter MẶC ĐỊNH, cần hiện đúng lựa chọn đang chọn.
        if (!_statuses.Contains("Chờ lấy hàng")) _statuses.Insert(0, "Chờ lấy hàng");
        Load();
    }

    private void OnFilterChanged() { _page = 1; Load(); }

    // "Hủy lọc": bỏ MỌI bộ lọc (shop/trạng thái/tìm) về xem tất cả + về trang 1. Reset luôn ô Tìm nên huỷ timer
    // debounce đang chờ, tránh nó nạp lại với chuỗi cũ ngay sau khi mình vừa xoá.
    private void ClearFilters()
    {
        _searchTimer?.Dispose();
        _shopId = 0;
        _status = "";
        _search = "";
        _page = 1;
        Load();
    }

    private void OnPageSizeChanged()
    {
        _page = 1;
        Load();
    }

    // Ô TÌM gõ liên tục (oninput) từng chạy đếm+đọc trang (LIKE %…% không index) dưới lock(_gate) toàn cục
    // của HubDatabase MỖI phím → nghẽn heartbeat/lease cả fleet. Debounce 300ms: huỷ timer cũ mỗi keystroke, chỉ query
    // KHI ngừng gõ. Callback bắn từ threadpool → InvokeAsync đưa về sync-context của circuit trước khi đụng state/DB.
    private System.Threading.Timer? _searchTimer;
    private void OnSearchDebounced()
    {
        _searchTimer?.Dispose();
        _searchTimer = new System.Threading.Timer(_ => _ = InvokeAsync(() =>
        {
            _page = 1;
            Load();
            StateHasChanged();
        }), null, 300, System.Threading.Timeout.Infinite);
    }

    public void Dispose() => _searchTimer?.Dispose();   // huỷ timer đang chờ khi rời trang (khỏi rò timer + callback trên circuit đã đóng)

    private void GoPage(int p) { _page = Math.Clamp(p, 1, _totalPages); Load(); }

    private void ToggleDetails(long id) => _expandedOrderId = _expandedOrderId == id ? null : id;

    private void Load()
    {
        long? shopFilter = _shopId > 0 ? _shopId : null;
        var status = string.IsNullOrWhiteSpace(_status) ? null : _status;
        var q = string.IsNullOrWhiteSpace(_search) ? null : _search;
        var result = Db.QueryOrdersPage(shopFilter, status, q, _pageSize, (_page - 1) * _pageSize);
        _total = result.Total;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_total / (double)_pageSize));
        if (_page > _totalPages)
        {
            _page = _totalPages;
            result = Db.QueryOrdersPage(shopFilter, status, q, _pageSize, (_page - 1) * _pageSize);
        }
        _orders = result.Items;
    }

    private string ShopName(long id) => _shopNames.GetValueOrDefault(id, id.ToString());

    private static string Trim(string? s) =>
        string.IsNullOrEmpty(s) ? "—" : s.Length > 48 ? s[..48] + "…" : s;

    private static string StatusCss(string? status) => status switch
    {
        null or "" => "idle",
        var s when s.Contains("hủy", StringComparison.OrdinalIgnoreCase) => "fail",
        var s when s.Contains("hoàn thành", StringComparison.OrdinalIgnoreCase) || s.Contains("giao") => "done",
        _ => "queued",
    };
}
