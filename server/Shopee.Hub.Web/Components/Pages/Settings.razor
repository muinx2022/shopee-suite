@page "/settings"
@attribute [Authorize(Policy = "Web")]
@using Shopee.Hub.Web.Auth
@using XuLyDonShopee.Core.Services
@inject HubDatabase Db
@inject AdminAccountService Admin
@inject IJSRuntime JS

<h2>API Token — client dùng để kết nối</h2>
<div class="editcard" style="max-width:720px">
    <p class="hint m-hide">Mọi máy client nhập token này (app → Cài đặt → ApiToken, BaseUrl = <code>https://api.schedra.net</code>) để vào fleet.
       <b>Đổi token → TẤT CẢ client phải nhập lại token mới</b> (token cũ sẽ bị 401).</p>
    <label>Token hiện tại</label>
    <div class="row">
        @* CHE = KHÔNG render token ra DOM (không phải type=password / css): xem source lúc đang che chỉ thấy
           chuỗi chấm. onfocus-select cũng chỉ gắn khi đang hiện, kẻo bôi đen lại copy nhầm mấy dấu chấm. *@
        <input readonly value="@(_showToken ? _token : MaskedToken)" class="opt-search"
               style="font-family:monospace;width:min(440px,100%)"
               onfocus="@(_showToken ? "this.select()" : null)" />
        <button class="btn" title="@(_showToken ? "Ẩn token" : "Hiện token thật")" @onclick="ToggleToken">@(_showToken ? "🙈 Ẩn" : "👁 Hiện")</button>
        @* Copy LUÔN lấy giá trị thật (không đọc từ ô đang che) — copy được cả khi đang che. *@
        <button class="btn" title="Copy token thật vào clipboard (không cần bấm Hiện)" @onclick="CopyToken">📋 Copy</button>
        <span class="action">@_copyStatus</span>
    </div>
    <label style="margin-top:12px">Đổi token</label>
    <div class="row">
        <input @bind="_newToken" placeholder="dán token mới, hoặc bấm Sinh ngẫu nhiên" class="opt-search" style="font-family:monospace;width:min(440px,100%)" />
        <button class="btn" @onclick="GenToken">🎲 Sinh ngẫu nhiên</button>
    </div>
    <div class="bar">
        <button class="btn danger" @onclick="SaveToken" title="Đổi token → TẤT CẢ client phải nhập lại token mới!">💾 Lưu token mới</button>
        <span class="action">@_tokenStatus</span>
    </div>
</div>

<h2>Thông báo webhook — Hub quyết định gửi</h2>
<div class="editcard" style="max-width:720px">
    <p class="hint m-hide">Client chỉ đẩy đơn / báo sự kiện lên Hub. <b>Hub</b> quyết định gửi Slack/Discord/Telegram.
       Mỗi sự kiện một URL (trống = tắt). Máy độc lập (chưa nối Hub) mới dùng webhook trên app client.</p>

    <label>Có đơn mới</label>
    <input @bind="_webhookDonMoi" class="opt-search" style="width:100%;font-family:monospace;font-size:12px"
           placeholder="https://hooks.slack.com/services/… (vd. #shopee-suite)" />

    <label style="margin-top:12px">Lỗi app</label>
    <input @bind="_webhookLoiApp" class="opt-search" style="width:100%;font-family:monospace;font-size:12px"
           placeholder="https://hooks.slack.com/services/… (vd. #canh-bao-app)" />
    <p class="hint m-hide" style="margin-top:4px">Hiện: không đặt được địa chỉ lấy hàng (client báo → Hub gửi).</p>

    <label style="margin-top:12px">Có đơn trả hàng</label>
    <input @bind="_webhookDonTra" class="opt-search" style="width:100%;font-family:monospace;font-size:12px"
           placeholder="https://hooks.slack.com/services/…" />
    <p class="hint m-hide" style="margin-top:4px">Khi push đơn kèm mã trả mới/đổi → Hub gửi.</p>

    <label style="margin-top:12px">Máy client rơi offline khi đang giữ việc</label>
    <input @bind="_webhookMayOffline" class="opt-search" style="width:100%;font-family:monospace;font-size:12px"
           placeholder="https://hooks.slack.com/services/… (vd. #canh-bao-may)" />
    <div class="row" style="margin-top:8px">
        <label class="toggle" title="Tắt = Hub không theo dõi máy mất nhịp nữa (ô URL vẫn giữ nguyên).">
            <input type="checkbox" @bind="_mayOfflineBat" />
            Bật cảnh báo máy offline
        </label>
        <label class="toggle" title="Máy mất nhịp quá số phút này MÀ đang giữ việc → Hub gửi 1 tin; máy nối lại gửi 1 tin nữa.">
            Ngưỡng mất nhịp
            <input type="number" @bind="_mayOfflinePhut" min="@MachineOfflineWatchService.NguongMinPhut"
                   max="@MachineOfflineWatchService.NguongMaxPhut" class="opt-search" style="width:90px" />
            phút
        </label>
    </div>
    <p class="hint m-hide" style="margin-top:4px">Mỗi lần máy rơi chỉ gửi 1 tin, máy nối lại gửi 1 tin nữa (hub khởi động lại thì quên trạng thái này và có thể báo lại một lần). "Đang giữ việc" đếm cả việc vừa bị hub đánh rụng vì máy hết nhịp.</p>

    <div class="bar" style="margin-top:12px">
        <button class="btn primary" @onclick="SaveWebhooks">💾 Lưu webhook</button>
        <span class="action">@_webhookStatus</span>
    </div>
</div>

<h2>Đổi mật khẩu admin (đăng nhập web)</h2>
<div class="editcard" style="max-width:720px">
    @* Hai ô + nút Lưu chỉ bật khi KHỚP: gõ nhầm mật khẩu mới = tự khoá mình khỏi hub (không có đường khôi phục
       ngoài sửa DB trên VM). @bind:event="oninput" để nút/dòng lỗi phản hồi ngay từng phím, không đợi rời ô. *@
    <label>Mật khẩu mới (≥ 6 ký tự)</label>
    <input @bind="_newPass" @bind:event="oninput" type="password" class="opt-search" style="width:min(320px,100%)" />
    <label style="margin-top:10px">Nhập lại mật khẩu</label>
    <input @bind="_newPass2" @bind:event="oninput" type="password" class="opt-search" style="width:min(320px,100%)" />
    @if (_newPass2.Length > 0 && _newPass != _newPass2)
    {
        <div class="fielderr">⚠ Hai ô mật khẩu chưa khớp.</div>
    }
    <div class="bar">
        <button class="btn primary" disabled="@(!PassMatches)"
                title="@(PassMatches ? "Đổi mật khẩu đăng nhập web" : "Nhập mật khẩu mới ở CẢ HAI ô và phải khớp nhau")"
                @onclick="SavePass">💾 Đổi mật khẩu</button>
        <span class="action">@_passStatus</span>
    </div>
</div>

<ConfirmDialog @ref="_confirm" />

@code {
    /// <summary>Chuỗi hiện thay token khi đang che — độ dài CỐ ĐỊNH, không tiết lộ độ dài token thật.</summary>
    private const string Mask = "••••••••••••";

    private ConfirmDialog? _confirm;
    private string _token = "";
    private bool _showToken;      // false = ô token chỉ render Mask (token thật KHÔNG có trong DOM)
    private string _newToken = "";
    private string _tokenStatus = "";
    private string _copyStatus = "";
    private string _newPass = "";
    private string _newPass2 = "";
    private string _passStatus = "";

    private string MaskedToken => _token.Length == 0 ? "" : Mask;
    private bool PassMatches => _newPass.Length > 0 && _newPass == _newPass2;
    private string _webhookDonMoi = "";
    private string _webhookLoiApp = "";
    private string _webhookDonTra = "";
    private string _webhookMayOffline = "";
    private bool _mayOfflineBat;
    private int _mayOfflinePhut = MachineOfflineWatchService.NguongMacDinhPhut;
    private string _webhookStatus = "";

    protected override void OnInitialized()
    {
        _token = Db.GetSetting(SettingKeys.ApiToken) ?? "";
        LoadWebhooks();
    }

    private void LoadWebhooks()
    {
        _webhookDonMoi = Db.GetSetting(SettingKeys.NotifyWebhookDonMoi)?.Trim() ?? "";
        _webhookLoiApp = Db.GetSetting(SettingKeys.NotifyWebhookLoiApp)?.Trim() ?? "";
        _webhookDonTra = Db.GetSetting(SettingKeys.NotifyWebhookDonTra)?.Trim() ?? "";
        // Kênh máy-offline KHÔNG có bản legacy (chưa từng nằm trong ô notify.webhooks) → không tham gia khối
        // migrate bên dưới. Ngưỡng đọc qua đúng hàm kẹp mà service dùng, để ô hiện ra bằng số thực sự có hiệu lực.
        _webhookMayOffline = Db.GetSetting(SettingKeys.NotifyWebhookMayOffline)?.Trim() ?? "";
        _mayOfflineBat = (Db.GetSetting(SettingKeys.NotifyMayOfflineBat) ?? "").Trim() == "1";
        _mayOfflinePhut = MachineOfflineWatchService.KepNguong(Db.GetSetting(SettingKeys.NotifyMayOfflinePhut));

        if (_webhookDonMoi.Length == 0 && _webhookLoiApp.Length == 0 && _webhookDonTra.Length == 0)
        {
            var legacy = Db.GetSetting(SettingKeys.NotifyWebhooks);
            if (!string.IsNullOrWhiteSpace(legacy))
            {
                var lines = legacy.Replace("\r\n", "\n").Replace('\r', '\n')
                    .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                if (lines.Length > 0) _webhookDonMoi = lines[0];
                if (lines.Length > 1)
                    _webhookStatus = $"⚠ Bản cũ có {lines.Length} URL — đang gửi đủ tất cả cho đơn mới. Lưu sẽ chỉ giữ 1 URL ô đơn mới.";
            }
        }
    }

    private void GenToken() =>
        _newToken = Convert.ToHexString(System.Security.Cryptography.RandomNumberGenerator.GetBytes(24));

    private void ToggleToken() { _showToken = !_showToken; _copyStatus = ""; }

    private async Task CopyToken()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", _token); _copyStatus = "✔ đã copy"; }
        catch { _copyStatus = "⚠ trình duyệt chặn — bấm 👁 Hiện rồi bôi đen ô để copy tay"; }
    }

    private async Task SaveToken()
    {
        var t = _newToken.Trim();
        if (t.Length < 8) { _tokenStatus = "⚠ Token quá ngắn (≥ 8 ký tự)."; return; }
        if (_confirm is null) return;
        if (!await _confirm.AskAsync("Đổi API token?",
                "MỌI client đang chạy sẽ mất kết nối (401) cho tới khi bạn nhập token mới vào từng máy. "
                + "Token cũ hết hiệu lực NGAY khi lưu.",
                "💾 Đổi token", danger: true))
            return;
        Db.SetSetting(SettingKeys.ApiToken, t);
        _token = t; _newToken = "";
        _showToken = false;   // token mới cũng che mặc định; muốn xem thì bấm 👁 (hoặc bấm 📋 Copy)
        _tokenStatus = "✔ Đã đổi token — hiệu lực NGAY. Nhập token này vào MỌI client (token cũ giờ bị 401).";
    }

    private void SavePass()
    {
        if (!PassMatches) { _passStatus = "⚠ Hai ô mật khẩu chưa khớp."; return; }
        if (_newPass.Length < 6) { _passStatus = "⚠ Mật khẩu < 6 ký tự."; return; }
        Admin.SetAdmin(Admin.Username ?? "admin", _newPass);
        _newPass = ""; _newPass2 = "";
        _passStatus = "✔ Đã đổi mật khẩu admin (lần đăng nhập sau dùng mật khẩu mới).";
    }

    private void SaveWebhooks()
    {
        var donMoi = (_webhookDonMoi ?? "").Trim();
        var loiApp = (_webhookLoiApp ?? "").Trim();
        var donTra = (_webhookDonTra ?? "").Trim();
        var mayOffline = (_webhookMayOffline ?? "").Trim();

        foreach (var (nhan, url) in new[]
        {
            ("Có đơn mới", donMoi), ("Lỗi app", loiApp), ("Có đơn trả hàng", donTra), ("Máy offline", mayOffline),
        })
        {
            var err = OrderNotifyService.KiemTraUrl(url);
            if (err is not null) { _webhookStatus = $"⚠ {nhan}: {err}"; return; }
        }

        Db.SetSetting(SettingKeys.NotifyWebhookDonMoi, donMoi);
        Db.SetSetting(SettingKeys.NotifyWebhookLoiApp, loiApp);
        Db.SetSetting(SettingKeys.NotifyWebhookDonTra, donTra);
        Db.SetSetting(SettingKeys.NotifyWebhooks, "");
        // Kẹp NGAY khi lưu (không chỉ khi đọc): ô number vẫn gõ tay được số ngoài min/max.
        var phut = Math.Clamp(_mayOfflinePhut, MachineOfflineWatchService.NguongMinPhut, MachineOfflineWatchService.NguongMaxPhut);
        Db.SetSetting(SettingKeys.NotifyWebhookMayOffline, mayOffline);
        Db.SetSetting(SettingKeys.NotifyMayOfflineBat, _mayOfflineBat ? "1" : "0");
        Db.SetSetting(SettingKeys.NotifyMayOfflinePhut, phut.ToString());

        _webhookDonMoi = donMoi;
        _webhookLoiApp = loiApp;
        _webhookDonTra = donTra;
        _webhookMayOffline = mayOffline;
        _mayOfflinePhut = phut;

        var parts = new List<string>();
        if (donMoi.Length > 0) parts.Add("đơn mới");
        if (loiApp.Length > 0) parts.Add("lỗi app");
        if (donTra.Length > 0) parts.Add("đơn trả");
        if (mayOffline.Length > 0 && _mayOfflineBat) parts.Add($"máy offline > {phut}'");
        _webhookStatus = parts.Count == 0
            ? "✔ Đã tắt toàn bộ webhook."
            : "✔ Đã lưu: " + string.Join(", ", parts) + " — Hub gửi khi có sự kiện."
              + (mayOffline.Length > 0 && !_mayOfflineBat ? " (kênh máy offline đang TẮT)" : "");
    }
}
