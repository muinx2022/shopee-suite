@inherits LayoutComponentBase
@implements IDisposable
@using Shopee.Hub.Web.Auth
@inject FleetStateService Fleet
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AdminAccountService Admin

<div class="app @(_navOpen ? "nav-open" : null)">
    @if (_navOpen)
    {
        <div class="nav-backdrop" @onclick="CloseNav"></div>
    }
    <nav class="side">
        <div class="brand">
            <div class="brand-logo">S</div>
            <div class="brand-text">
                <div class="brand-name">Shopee Hub</div>
                <div class="brand-sub">Điều phối nhiều máy</div>
            </div>
        </div>

        <div class="side-scroll">
            <div class="navsec">Đơn hàng</div>
            <NavLink class="nav" href="/shops" title="Shop" aria-label="Shop"><span class="nav-ic">@HubIcons.Svg("shop")</span><span>Shop</span></NavLink>
            <NavLink class="nav" href="/orders" title="Đơn hàng" aria-label="Đơn hàng"><span class="nav-ic">@HubIcons.Svg("orders")</span><span>Đơn hàng</span></NavLink>

            <div class="navsec">Điều khiển</div>
            @* Giao việc ĐỨNG TRƯỚC: đó là trang điều khiển mở cả ngày; "/" giờ chỉ còn soi số liệu & sửa cấu hình
               của tài khoản BigSeller → nhãn "BigSeller" (song song với "Acc Shopee & Proxy" bên dưới). *@
            <NavLink class="nav" href="/dispatch" title="Giao việc" aria-label="Giao việc"><span class="nav-ic">@HubIcons.Svg("dispatch")</span><span>Giao việc</span></NavLink>
            <NavLink class="nav" href="/" Match="NavLinkMatch.All" title="BigSeller" aria-label="BigSeller"><span class="nav-ic">@HubIcons.Svg("fleet")</span><span>BigSeller</span></NavLink>
            <NavLink class="nav" href="/machines" title="Máy client" aria-label="Máy client"><span class="nav-ic">@HubIcons.Svg("machines")</span><span>Máy client</span></NavLink>
            <NavLink class="nav" href="/search" title="Search" aria-label="Search"><span class="nav-ic">@HubIcons.Svg("search")</span><span>Search</span></NavLink>
            <NavLink class="nav" href="/data" title="Dữ liệu" aria-label="Dữ liệu"><span class="nav-ic">@HubIcons.Svg("data")</span><span>Dữ liệu</span></NavLink>

            <div class="navsec">Cấu hình</div>
            <NavLink class="nav" href="/config/accounts" title="Acc Shopee &amp; Proxy" aria-label="Acc Shopee và Proxy"><span class="nav-ic">@HubIcons.Svg("users")</span><span>Acc Shopee &amp; Proxy</span></NavLink>
            <NavLink class="nav" href="/config/errored" title="Acc lỗi" aria-label="Acc lỗi"><span class="nav-ic">@HubIcons.Svg("alert")</span><span>Acc lỗi</span></NavLink>
            <NavLink class="nav" href="/config/ai" title="AI" aria-label="AI"><span class="nav-ic">@HubIcons.Svg("ai")</span><span>AI</span></NavLink>
            <NavLink class="nav" href="/config/orders" title="Đơn hàng GSheet" aria-label="Đơn hàng GSheet"><span class="nav-ic">@HubIcons.Svg("orders")</span><span>Đơn hàng (GSheet)</span></NavLink>

            <div class="navsec">Hệ thống</div>
            <NavLink class="nav" href="/settings" title="Cài đặt" aria-label="Cài đặt"><span class="nav-ic">@HubIcons.Svg("settings")</span><span>Cài đặt</span></NavLink>
            <NavLink class="nav" href="/files" title="Files" aria-label="Files"><span class="nav-ic">@HubIcons.Svg("files")</span><span>Files</span></NavLink>
            <NavLink class="nav" href="/logs-view" title="Logs" aria-label="Logs"><span class="nav-ic">@HubIcons.Svg("logs")</span><span>Logs</span></NavLink>
        </div>

        <div class="side-foot">
            <div class="fleet-badge">
                <span class="fb-dot @(_online > 0 ? "on" : "")"></span>
                <span><b>@_online</b>/@_total máy online</span>
            </div>
        </div>
    </nav>

    <div class="main">
        <header class="topbar">
            <button type="button" class="nav-toggle" title="Mở menu" @onclick="ToggleNav" aria-label="Mở menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </button>
            <div class="topbar-title">@_pageTitle</div>
            <div class="topbar-right">
                <span class="topbar-user">👤 @(Admin.Username ?? "admin")</span>
                <button class="theme-btn" title="Đổi sáng/tối" @onclick="ToggleTheme">
                    <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
                    <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                </button>
                <form method="post" action="/logout"><button class="btn sm danger" type="submit">↪ Đăng xuất</button></form>
            </div>
        </header>

        <main class="content">
            @Body
        </main>
    </div>
</div>

@code {
    private int _online, _total;
    private string _pageTitle = "BigSeller";
    private bool _navOpen;

    protected override void OnInitialized()
    {
        Fleet.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
        Recount();
        UpdateTitle();
    }

    private async Task ToggleTheme() => await JS.InvokeVoidAsync("toggleTheme");

    private void ToggleNav() => _navOpen = !_navOpen;
    private void CloseNav() => _navOpen = false;

    private void OnChanged() => InvokeAsync(() => { Recount(); StateHasChanged(); });
    private void OnLocationChanged(object? s, LocationChangedEventArgs e) => InvokeAsync(() =>
    {
        _navOpen = false;
        UpdateTitle();
        StateHasChanged();
    });

    private void Recount()
    {
        var m = Fleet.Snapshot.Machines;
        _total = m.Count;
        _online = m.Count(x => (DateTimeOffset.Now - x.LastSeen).TotalSeconds < 45);
    }

    private void UpdateTitle()
    {
        var p = Nav.ToBaseRelativePath(Nav.Uri);
        var q = p.IndexOf('?'); if (q >= 0) p = p[..q];
        p = p.TrimEnd('/');
        _pageTitle = p switch
        {
            "" => "BigSeller",
            "shops" => "Shop",
            "orders" => "Đơn hàng",
            "dispatch" => "Giao việc",
            "machines" => "Máy client",
            "search" => "Search đa máy",
            "data" => "Dữ liệu sản phẩm",
            "config/accounts" => "Tài khoản Shopee & Proxy",
            "config/errored" => "Tài khoản lỗi / captcha",
            "config/ai" => "Cấu hình AI",
            "config/orders" => "Đơn hàng — đồng bộ Google Sheet",
            "settings" => "Cài đặt hub",
            "files" => "Files",
            "logs-view" => "Logs",
            _ => "Shopee Hub",
        };
    }

    public void Dispose()
    {
        Fleet.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
