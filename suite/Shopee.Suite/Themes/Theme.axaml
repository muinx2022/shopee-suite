<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">

    <Styles.Resources>
        <!-- ══════════ COLOR / BRUSH TOKENS — palette ẤM-trung tính (bộ design handoff) ══════════ -->
        <!-- Accent = CAM Shopee #EE4D2D (đồng nhất toàn suite với module Đơn hàng). Hover/pressed là cam đậm dần. -->
        <SolidColorBrush x:Key="AccentBrush" Color="#EE4D2D" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#D8401F" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#C93B1D" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#1F8A4C" />
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#17703C" />
        <SolidColorBrush x:Key="DangerBrush" Color="#C22B1E" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#A82217" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B06F06" />
        <SolidColorBrush x:Key="InfoBrush" Color="#2B5FC4" />

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F7F5F3" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E2DDD8" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FBFAF9" />

        <!-- Viền theo 3 nấc đậm→nhạt: dải/ribbon (strong) · thẻ + khung bảng (light) · kẻ dòng (lightest). -->
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#E5E1DD" />
        <SolidColorBrush x:Key="BorderLightBrush" Color="#EBE7E3" />
        <SolidColorBrush x:Key="BorderLightestBrush" Color="#F4F1EE" />
        <!-- Nền hover: dòng bảng (ấm hồng rất nhạt) · nút/ô trắng (be nhạt) · viền ô nhập khi rê chuột. -->
        <SolidColorBrush x:Key="RowHoverBrush" Color="#FFFAF8" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F6F3F0" />
        <SolidColorBrush x:Key="InputHoverBorderBrush" Color="#CFC8C2" />

        <!-- Thương hiệu dạng "tint": chữ cam đậm trên nền sáng + 2 nấc nền/viền cam nhạt (nút phụ tông cam,
             dòng đang chọn, nút ribbon hover/active). -->
        <SolidColorBrush x:Key="BrandTextBrush" Color="#C93B1D" />
        <SolidColorBrush x:Key="BrandTintBrush" Color="#FFF3EF" />
        <SolidColorBrush x:Key="BrandTintStrongBrush" Color="#FFE8E1" />
        <SolidColorBrush x:Key="BrandTintBorderBrush" Color="#FBD6CA" />
        <SolidColorBrush x:Key="BrandTintBorderStrongBrush" Color="#F6C6BB" />

        <!-- Nền + chấm cho pill/badge trạng thái (chữ dùng Success/Warning/Danger/Info ở trên). -->
        <SolidColorBrush x:Key="SuccessBgBrush" Color="#EAFAF0" />
        <SolidColorBrush x:Key="SuccessDotBrush" Color="#3FA860" />
        <SolidColorBrush x:Key="WarningBgBrush" Color="#FFF6E6" />
        <SolidColorBrush x:Key="DangerBgBrush" Color="#FDECEB" />
        <SolidColorBrush x:Key="InfoBgBrush" Color="#EEF4FF" />
        <SolidColorBrush x:Key="NeutralBadgeBrush" Color="#6A625D" />
        <SolidColorBrush x:Key="NeutralBadgeBgBrush" Color="#F2EFEC" />
        <SolidColorBrush x:Key="IdleDotBrush" Color="#D3CCC7" />

        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1E2230" />
        <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#161925" />
        <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="#2A3042" />
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2A3042" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#C7CCD6" />
        <SolidColorBrush x:Key="SidebarMutedBrush" Color="#7E869B" />

        <!-- ══════════ SHELL: DẢI TAB · RIBBON · THANH TRẠNG THÁI (bộ handoff "Ribbon Window") ══════════ -->
        <!-- Dải tab + ribbon nay nền TRẮNG (bỏ bar tối cũ): chỉ còn viền hairline + nền hover rất nhạt.
             Tab đang chọn nhận diện bằng GẠCH CAM 3px ở đáy (dựng trong ItemTemplate), không tô chip. -->
        <SolidColorBrush x:Key="TabStripBorderBrush" Color="#F0EDEA" />
        <SolidColorBrush x:Key="TabHoverBrush" Color="#FAF8F6" />
        <SolidColorBrush x:Key="RibbonDividerBrush" Color="#EFECEA" />
        <!-- Huy hiệu thương hiệu (app-mark dải tab + màn Welcome): accent CAM Shopee ĐẶC. -->
        <SolidColorBrush x:Key="BrandBadgeBrush" Color="#EE4D2D" />
        <!-- Thanh trạng thái đáy: TRUNG TÍNH (cố ý không cam) — nền, hover đoạn, vạch ngăn 1×16, màu chữ. -->
        <SolidColorBrush x:Key="StatusBarBrush" Color="#F2EFEC" />
        <SolidColorBrush x:Key="StatusBarHoverBrush" Color="#E8E3DF" />
        <SolidColorBrush x:Key="StatusBarDividerBrush" Color="#DCD6D1" />
        <SolidColorBrush x:Key="StatusBarTextBrush" Color="#55504C" />

        <SolidColorBrush x:Key="LogBackgroundBrush" Color="#121212" />
        <SolidColorBrush x:Key="LogForegroundBrush" Color="#E8E8E8" />

        <!-- Chữ 4 nấc: tiêu đề/giá trị (primary) · nhãn nút, ô bảng (body) · mô tả, đầu cột (secondary) ·
             nhãn nhóm, gợi ý, placeholder (muted). -->
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2C2724" />
        <SolidColorBrush x:Key="TextBodyBrush" Color="#423C38" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7D756F" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#A8A09B" />
        <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

        <!-- ══════════ FONTS ══════════ -->
        <!-- Inter nhúng (phủ tiếng Việt, giống hệt Win/Ubuntu, render ỔN ĐỊNH). Mono cho log/list; Emoji cho icon chuỗi.
             (Đã thử composite "Segoe UI Variable Text, Segoe UI, avares…Inter" cho sắc hơn — nhưng trộn tên hệ thống
             với font nhúng qua URI làm render bị VỠ trên máy user → quay lại Inter nhúng đơn thuần.) -->
        <FontFamily x:Key="UiFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
        <FontFamily x:Key="EmojiFont">Segoe UI Emoji, Noto Color Emoji, sans-serif</FontFamily>

        <!-- ══════════ RESKIN FLUENTTHEME → look phẳng/gọn/pro như bản WPF ══════════ -->
        <!-- Accent CAM Shopee của app (tab đang chọn, viền focus, highlight…). Light1/Dark1 là cam sáng/đậm hơn. -->
        <Color x:Key="SystemAccentColor">#EE4D2D</Color>
        <Color x:Key="SystemAccentColorLight1">#FF6B4A</Color>
        <Color x:Key="SystemAccentColorDark1">#D8401F</Color>
        <!-- Bo góc chung cho control Fluent (TextBox/ComboBox/…) — 5px theo spec (nút · ô nhập · tab). -->
        <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
        <!-- Tab: Fluent mặc định font header RẤT to (~24) → thu về gọn (spec sub-tab 12.5). (Chỉ override
             FontSize — các key khác sai kiểu/không tồn tại sẽ làm vỡ template TabControl → view trống.) -->
        <sys:Double x:Key="TabItemHeaderFontSize">12.5</sys:Double>
        <!-- Cỡ chữ nội dung control Fluent (button/textbox/combo/list/datagrid…) — nhỏ lại để hợp màn Full HD
             (bản trước hơi to; máy dev 4K nhìn khác). Fluent mặc định 14. -->
        <sys:Double x:Key="ControlContentThemeFontSize">12.5</sys:Double>

        <!-- ══════════ FOCUS INPUT + LƯỚI — bỏ look "thô" khi click/focus ══════════ -->
        <!-- TextBox/ComboBox: Fluent mặc định focus = gạch chân accent 2px (0,0,0,2) trông thô & "nhảy".
             → viền accent 1px ĐỀU quanh ô. Hover chỉ đậm viền xám nhẹ (không nhảy sang accent chói). -->
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#EE4D2D" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#CFC8C2" />
        <!-- ComboBox focus: viền accent (khớp TextBox) cho cả focus chuột lẫn bàn phím. HighlightBackground
             (lớp trên) chỉ hiện khi focus bàn phím → đổi luôn brush của nó sang accent. -->
        <SolidColorBrush x:Key="ComboBoxBackgroundBorderBrushFocused" Color="#EE4D2D" />

        <!-- Tab trong module (TabControl): chữ tab CHƯA chọn — xám ấm RÕ (không nhợt như Fluent mặc định). -->
        <SolidColorBrush x:Key="TabUnselectedBrush" Color="#7D756F" />

        <!-- DataGrid: BỎ khung ô màu đen (SystemBaseHighColor) vẽ quanh ô khi click — thủ phạm "thô" chính. -->
        <SolidColorBrush x:Key="DataGridCellFocusVisualPrimaryBrush" Color="Transparent" />
        <SolidColorBrush x:Key="DataGridCellFocusVisualSecondaryBrush" Color="Transparent" />
        <!-- Dòng đang chọn: Fluent tô accent ~60% (hơi gắt) → nền accent NHẠT, chữ giữ đen dễ đọc. -->
        <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="#EE4D2D" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="#EE4D2D" />
        <SolidColorBrush x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" Color="#EE4D2D" />
        <SolidColorBrush x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" Color="#EE4D2D" />
        <sys:Double x:Key="DataGridRowSelectedBackgroundOpacity">0.14</sys:Double>
        <sys:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">0.20</sys:Double>
        <sys:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">0.11</sys:Double>
        <sys:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">0.17</sys:Double>

        <!-- Button PHẲNG bo góc (thay template Fluent) = NÚT PHỤ của spec: nền trắng, viền ấm #E2DDD8, cao 30,
             chữ 12 màu body, hover nền be nhạt. Các variant (primary/success/danger) đè màu ở phần class bên dưới. -->
        <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_bd">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_bd">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                <Setter Property="Opacity" Value="0.9" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.45" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- ══════════ TYPOGRAPHY (class) — theo bảng Typography của spec ══════════ -->
    <!-- h1 = tiêu đề màn 17/700 (nén chữ nhẹ) · h2 = tiêu đề thẻ 14.5/700 · body = chữ thường 12.5/400 ·
         caption = mô tả/phụ 12/400 màu chữ phụ. -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.2" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.emoji">
        <Setter Property="FontFamily" Value="{DynamicResource EmojiFont}" />
    </Style>

    <!-- ══════════ BUTTON variants (class) ══════════ -->
    <!-- .primary = NÚT CHÍNH của spec: nền CAM ĐẶC + chữ trắng (không còn outline), hover cam đậm hơn. -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- .success = outline xanh trên nền thẻ, hover nền xanh rất nhạt (spec không có nút chính màu xanh). -->
    <Style Selector="Button.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
    </Style>

    <!-- .danger = kiểu nút "Dừng tất cả" của spec: nền cam nhạt, viền cam nhạt, chữ cam đậm; hover đậm 1 nấc. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandTintBorderStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource BrandTintStrongBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource BrandTintStrongBrush}" />
    </Style>

    <!-- Thẻ bấm được (màn Welcome): bo 8 như thẻ, canh trái, hover nền cam rất nhạt + viền accent. -->
    <Style Selector="Button.card">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ══════════ Ô NHẬP (TextBox/ComboBox) — cao 30, nền trắng, viền ẤM, focus viền cam ══════════ -->
    <!-- Fluent tô ô nhập bằng bộ xám LẠNH riêng của nó (không đọc token của ta) → ép thẳng nền/viền của phần
         tử khung trong template cho cả 4 trạng thái. Phải khai TRƯỚC style .log bên dưới (ô log nền đen đè lại). -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="9,4" />
    </Style>
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputHoverBorderBrush}" />
    </Style>
    <Style Selector="ComboBox:disabled /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
    </Style>

    <!-- ══════════ TEXTBOX variants (class) ══════════ -->
    <!-- .mono = chữ mono, KHÔNG mặc định nhiều dòng: ô mono dùng cho cả path 1 dòng lẫn ô nhập nhiều dòng.
         Ô nhiều dòng tự đặt AcceptsReturn="True" tại chỗ. (Trước: style ép AcceptsReturn=True cho MỌI ô mono
         → ô path 1 dòng cũng bị coi là nhiều dòng nên chữ dính mép trên.) -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBox.log">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource LogForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource LogBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <!-- Giữ NỀN TỐI khi hover/focus: FluentTheme mặc định đổi nền TextBox sang sáng lúc pointerover/focus (đè
         nền tối của log) → chữ log sáng trở nên mờ trên nền sáng. Ép border-element giữ nền/chữ log. -->
    <Style Selector="TextBox.log /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource LogBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LogBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.log:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource LogBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LogBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource LogBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LogBackgroundBrush}" />
    </Style>
    <Style Selector="TextBox.log:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource LogForegroundBrush}" />
    </Style>
    <Style Selector="TextBox.log:focus">
        <Setter Property="Foreground" Value="{DynamicResource LogForegroundBrush}" />
    </Style>

    <!-- ══════════ CĂN GIỮA DỌC chữ trong ô nhập 1 DÒNG ══════════ -->
    <!-- Fluent để VerticalContentAlignment mặc định = Stretch → chữ 1 dòng dính mép TRÊN khi ô cao hơn nội
         dung (rõ nhất ở form dùng padding gọn). Căn giữa cho ô 1 dòng; ô NHIỀU DÒNG (AcceptsReturn) và LOG
         giữ chữ chảy từ TRÊN xuống. -->
    <Style Selector="TextBox">
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox[AcceptsReturn=True]">
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TextBox.log">
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- ══════════ CARD (class trên Border) — thẻ trắng bo 8, viền nhạt (spec: cards 8px / #EBE7E3) ══════════ -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- ══════════ PILL / BADGE trạng thái (Border.pill + biến thể màu) ══════════ -->
    <!-- Dùng: <Border Classes="pill success"><TextBlock Text="Xong" /></Border>. Mặc định = badge trung tính. -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Background" Value="{DynamicResource NeutralBadgeBgBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource NeutralBadgeBrush}" />
    </Style>
    <Style Selector="Border.pill.success">
        <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
    </Style>
    <Style Selector="Border.pill.success TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>
    <Style Selector="Border.pill.warning">
        <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
    </Style>
    <Style Selector="Border.pill.warning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    </Style>
    <Style Selector="Border.pill.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
    </Style>
    <Style Selector="Border.pill.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Border.pill.info">
        <Setter Property="Background" Value="{DynamicResource InfoBgBrush}" />
    </Style>
    <Style Selector="Border.pill.info TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
    </Style>
    <!-- .running = đang chạy (tint cam + chữ cam đậm), theo spec trạng thái "đang chạy". -->
    <Style Selector="Border.pill.running">
        <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
    </Style>
    <Style Selector="Border.pill.running TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" />
    </Style>

    <!-- ══════════ DATAGRID ══════════ -->
    <!-- Ô: canh giữa dọc + CỠ CHỮ 12.5 khớp toàn app (Fluent hard-code 15 → to/thô lệch với form),
         dòng cao thoáng hơn chút. -->
    <Style Selector="DataGridCell">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
    </Style>
    <!-- Header theo spec: dải nền #FBFAF9, chữ NHỎ 11px/700 màu phụ, giãn chữ 0.4 (chữ HOA do view tự đặt). -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource BorderLightestBrush}" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,0,0,0" />
    </Style>
    <Style Selector="DataGridColumnHeader TextBlock">
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>
    <!-- Bỏ đường kẻ dọc mảnh giữa các ô (gọn hơn); chỉ giữ kẻ ngang giữa dòng, màu kẻ RẤT nhạt (#F4F1EE). -->
    <Style Selector="DataGrid">
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderLightestBrush}" />
    </Style>
    <!-- Rê chuột lên dòng CHƯA chọn: nền hồng-ấm rất nhạt (Fluent mặc định là xám lạnh + opacity). Loại dòng
         đang chọn ra để không nuốt mất highlight accent lúc vừa chọn vừa rê. -->
    <Style Selector="DataGridRow:pointerover:not(:selected) /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource RowHoverBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- ══════════ COMBOBOX — focus viền accent mảnh (đồng bộ TextBox, thay ring thô) ══════════ -->
    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ══════════ TAB TRONG MODULE (TabControl/TabItem) — chữ đậm & rõ, hết "nhờ nhờ" ══════════ -->
    <!-- Mặc định Fluent: tab chưa chọn xám nhợt + weight thường → mờ. Giờ: chưa chọn = xám đậm-vừa
         SemiBold; đang chọn = accent Bold (kèm gạch chân accent sẵn có); hover = chữ đen rõ. -->
    <Style Selector="TabItem">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TabUnselectedBrush}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <!-- Tab đang chọn mà rê chuột: GIỮ accent (Fluent đổi màu lúc hover → mất nhận diện). -->
    <Style Selector="TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ══════════ DẢI TAB (ListBox.topnav) — tab module ngang trên nền TRẮNG ══════════ -->
    <!-- Item KHÔNG có padding riêng (Padding=0): toàn bộ padding 16/9/11 + gạch chỉ báo 3px nằm trong
         ItemTemplate (MainWindow.axaml) → gạch thụt đúng 12px mỗi bên, không cộng dồn padding của item. -->
    <Style Selector="ListBox.topnav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.topnav ListBoxItem">
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5,5,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Bottom" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.topnav ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TabHoverBrush}" />
        <Setter Property="CornerRadius" Value="5,5,0,0" />
    </Style>
    <!-- Tab đang chọn: KHÔNG tô chip — nhận diện bằng gạch cam 3px ở đáy (trong ItemTemplate) + chữ đậm màu. -->
    <Style Selector="ListBox.topnav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.topnav ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TabHoverBrush}" />
    </Style>

    <!-- Màu chữ tab: xám ấm (thường) → đen (hover) → đen (đang chọn). Đặt TRỰC TIẾP lên TextBlock con để
         thắng mọi setter mặc định của Fluent. Thứ tự khai báo: thường → hover → selected (Avalonia ưu tiên
         rule khai báo SAU khi cùng độ đặc hiệu, nên selected luôn thắng). -->
    <Style Selector="ListBox.topnav ListBoxItem TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.topnav ListBoxItem:pointerover TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBox.topnav ListBoxItem:selected TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- App-mark + tên app ở đầu dải tab: nút phẳng, nền trong suốt, hover be rất nhạt (template Button toàn cục). -->
    <Style Selector="Button.brand">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Button.brand:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource StatusBarBrush}" />
    </Style>
    <Style Selector="Button.brand:pressed /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource StatusBarHoverBrush}" />
    </Style>

    <!-- ══════════ RIBBON (dải nút kiểu Office) — nút LỚN: icon/glyph CAM trên, nhãn dưới ══════════ -->
    <!-- Nút ribbon dựng trên template Button toàn cục (Border#PART_bd): nền trong suốt, viền trong suốt;
         hover VÀ active đều là tint cam nhạt (nền #FFF3EF + viền #FBD6CA) theo spec. Class .ribbon để không
         đụng các nút thường. Rộng 78 (nhãn dài được giãn tới 112 rồi mới xuống dòng, tối đa ~2 dòng). -->
    <Style Selector="Button.ribbon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="2,6" />
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="MaxWidth" Value="112" />
        <Setter Property="MinHeight" Value="58" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <!-- Nhãn nút = chữ thân 11.5; glyph/icon = CAM cỡ 21 (khai SAU nhãn để thắng setter chung). -->
    <Style Selector="Button.ribbon TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBodyBrush}" />
    </Style>
    <Style Selector="Button.ribbon TextBlock.glyph">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.ribbon PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- Hover theo spec: nền cam RẤT nhạt + viền cam nhạt. -->
    <Style Selector="Button.ribbon:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandTintBorderBrush}" />
    </Style>
    <Style Selector="Button.ribbon:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
    </Style>
    <!-- Active (màn đang mở) = GIỮ NGUYÊN tint hover thường trực (nền #FFF3EF + viền #FBD6CA) + nhãn cam.
         Border#PART_bd nhận BorderThickness/BorderBrush từ control qua TemplateBinding nên đặt ở cấp control. -->
    <Style Selector="Button.ribbon.active">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandTintBorderBrush}" />
    </Style>
    <Style Selector="Button.ribbon.active /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
    </Style>
    <Style Selector="Button.ribbon.active:pointerover /template/ Border#PART_bd">
        <Setter Property="Background" Value="{DynamicResource BrandTintStrongBrush}" />
    </Style>
    <Style Selector="Button.ribbon.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- ══════════ THANH TRẠNG THÁI (đáy) — đoạn · vạch ngăn · chấm nhấp nháy ══════════ -->
    <!-- Đoạn (segment): cao hết thanh, padding ngang 12, hover sáng nhẹ; chữ 11.5 KHÔNG xuống dòng. -->
    <Style Selector="Border.statusSeg">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.statusSeg:pointerover">
        <Setter Property="Background" Value="{DynamicResource StatusBarHoverBrush}" />
    </Style>
    <Style Selector="Border.statusSeg StackPanel">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.statusSeg TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource StatusBarTextBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Dấu "·" ngăn các số trong CÙNG một đoạn (nhạt hơn chữ). -->
    <Style Selector="Border.statusSeg TextBlock.dot">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <!-- Vạch ngăn giữa 2 đoạn: 1×16. -->
    <Style Selector="Rectangle.statusSep">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Fill" Value="{DynamicResource StatusBarDividerBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Chấm trạng thái NHẤP NHÁY: opacity 1 → 0.3 → 1, chu kỳ 2.4s, lặp vô hạn. -->
    <Style Selector="Ellipse.statusDot">
        <Style.Animations>
            <Animation Duration="0:0:2.4" IterationCount="Infinite" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.3" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Toggle (checkbox) trên ribbon — ô vuông + nhãn THẲNG HÀNG. Trước đây ép MinHeight=58 để khớp chiều cao
         nút ribbon, NHƯNG template Fluent để ô vuông trong wrapper top-align cao ~32 → ô vuông nằm TRÊN, chữ
         (VerticalContentAlignment=Center) nằm GIỮA 58 → lệch. Nay để checkbox cao TỰ NHIÊN (~32): wrapper ô
         vuông lấp đúng chiều cao control nên ô vuông + chữ (đều center) THẲNG HÀNG. Chiều cao 58 để nhãn nhóm
         khớp các nút ribbon được đặt ở Border BỌC trong MainWindow.axaml (checkbox căn giữa trong Border đó). -->
    <Style Selector="CheckBox.ribbonToggle">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ══════════ LIST TÀI KHOẢN (dùng chung Workspace + Cấu hình BigSeller) — kiểu thẻ như module Đơn hàng ══════════ -->
    <!-- Item: bỏ nền accent-tint + khung focus mặc định Fluent; thẻ con acctCard hover xám nhẹ, CHỌN = nền thẻ + viền cam. -->
    <Style Selector="ListBox.acctList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.acctCard">
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Hover: nền hồng-ấm rất nhạt (SubtleBrush giờ gần trắng, đặt lên nền panel sẽ không thấy gì). -->
    <Style Selector="ListBox.acctList ListBoxItem:pointerover Border.acctCard">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem:selected Border.acctCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ListBox.acctList ListBoxItem:selected:pointerover Border.acctCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
</Styles>
