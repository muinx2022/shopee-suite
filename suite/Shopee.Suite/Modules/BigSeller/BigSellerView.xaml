<UserControl x:Class="Shopee.Suite.Modules.BigSeller.BigSellerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Suite.Controls"
             xmlns:b="clr-namespace:Shopee.Suite.Behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Name="Root">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header — 2 CỘT + chip dùng chung `headerStatusChip` (xem ghi chú ở style trong Themes/Theme.xaml):
             không chồng lớp nên status dài / cửa sổ hẹp không đè lên mô tả. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Cấu hình BigSeller" Style="{StaticResource h1}" />
                <TextBlock Text="Tài khoản BigSeller + workbook + shop (mỗi shop 1 sheet) + cookie dùng chung cho Scrape và Update Product."
                           Style="{StaticResource caption}" Margin="0,3,0,0" />
            </StackPanel>
            <ContentControl Grid.Column="1" Style="{StaticResource headerStatusChip}" Content="{Binding Status}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: account list -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource success}" MinWidth="78" Command="{Binding AddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconAdd}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Thêm" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource destructive}" MinWidth="72" Margin="8,0,0,0" Command="{Binding DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconDelete}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Xóa" />
                        </StackPanel>
                    </Button>
                    <!-- .primary (icon CAM) — khớp nút "Lưu" bên module Đơn hàng và 6/10 nút Lưu khác của suite. -->
                    <Button Style="{StaticResource primary}" Margin="8,0,0,0" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconSave}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Lưu" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Tự đăng nhập TẤT CẢ tk (headless, không hiện cửa sổ) rồi lưu cookie — dưới list. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Style="{StaticResource primary}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding LoginAllCommand}"
                            ToolTip="Tự đăng nhập HEADLESS mọi tk có đủ Email + Mật khẩu rồi lưu cookie cho client. Cần API key OpenAI (trang Cấu hình AI trên Hub) để giải captcha; tk đòi mã email sẽ được báo để đăng nhập tay 1 lần.">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconLogin}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Đăng nhập tất cả (headless)" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource danger}" Margin="0,6,0,0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"
                            Command="{Binding StopLoginCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconStop}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Dừng" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Nền xám nhạt để thẻ tk (nền trắng) nổi lên — khớp cột trái màn Workspace. -->
                <Border Style="{StaticResource card}" Background="{StaticResource SubtleBrush}" ClipToBounds="True">
                    <!-- Thẻ tk dùng chung `acctList`/`acctListItem` (Theme.xaml): nền trắng · chọn = nền cam nhạt. -->
                    <ListBox Style="{StaticResource acctList}" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- Chấm 6px + tên (cắt … khi dài) — chấm dùng chung acctDot với Workspace. -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Style="{StaticResource acctDot}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                    <!-- Dòng 2 thụt 14px cho thẳng tên: trạng thái cookie -->
                                    <TextBlock Text="{Binding CookieStatus}" FontSize="11" Margin="14,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- RIGHT: detail — 2 CỘT (trái: tài khoản/kết nối · phải: shops) để dùng chiều ngang,
                 tránh dồn dọc phải cuộn. Mỗi cột tự lo chiều cao (cột trái cuộn riêng nếu quá thấp;
                 lưới shop lấp đầy + cuộn nội bộ) → cửa sổ bình thường KHÔNG cần cuộn. -->
            <!-- CỘT PHẢI chia 2 hàng: khung CẤU HÌNH (trên) · khung LOG tách riêng (dưới) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource card}" Padding="18">
                    <Grid>
                        <TextBlock Text="Chọn hoặc thêm một tài khoản BigSeller." Style="{StaticResource caption}"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding HasSelection, Converter={StaticResource InvBoolToVis}}" />

                        <Grid DataContext="{Binding Selected}"
                              Visibility="{Binding DataContext.HasSelection, ElementName=Root,
                                           Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="1.1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <!-- Ô nhập gọn (như cấu hình Workspace) để form đỡ cao. -->
                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="Padding" Value="5,2" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                                <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource {x:Type PasswordBox}}">
                                    <Setter Property="Padding" Value="5,2" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </Grid.Resources>

                            <!-- ══════════ CỘT TRÁI: tài khoản + kết nối ══════════ -->
                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Tên hiển thị" Style="{StaticResource caption}" />
                                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Email BigSeller" Style="{StaticResource caption}" />
                                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Mật khẩu BigSeller (masked) — cho auto-login tự mint token mỗi máy.
                                         WPF không có PasswordChar trên TextBox → PasswordBox + PasswordBoxAssist. -->
                                    <TextBlock Text="Mật khẩu BigSeller (để tự đăng nhập)" Style="{StaticResource caption}" />
                                    <PasswordBox Margin="0,3,0,10" b:PasswordBoxAssist.BindPassword="True"
                                                 b:PasswordBoxAssist.BoundPassword="{Binding Password, Mode=TwoWay}" />

                                    <!-- Cả cụm Workbook (label + ô path + chọn file + Tải lại Sheet) CHỈ cho excel-mode; hub-mode
                                         ẨN sạch (kho dữ liệu ở Hub, không có khái niệm workbook/sheet) → chỉ còn DataSourceLabel. -->
                                    <TextBlock Text="Workbook (Excel)" Style="{StaticResource caption}"
                                               Visibility="{Binding CanPickWorkbook, Converter={StaticResource BoolToVis}}" />
                                    <Grid Margin="0,3,0,3"
                                          Visibility="{Binding CanPickWorkbook, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding WorkbookPath}" IsReadOnly="True"
                                                 Style="{StaticResource mono}" FontSize="11.5" Padding="5,2"
                                                 ToolTip="{Binding WorkbookPath}" />
                                        <Button Grid.Column="1" Width="40" Margin="8,0,0,0" Padding="0"
                                                ToolTip="Chọn file workbook"
                                                Command="{Binding DataContext.BrowseWorkbookCommand, ElementName=Root}">
                                            <c:PathIcon Data="{StaticResource IconFolder}" />
                                        </Button>
                                        <Button Grid.Column="2" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RefreshSheetsCommand, ElementName=Root}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconRefresh}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Sheet" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <!-- Excel-mode (chuyển tiếp): workbook giờ là FILE LOCAL, không còn sync qua Hub. -->
                                    <TextBlock Text="{Binding WorkbookSyncHint}"
                                               Visibility="{Binding CanPickWorkbook, Converter={StaticResource BoolToVis}}"
                                               FontSize="11.5" Margin="0,0,0,10" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding DataSourceLabel}"
                                               Visibility="{Binding IsHubData, Converter={StaticResource BoolToVis}}"
                                               FontSize="12.5" Margin="0,0,0,10" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <TextBlock Text="File cookie BigSeller (muc_token — dùng chung)" Style="{StaticResource caption}" />
                                    <Grid Margin="0,3,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CookieFile}" IsReadOnly="True"
                                                 Style="{StaticResource mono}" FontSize="11.5" Padding="5,2"
                                                 ToolTip="{Binding CookieFile}" />
                                        <Button Grid.Column="1" Width="40" Margin="8,0,0,0" Padding="0"
                                                ToolTip="Chọn file cookie"
                                                Command="{Binding DataContext.BrowseCookieCommand, ElementName=Root}">
                                            <c:PathIcon Data="{StaticResource IconFolder}" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding CookieStatus}" FontSize="12.5" Margin="0,0,0,10"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <!-- Proxy RIÊNG cho tk BigSeller (tuỳ chọn). Có key → mỗi tk 1 IP → chạy SONG SONG.
                                         Trống → đi IP máy, các tk BigSeller chạy LẦN LƯỢT. -->
                                    <TextBlock Text="Proxy riêng cho BigSeller (KiotProxy — tuỳ chọn)" Style="{StaticResource caption}" />
                                    <Grid Margin="0,3,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="96" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding KiotProxyKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource mono}" FontSize="11.5" Padding="5,2"
                                                 ToolTip="KiotProxy key riêng cho tk BigSeller này. Trống = đi IP máy (các tk chạy lần lượt)." />
                                        <TextBox Grid.Column="2" Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Vùng KiotProxy (random/north/central/south)." />
                                        <ComboBox Grid.Column="4" SelectedItem="{Binding ProxyType, Mode=TwoWay}">
                                            <sys:String>http</sys:String>
                                            <sys:String>socks5</sys:String>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{Binding ProxyStatus}" FontSize="11.5" Margin="0,0,0,10"
                                               Foreground="{StaticResource TextSecondaryBrush}" />

                                    <!-- 4 nút hành động trên MỘT hàng (WrapPanel: cột hẹp thì tự xuống dòng, không cắt nút).
                                         Chú thích cũ dưới từng hàng đã dồn vào ToolTip của nút để form đỡ cao. -->
                                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Button Style="{StaticResource primary}" MinWidth="132" Margin="0,0,8,6"
                                                Command="{Binding DataContext.LoginCommand, ElementName=Root}"
                                                ToolTip="Có proxy → đăng nhập qua proxy đó; không → IP máy. Cookie tự lưu.">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconLogin}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Mở Profile Bigseller" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource danger}" MinWidth="74" Margin="0,0,8,6"
                                                Command="{Binding DataContext.StopLoginCommand, ElementName=Root}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconClose}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Đóng" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource destructive}" MinWidth="132" Margin="0,0,8,6"
                                                Command="{Binding DataContext.CleanMediasCommand, ElementName=Root}"
                                                ToolTip="Dọn sạch TOÀN BỘ thư viện ảnh (Material Center) BigSeller của tk này — dùng khi kho ảnh đầy làm BigSeller chặn upload lúc update sản phẩm. Mở Brave riêng bằng cookie tk, dọn xong tự đóng.">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconDelete}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Xóa Medias" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource danger}" MinWidth="74" Margin="0,0,8,6"
                                                Visibility="{Binding DataContext.IsCleaningMedia, ElementName=Root,
                                                             Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.StopCleanMediasCommand, ElementName=Root}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconStop}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Dừng" />
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- ══════════ CỘT PHẢI: shops + cấu hình shop ══════════ -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header + thêm/xóa shop -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Shops (mỗi shop 1 sheet)" Style="{StaticResource h2}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource success}"
                                                Command="{Binding DataContext.AddShopCommand, ElementName=Root}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconAdd}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Thêm shop" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource destructive}" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveShopCommand, ElementName=Root}">
                                            <StackPanel Orientation="Horizontal">
                                                <c:PathIcon Data="{StaticResource IconDelete}" />
                                                <TextBlock Style="{StaticResource btnLabel}" Text="Xóa shop" />
                                            </StackPanel>
                                        </Button>
                                        <!-- (Đã bỏ nút "⇄ Sync shop → Đơn hàng": module Đơn hàng nay đăng nhập
                                             SUBACCOUNT rồi tự đọc danh sách shop từ /portal/shop, không cần tạo sẵn
                                             mỗi shop một dòng tài khoản nữa.) -->
                                    </StackPanel>
                                </Grid>

                                <!-- Bảng shop CHỈ XEM — lấp đầy chiều cao còn lại + cuộn nội bộ khi nhiều shop.
                                     Sửa mọi field ở panel "Cấu hình shop" bên dưới (tránh edit-transaction revert). -->
                                <Border Grid.Row="1" Style="{StaticResource card}" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding Shops}"
                                              SelectedItem="{Binding DataContext.SelectedShop, ElementName=Root}"
                                              BorderThickness="0" AutoGenerateColumns="False" IsReadOnly="True"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Tên shop" Binding="{Binding Name}" Width="1.4*" />
                                            <!-- (Đã BỎ cột "Sheet": kho dữ liệu nay nằm ở Hub, không còn dùng workbook Excel
                                                 nên cột này luôn rỗng — chỉ phí chỗ. Ô "Sheet dữ liệu" trong panel cấu hình
                                                 shop bên dưới vẫn giữ, chỉ hiện ở excel-mode.) -->
                                            <!-- 60 hiện ra "Ba", 78 vẫn cụt "Batc" (header còn chừa chỗ mũi tên sắp xếp) → 95 mới đủ. -->
                                            <DataGridTextColumn Header="Batch" Binding="{Binding OpenAiBatchSize}" Width="95" />
                                            <DataGridTextColumn Header="Crawl URL (Import)" Binding="{Binding BigSellerCrawlUrl}" Width="1.4*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!-- Ánh xạ field BigSeller ↔ cột Excel cho SHOP đang chọn -->
                                <Border Grid.Row="2" Style="{StaticResource card}" Padding="14" Margin="0,10,0,0"
                                        DataContext="{Binding DataContext.SelectedShop, ElementName=Root}"
                                        Visibility="{Binding DataContext.HasShopSelection, ElementName=Root,
                                                     Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <StackPanel.Resources>
                                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Setter Property="Padding" Value="5,2" />
                                                <Setter Property="FontSize" Value="11.5" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <TextBlock Text="Cấu hình shop đang chọn" Style="{StaticResource h2}" Margin="0,0,0,10" />

                                        <!-- Tên shop + Sheet + Batch -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Tên shop" Style="{StaticResource caption}" />
                                                <TextBox Margin="0,3,0,0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <!-- Sheet dữ liệu: chỉ excel-mode; hub-mode ẨN (sheet = ngăn nội bộ tự gán = shop.Id). -->
                                            <StackPanel Grid.Column="2"
                                                        Visibility="{Binding UsesHubData, Converter={StaticResource InvBoolToVis}}">
                                                <TextBlock Text="Sheet dữ liệu (↔ shop này)" Style="{StaticResource caption}" />
                                                <ComboBox Margin="0,3,0,0" HorizontalAlignment="Stretch"
                                                          ItemsSource="{Binding DataContext.Selected.SheetOptions, ElementName=Root}"
                                                          SelectedItem="{Binding ShopeeDataSheet, Mode=TwoWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Batch" Style="{StaticResource caption}" />
                                                <TextBox Width="64" Margin="0,3,0,0"
                                                         Text="{Binding OpenAiBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Crawl URL -->
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="Crawl URL (Import từ BigSeller)" Style="{StaticResource caption}" />
                                            <TextBox Margin="0,3,0,0" Text="{Binding BigSellerCrawlUrl, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource mono}" FontSize="11.5" Padding="5,2" />
                                        </StackPanel>

                                        <!-- Ánh xạ field ↔ cột Excel: chỉ excel-mode; hub-mode ẨN sạch (kho SP ở Hub, không có cột Excel). -->
                                        <TextBlock Text="Ánh xạ field ↔ cột Excel (nhập chữ cột: A, B, C…; trống = không dùng)"
                                                   Style="{StaticResource caption}" Margin="0,0,0,8"
                                                   Visibility="{Binding UsesHubData, Converter={StaticResource InvBoolToVis}}" />
                                        <UniformGrid Columns="6"
                                                     Visibility="{Binding UsesHubData, Converter={StaticResource InvBoolToVis}}">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Link" Style="{StaticResource caption}" />
                                                <TextBox Text="{Binding LinkColumnLetter, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Item ID" Style="{StaticResource caption}" />
                                                <TextBox Text="{Binding ItemIdColumnLetter, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Giá" Style="{StaticResource caption}" />
                                                <TextBox Text="{Binding PriceColumnLetter, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="SKU" Style="{StaticResource caption}" />
                                                <TextBox Text="{Binding SkuColumnLetter, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Tên gốc" Style="{StaticResource caption}" />
                                                <TextBox Text="{Binding ProductNameColumnLetter, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Tên đã sửa" Style="{StaticResource caption}" />
                                                <TextBox Text="{Binding RewrittenNameColumnLetter, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KHUNG LOG tách riêng — chạy hết chiều ngang cột phải, luôn hiển thị (kể cả khi chưa chọn tk) -->
                <Border Grid.Row="1" Style="{StaticResource card}" Padding="6" Margin="0,12,0,0" Height="110" ClipToBounds="True">
                    <Border CornerRadius="6" ClipToBounds="True" Background="{StaticResource LogBackgroundBrush}">
                        <TextBox Style="{StaticResource log}" FontSize="11.5" Padding="10,8"
                                 b:LogText.Source="{Binding LogLines}" />
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
