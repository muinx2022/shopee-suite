<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Shopee.Suite.Modules.Settings.UnifiedSettingsView">

    <!-- Màn "Cài đặt" DUY NHẤT của app: MỘT tiêu đề, MỘT hệ style (Theme của suite), các section xếp dọc.
         Trước đây màn này nhúng 2 view con qua ContentControl (SettingsView của suite + SettingsView của
         module Đơn hàng) → 2 tiêu đề "Cài đặt" chồng nhau + 3 bộ token màu/chữ trộn lẫn. Nay nội dung của cả
         hai đã INLINE vào đây và 2 view con đã bị xoá.
         DataContext = UnifiedSettingsViewModel ⇒ MỌI binding phải prefix `Suite.` (VM cài đặt suite) hoặc
         `Orders.` (VM cài đặt module Đơn hàng). `Orders` CÓ THỂ NULL (chế độ không có module đơn hàng) nên
         toàn bộ cây bind `Orders.*` phải nằm trong IsVisible="{Binding HasOrders}" và dùng binding CLASSIC
         (project suite để AvaloniaUseCompiledBindingsByDefault=false, view này KHÔNG đặt x:DataType).
         Cấu hình webhook thông báo KHÔNG còn ở client: webhook là cấu hình HUB-OWNED, đặt trên trang Cài đặt
         của Hub web (Hub gửi tin). Backend (SettingsRepository/OrderNotifyService) giữ nguyên. -->

    <UserControl.Styles>
        <!-- Nhãn section — MỘT kiểu duy nhất cho cả màn (chữ HOA do chỗ dùng tự viết hoa). Thay cho các dải
             Border nền xám cũ: nhãn phẳng, cùng lề với card nên mọi section thụt đều nhau. -->
        <Style Selector="TextBlock.sectionLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,22,0,10" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="28,22,28,24" RowDefinitions="Auto,*">

        <!-- ══════════ HEADER (DUY NHẤT một lần cho cả màn) ══════════ -->
        <!-- 2 cột (KHÔNG chồng lớp): cửa sổ hẹp thì mô tả tự xuống dòng chứ không chui xuống dưới chip. -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Cài đặt" Classes="h1" />
                <TextBlock Classes="caption" Margin="0,3,0,0"
                           Text="Chế độ ứng dụng · phiên bản &amp; cập nhật · hiệu năng · đồng bộ nhiều máy · module Đơn hàng. Cấu hình AI, prompt và webhook thông báo đặt trên Hub." />
            </StackPanel>
            <!-- Chip trạng thái của các thao tác cài đặt suite (lưu hiệu năng / tên máy / đẩy cấu hình). -->
            <Border Grid.Column="1" VerticalAlignment="Center"
                    Background="{DynamicResource SubtleBrush}" CornerRadius="4" Padding="14,6"
                    MaxWidth="420"
                    IsVisible="{Binding Suite.Status, Converter={StaticResource StringToBool}}">
                <TextBlock Text="{Binding Suite.Status}" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1180" HorizontalAlignment="Left">

                <!-- ══════════ SECTION 1: CHẾ ĐỘ ỨNG DỤNG (LUÔN hiện ở mọi chế độ) ══════════ -->
                <TextBlock Classes="sectionLabel" Text="CHẾ ĐỘ ỨNG DỤNG" />
                <Border Classes="card" Padding="18">
                    <StackPanel Spacing="10">
                        <!-- MaxWidth + HorizontalAlignment mặc định (Stretch) sẽ CANH GIỮA khối chữ trong thẻ rộng
                             → luôn kèm HorizontalAlignment="Left" cho các dòng chú thích có MaxWidth. -->
                        <TextBlock Classes="caption" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                                   Text="Chọn nhóm chức năng hiển thị cho gọn. Đổi chế độ sẽ khởi động lại app; cập nhật vẫn tải bản đầy đủ." />

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Chế độ:" VerticalAlignment="Center" Classes="caption" />
                            <ComboBox MinWidth="380" VerticalAlignment="Center"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                            <!-- Ẩn khi chế độ bị khoá bởi shortcut (mode truyền qua dòng lệnh): restart giữ nguyên tham số nên đổi mode ở đây vô nghĩa. -->
                            <Button Classes="primary"
                                    IsVisible="{Binding !ModeLockedByArg}"
                                    Command="{Binding SaveModeAndRestartCommand}"
                                    ToolTip.Tip="Lưu chế độ đã chọn rồi mở lại app để áp dụng">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{DynamicResource IconSave}" />
                                    <TextBlock Text="Lưu &amp; khởi động lại" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Chế độ đang khoá bởi shortcut: báo đổi ở đây không có tác dụng (chỉ để tạo shortcut khác). -->
                        <TextBlock Text="Chế độ đang khoá bởi shortcut (--mode). Chọn chế độ khác ở đây chỉ để tạo shortcut cho nó."
                                   Classes="caption" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"
                                   IsVisible="{Binding ModeLockedByArg}" />

                        <!-- Nút tạo shortcut desktop khoá một chế độ qua dòng lệnh: chạy song song với chế độ khác, dùng chung tài khoản/dữ liệu. -->
                        <StackPanel Spacing="4">
                            <Button HorizontalAlignment="Left"
                                    Command="{Binding CreateShortcutForModeCommand}"
                                    ToolTip.Tip="Tạo file .lnk ngoài desktop mở thẳng chế độ đang chọn (--mode)">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{DynamicResource IconAdd}" />
                                    <TextBlock Text="Tạo shortcut cho chế độ này" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Tạo shortcut ngoài desktop mở thẳng chế độ đang chọn (chạy song song với chế độ khác, dùng chung dữ liệu)."
                                       Classes="caption" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══════════ SECTION 2: PHIÊN BẢN & CẬP NHẬT (LUÔN hiện — dùng chung mọi chế độ) ══════════ -->
                <!-- KHÔNG gate theo chế độ: chế độ Shopee ẩn nhóm Workspace nhưng vẫn phải cập nhật được. -->
                <TextBlock Classes="sectionLabel" Text="PHIÊN BẢN &amp; CẬP NHẬT" />
                <Border Classes="card" Padding="18" HorizontalAlignment="Left" MaxWidth="560">
                    <StackPanel>
                        <TextBlock Text="{Binding Suite.AppVersionText}" FontSize="14.5" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" />

                        <TextBlock Text="{Binding Suite.UpdateStatus}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   IsVisible="{Binding Suite.UpdateStatus, Converter={StaticResource StringToBool}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button MinWidth="160"
                                    IsVisible="{Binding Suite.UpdateSupported}"
                                    Command="{Binding Suite.CheckUpdateCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{DynamicResource IconUpgrade}" />
                                    <TextBlock Text="Kiểm tra bản mới" />
                                </StackPanel>
                            </Button>
                            <Button Classes="success" MinWidth="200" Margin="10,0,0,0"
                                    IsVisible="{Binding Suite.UpdateReady}"
                                    Command="{Binding Suite.ApplyUpdateCommand}"
                                    ToolTip.Tip="Đóng app + áp dụng bản đã tải + mở lại. Làm khi KHÔNG có job đang chạy.">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{DynamicResource IconUpgrade}" />
                                    <TextBlock Text="Cập nhật &amp; khởi động lại" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,10,0,0"
                                   IsVisible="{Binding Suite.UpdateNotSupported}"
                                   Text="ℹ Tự cập nhật chỉ hoạt động khi app được cài qua bộ cài Velopack (Setup.exe trên Windows / AppImage trên Linux). Bản chạy trực tiếp từ thư mục build không tự cập nhật." />
                    </StackPanel>
                </Border>

                <!-- ══════════ SECTION 3: HIỆU NĂNG (ẩn ở chế độ Shopee) ══════════ -->
                <TextBlock Classes="sectionLabel" Text="HIỆU NĂNG"
                           IsVisible="{Binding ShowsWorkspaceSettings}" />
                <Grid ColumnDefinitions="1.25*,14,1*" IsVisible="{Binding ShowsWorkspaceSettings}">

                    <!-- Cột trái: ngân sách tài nguyên → trần cửa sổ Brave -->
                    <Border Grid.Column="0" Classes="card" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Tài nguyên cho phép app dùng → tính số cửa sổ Brave tối đa" Classes="h2" Margin="0,0,0,12" />
                            <Grid ColumnDefinitions="Auto,Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Số nhân CPU dùng" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,8" />
                                <TextBox Grid.Row="0" Grid.Column="1" Width="80" Margin="0,0,8,8"
                                         Text="{Binding Suite.UsableCpu}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,0,8" Classes="caption">
                                    <Run Text="/ máy có " /><Run Text="{Binding Suite.CpuCoresMax, Mode=OneWay}" /><Run Text=" nhân   (mỗi cửa sổ ~1 nhân)" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="RAM dùng (GB)" Classes="caption" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Width="80" Margin="0,0,8,0"
                                         Text="{Binding Suite.UsableRamGb}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Classes="caption">
                                    <Run Text="/ máy có " /><Run Text="{Binding Suite.RamGbMax, Mode=OneWay}" /><Run Text=" GB   (mỗi cửa sổ ~2GB)" />
                                </TextBlock>
                            </Grid>

                            <Border Background="{DynamicResource SubtleBrush}" CornerRadius="4" Padding="12,8" Margin="0,14,0,0">
                                <TextBlock Text="{Binding Suite.ComputedMaxInfo}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,12,0,0"
                                       Text="Đặt THẤP hơn để chừa CPU/RAM cho việc khác (máy mượt); CAO hơn = cào nhanh hơn nhưng máy dễ ì. Mặc định = nửa số nhân + toàn bộ RAM. Có hiệu lực đầy đủ từ lượt chạy kế tiếp." />
                            <Button Classes="primary" MinWidth="110"
                                    HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding Suite.SavePerformanceCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{DynamicResource IconSave}" />
                                    <TextBlock Text="Lưu" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Cột phải: máy của bạn -->
                    <Border Grid.Column="2" Classes="card" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Máy của bạn" Classes="h2" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Suite.MachineInfo}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════════ SECTION 4: ĐỒNG BỘ NHIỀU MÁY (ẩn ở chế độ Shopee) ══════════ -->
                <TextBlock Classes="sectionLabel" Text="ĐỒNG BỘ NHIỀU MÁY"
                           IsVisible="{Binding ShowsWorkspaceSettings}" />
                <Grid ColumnDefinitions="1*,14,1.35*" IsVisible="{Binding ShowsWorkspaceSettings}">

                    <Border Grid.Column="0" Classes="card" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Máy này" Classes="h2" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding Suite.MachineLabel}" FontSize="14.5" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}" TextWrapping="Wrap" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Tên này nhận diện máy trên bảng trạng thái và khi giành/khoá việc giữa các máy." />

                            <TextBlock Text="Tên hiển thị (đặt tuỳ ý, vd: Máy của ABC):" Classes="caption" Margin="0,12,0,4" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0" Text="{Binding Suite.MachineDisplayName}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding Suite.SaveMachineNameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{DynamicResource IconSave}" />
                                        <TextBlock Text="Lưu tên" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- App là CLIENT-only (Hub đã tách sang server web riêng) → luôn hiện phần Kết nối. -->
                    <Border Grid.Column="2" Classes="card" Padding="18" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Kết nối tới Hub (server đồng bộ + điều phối)" Classes="h2" Margin="0,0,0,6" />
                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Text="Dán URL + API token của Hub (server đồng bộ chạy riêng qua Cloudflare Tunnel). Khi bật, các máy chia sẻ cấu hình + tránh làm trùng tài khoản. Để trống = chạy độc lập như cũ." />

                            <CheckBox Content="Bật đồng bộ với Hub" IsChecked="{Binding Suite.HubEnabled}" Margin="0,0,0,12" />

                            <TextBlock Text="URL Hub" Classes="caption" />
                            <TextBox Margin="0,3,0,10" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                     Text="{Binding Suite.HubBaseUrl}" />

                            <TextBlock Text="API token" Classes="caption" />
                            <TextBox Margin="0,3,0,0" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                     Text="{Binding Suite.HubApiToken}" />

                            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="Bấm &quot;Kiểm tra&quot; để thử URL/token trước; &quot;Kết nối ngay&quot; lưu + áp dụng liền (khỏi khởi động lại)." />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Classes="primary" MinWidth="150"
                                        Command="{Binding Suite.ConnectToggleCommand}"
                                        ToolTip.Tip="Chưa nối → kết nối; đang nối → ngắt. Áp dụng ngay, không cần khởi động lại.">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{DynamicResource IconSync}" />
                                        <TextBlock Text="{Binding Suite.ConnectToggleText}" />
                                    </StackPanel>
                                </Button>
                                <!-- "Kiểm tra" = ping thử, không có mục riêng trong bảng ánh xạ → để CHỮ THUẦN
                                     (luật nút: icon chỉ thêm khi cần thiết) thay vì bịa icon mới. -->
                                <Button Content="Kiểm tra" Margin="10,0,0,0" Command="{Binding Suite.TestHubClientCommand}"
                                        ToolTip.Tip="Ping thử Hub bằng URL/token đang nhập để biết có nối được không." />
                                <Button Margin="10,0,0,0" Command="{Binding Suite.SaveHubClientCommand}"
                                        ToolTip.Tip="Lưu cấu hình, áp dụng ở lần khởi động app kế tiếp.">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{DynamicResource IconSave}" />
                                        <TextBlock Text="Chỉ lưu" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="{Binding Suite.HubClientStatus}" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"
                                       IsVisible="{Binding Suite.HubClientStatus, Converter={StaticResource StringToBool}}" />

                            <Button HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Command="{Binding Suite.PushConfigToHubCommand}"
                                    ToolTip.Tip="Đẩy accounts/bigseller/cookie hiện tại lên Hub làm nguồn cho các máy khác kéo về.">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <PathIcon Data="{DynamicResource IconExport}" />
                                    <TextBlock Text="Đẩy cấu hình lên Hub" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════════ SECTION 5: ĐƠN HÀNG (ẩn khi module không chạy — Orders có thể NULL) ══════════ -->
                <TextBlock Classes="sectionLabel" Text="ĐƠN HÀNG"
                           IsVisible="{Binding HasOrders}" />
                <Grid ColumnDefinitions="*,14,*" IsVisible="{Binding HasOrders}">

                    <!-- ── Cột trái: tự động hoá + trình duyệt ── -->
                    <StackPanel Grid.Column="0" Spacing="14">

                        <Border Classes="card" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Tự động hóa" Classes="h2" />

                                <!-- Thư mục lưu hóa đơn -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Thư mục lưu hóa đơn" Classes="caption" />
                                    <Grid ColumnDefinitions="*,8,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Orders.InvoiceFolder}"
                                                   FontFamily="{DynamicResource MonoFont}" FontSize="12.5"
                                                   Foreground="{DynamicResource TextBodyBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Command="{Binding Orders.ChooseInvoiceFolderCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="7">
                                                <PathIcon Data="{DynamicResource IconFolder}" />
                                                <TextBlock Text="Chọn…" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Phiếu giao (PDF) khi Xử lý đơn được lưu vào đây; link &quot;In phiếu&quot; ở màn Đơn hàng cũng mở từ đây. Bỏ trống ⇒ dùng thư mục mặc định cạnh dữ liệu app." />
                                </StackPanel>

                                <!-- Chu kỳ theo dõi đơn -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Chu kỳ theo dõi đơn (phút)" Classes="caption" />
                                    <NumericUpDown Value="{Binding Orders.OrderIntervalMinutes}" Minimum="1" Maximum="1440" Increment="1"
                                                   FormatString="0" Width="180" HorizontalAlignment="Left" />
                                    <TextBlock Classes="caption" TextWrapping="Wrap"
                                               Text="Số phút giữa các lần tự đọc số &quot;Chờ Lấy Hàng&quot;. Áp dụng cho các phiên mở SAU khi lưu." />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="primary" Command="{Binding Orders.SaveIntervalCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="{DynamicResource IconSave}" />
                                            <TextBlock Text="Lưu" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Orders.SavedMessage}" Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding Orders.SavedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="18">
                            <StackPanel Spacing="14">
                                <TextBlock Text="Trình duyệt" Classes="h2" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Trình duyệt mở phiên" Classes="caption" />
                                    <ComboBox Width="260" HorizontalAlignment="Left"
                                              ItemsSource="{Binding Orders.BrowserOptions}"
                                              SelectedItem="{Binding Orders.SelectedBrowser}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Trình duyệt THỰC sẽ dùng -->
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="{Binding Orders.DetectedBrowserText, StringFormat='Đang dùng: {0}'}" />

                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Chrome thường ít bị Shopee bắt captcha hơn Brave (Brave bật sẵn chống-fingerprint dễ bị nhận diện). Mỗi tài khoản vẫn mở hồ sơ riêng, không đụng trình duyệt cá nhân của bạn. Áp cho các phiên mở SAU khi lưu." />

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Classes="primary" Command="{Binding Orders.SaveBrowserCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <PathIcon Data="{DynamicResource IconSave}" />
                                            <TextBlock Text="Lưu" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding Orders.BrowserSavedMessage}" Foreground="{DynamicResource SuccessBrush}"
                                               VerticalAlignment="Center" TextWrapping="Wrap"
                                               IsVisible="{Binding Orders.BrowserSavedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── Cột phải: đồng bộ Google Sheet ── -->
                    <Border Grid.Column="2" Classes="card" Padding="18" VerticalAlignment="Top">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Đồng bộ Google Sheet" Classes="h2" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="Link Web App Google Sheet" Classes="caption" />
                                <TextBox Text="{Binding Orders.GsheetWebAppUrl}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         Watermark="https://script.google.com/macros/s/…/exec" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Tab ghi vào" Classes="caption" />
                                <TextBox Text="{Binding Orders.GsheetTabName}" Width="260" HorizontalAlignment="Left"
                                         Watermark="để trống = tự động Tháng MM-yyyy" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Sau mỗi lần Sync đơn hàng, app tự ghi đơn + link phiếu vào Google Sheet. Để trống = tự ghi vào tab &quot;Tháng MM-yyyy&quot; theo tháng hiện tại (script tự tạo tab); điền tên = ghi cố định vào tab đó. Cách lấy link: docs/gsheet-huong-dan-cai-dat.md" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="Lưu ý: cấu hình này DÙNG CHUNG toàn hệ thống qua Hub — bấm Lưu là đẩy lên Hub và các máy khác nhận theo trong ~1 phút. Ngược lại, sửa trên Hub thì máy này cũng tự nhận (không cần khởi động lại)." />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="Link Google Sheet 2 (tuỳ chọn)" Classes="caption" />
                                <TextBox Text="{Binding Orders.GsheetSheet2}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                         Watermark="https://docs.google.com/spreadsheets/d/…" />
                                <TextBlock Classes="caption" TextWrapping="Wrap"
                                           Text="File phụ nhận thêm cột A–E (mã đơn, mã vận đơn, ảnh vận đơn, đơn trả hàng) — để trống = không ghi file phụ. Dán link bảng tính hoặc ID; KHÁC ô Web App ở trên." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Classes="primary" Command="{Binding Orders.SaveGsheetUrlCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <PathIcon Data="{DynamicResource IconSave}" />
                                        <TextBlock Text="Lưu" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding Orders.GsheetSavedMessage}" Foreground="{DynamicResource SuccessBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           IsVisible="{Binding Orders.GsheetSavedMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
