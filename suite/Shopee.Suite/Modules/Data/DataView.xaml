<UserControl x:Class="Shopee.Suite.Modules.Data.DataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Suite.Controls"
             xmlns:b="clr-namespace:Shopee.Suite.Behaviors"
             x:Name="Root">
    <!-- BẪY (đợt 3 gặp ở WorkspaceView, đợt 6 quét sạch toàn repo): MỌI `<Run Text="{Binding …}">` phải ghi
         rõ Mode=OneWay — Run.TextProperty khai BindsTwoWayByDefault nên bind vào property CHỈ ĐỌC sẽ NÉM
         lúc dựng cây (chết app), build KHÔNG bắt được. -->
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ════ Header + hint (như hub) ════ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Dữ liệu sản phẩm" Style="{StaticResource h1}" />
            <TextBlock Text="Trang quản lý dữ liệu TOÀN BỘ acc/shop — thêm/sửa/xoá/đánh dấu bán. Nhập Excel: dùng web Hub."
                       Style="{StaticResource caption}" Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ════ Banner suy giảm (chưa cấu hình Hub / Postgres chưa sẵn sàng) ════ -->
        <Border Grid.Row="1" Style="{StaticResource card}" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVis}}"
                Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBrush}">
            <TextBlock Text="{Binding DegradedMessage}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- ════ Bar lọc ════ -->
        <Border Grid.Row="2" Style="{StaticResource card}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0">
                    <!-- Combo tài khoản: ẩn ở tab Dữ liệu Workspace (fixed-acct — khoá vào acc đang xem). -->
                    <ComboBox Width="200" Margin="0,0,8,6" VerticalAlignment="Center" IsEnabled="{Binding CanInteract}"
                              Visibility="{Binding ShowAccountFilter, Converter={StaticResource BoolToVis}}"
                              ItemsSource="{Binding AccountOptions}" SelectedItem="{Binding SelectedAccountOption}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="200" Margin="0,0,8,6" VerticalAlignment="Center" IsEnabled="{Binding CanInteract}"
                              ItemsSource="{Binding ShopOptions}" SelectedItem="{Binding SelectedShopOption}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="150" Margin="0,0,8,6" VerticalAlignment="Center" b:WatermarkAssist.Watermark="SKU…"
                             Text="{Binding SkuFilter, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding FilterCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBox Width="110" Margin="0,0,8,6" VerticalAlignment="Center" b:WatermarkAssist.Watermark="Giá từ"
                             Text="{Binding PriceMinText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" />
                    <TextBox Width="110" Margin="0,0,8,6" VerticalAlignment="Center" b:WatermarkAssist.Watermark="Giá đến"
                             Text="{Binding PriceMaxText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanInteract}" />
                    <CheckBox Content="Đã bán" Margin="0,0,8,6" VerticalAlignment="Center"
                              IsChecked="{Binding SoldOnly}" IsEnabled="{Binding CanInteract}" />
                    <CheckBox Content="SKU trùng trong shop" Margin="0,0,8,6" VerticalAlignment="Center"
                              IsChecked="{Binding DupSkuOnly}" IsEnabled="{Binding CanInteract}" />
                    <Button Style="{StaticResource primary}" Margin="0,0,8,6" Command="{Binding FilterCommand}"
                            IsEnabled="{Binding CanInteract}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconFilter}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Lọc" />
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,8,6" Command="{Binding ClearFilterCommand}" IsEnabled="{Binding CanInteract}"
                            ToolTip="Xoá mọi điều kiện lọc, hiện lại toàn bộ">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconClose}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Xóa lọc" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding AddRowCommand}" IsEnabled="{Binding CanInteract}"
                            ToolTip="Thêm 1 dòng dữ liệu vào 1 shop (chọn trong form)">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconAdd}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Thêm dòng" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding RefreshCommand}" IsEnabled="{Binding CanInteract}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconRefresh}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Tải lại" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════ Bar HÀNH ĐỘNG (căn phải) — phân trang chuyển XUỐNG DƯỚI lưới để 2 cụm khỏi che nhau khi hẹp ════ -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,10">
            <Button Command="{Binding SelectAllPageCommand}"
                    IsEnabled="{Binding CanInteract}" ToolTip="Chọn tất cả dòng của trang này">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{StaticResource IconCheckAll}" />
                    <TextBlock Style="{StaticResource btnLabel}" Text="Chọn tất cả" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Button Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" IsEnabled="{Binding CanInteract}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconUncheck}" />
                        <TextBlock Style="{StaticResource btnLabel}"><Run Text="Bỏ chọn (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource success}" Margin="8,0,0,0" Command="{Binding MarkSoldCommand}" IsEnabled="{Binding CanInteract}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconCheck}" />
                        <TextBlock Style="{StaticResource btnLabel}"><Run Text="Đã bán (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding ResetSoldCommand}" IsEnabled="{Binding CanInteract}"
                        ToolTip="Xoá lịch sử đã bán của các dòng chọn (sold về 0)">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconRefresh}" />
                        <TextBlock Style="{StaticResource btnLabel}"><Run Text="Đã bán = 0 (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding RegenSkusCommand}" IsEnabled="{Binding CanInteract}"
                        ToolTip="Cấp SKU B##### mới cho các dòng chọn (vá đuôi tên nếu có tên-sửa)">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconSparkle}" />
                        <TextBlock Style="{StaticResource btnLabel}"><Run Text="Sinh SKU mới (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource destructive}" Margin="8,0,0,0" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanInteract}">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconDelete}" />
                        <TextBlock Style="{StaticResource btnLabel}"><Run Text="Xóa nhiều (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- ════ Lưới dữ liệu ════ -->
        <!-- Nền dòng theo trạng thái đã-bán: style `dataRow` (Theme.xaml) bind DataGridRow.Background vào
             DataRowItem.RowBackground; ô đã Transparent sẵn ở style nền tảng nên màu dòng lộ ra. -->
        <Border Grid.Row="4" Style="{StaticResource card}" ClipToBounds="True">
            <DataGrid x:Name="RowsGrid" ItemsSource="{Binding Rows}" BorderThickness="0" IsReadOnly="True"
                      RowStyle="{StaticResource dataRow}"
                      AutoGenerateColumns="False" CanUserSortColumns="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40" CellStyle="{StaticResource cellTight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="44" CellStyle="{StaticResource cellTight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="28" Height="26" MinHeight="26" Padding="0" HorizontalAlignment="Center" ToolTip="Sửa dòng"
                                        Command="{Binding DataContext.EditRowCommand,
                                                  RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}">
                                    <c:PathIcon Data="{StaticResource IconEdit}" Width="12" Height="12" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Acc" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource cell}" Text="{Binding AccLabel}" ToolTip="{Binding AccLabel}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Shop" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource cell}" Text="{Binding ShopLabel}" ToolTip="{Binding ShopLabel}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Dòng" Binding="{Binding RowNo}" Width="55" />
                    <DataGridTemplateColumn Header="Link" Width="1.4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource cell}" Text="{Binding Link}" ToolTip="{Binding Link}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Giá bán" Binding="{Binding PriceSale}" Width="90" />
                    <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="110" />
                    <DataGridTextColumn Header="ItemId" Binding="{Binding ItemId}" Width="120" />
                    <DataGridTemplateColumn Header="Tên gốc" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource cell}" Text="{Binding NameOriginal}" ToolTip="{Binding NameOriginal}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tên đã sửa" Width="1.6*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource cell}" Text="{Binding NameRewritten}" ToolTip="{Binding NameRewritten}" /></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Đã bán" Binding="{Binding SoldCount}" Width="70" />
                    <DataGridTextColumn Header="Sửa lúc" Binding="{Binding UpdatedLocal}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ════ Bar PHÂN TRANG (căn phải, dưới lưới) ════ -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,10,0,0">
            <Button Content="«" Width="38" Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanFirstPrev}" ToolTip="Trang đầu" />
            <Button Content="‹" Width="38" Margin="6,0,0,0" Command="{Binding PrevPageCommand}" IsEnabled="{Binding CanFirstPrev}" />
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="12,0,12,0"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            <Button Content="›" Width="38" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextLast}" />
            <Button Content="»" Width="38" Margin="6,0,0,0" Command="{Binding LastPageCommand}" IsEnabled="{Binding CanNextLast}" ToolTip="Trang cuối" />
            <TextBlock Text="dòng/trang" VerticalAlignment="Center" Margin="14,0,6,0"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            <ComboBox Width="80" VerticalAlignment="Center" ItemsSource="{Binding PageSizes}"
                      SelectedItem="{Binding PageSize}" IsEnabled="{Binding CanInteract}" />
        </StackPanel>

        <!-- ════ Status cuối ════ -->
        <TextBlock Grid.Row="6" Margin="2,10,0,0" Text="{Binding Status}" FontSize="12.5"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding Status, Converter={StaticResource StringToVis}}" />
    </Grid>
</UserControl>
