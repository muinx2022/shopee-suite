<UserControl x:Class="Shopee.Suite.Modules.Search.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Suite.Controls"
             xmlns:b="clr-namespace:Shopee.Suite.Behaviors"
             x:Name="Root">
    <!-- Port từ Modules/Search/SearchView.axaml (bản Avalonia). Quy ước dịch xem bảng đầu Themes/Theme.xaml:
         `Classes="x"` → `Style="{StaticResource x}"`; `IsVisible` → `Visibility` + converter; `Spacing` →
         Margin (style `btnLabel`); `ToolTip.Tip` → `ToolTip`; `$parent[X]` → RelativeSource FindAncestor.
         BẪY đã gặp ở đợt 3: MỌI `<Run Text="{Binding …}">` phải ghi rõ Mode=OneWay — Run.TextProperty khai
         BindsTwoWayByDefault nên bind vào property CHỈ ĐỌC sẽ NÉM lúc dựng cây (chết app), build không bắt. -->
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Shopee Search" Style="{StaticResource h1}" />
                <TextBlock Text="Nạp file link CATEGORY (.txt mỗi dòng 1 link) → tick chọn → mỗi link 1 tab/account: mọi sub-category · lọc Nơi Bán · Bán chạy."
                           Style="{StaticResource caption}" Margin="0,3,0,0" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{StaticResource SubtleBrush}" CornerRadius="4" Padding="14,6">
                <TextBlock Text="{Binding Status}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
            </Border>
        </Grid>

        <TabControl Grid.Row="1">
            <!-- ════════════ TAB 1: TÌM KIẾM ════════════ -->
            <TabItem Header="Tìm kiếm">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Danh sách link: bản Avalonia để CỐ ĐỊNH 190 → cửa sổ thấp thì WPF ép hàng `*`
                             (dải tab kết quả theo link) về 0 TRƯỚC, mà ô log 150 vẫn đòi đủ chỗ nên cả hai
                             bị đẩy TRÀN khỏi đáy cửa sổ. Đổi sang SAO CÓ KẸP: cửa sổ cao thì vẫn đúng 190
                             như cũ (MaxHeight), chật thì nhường dần xuống 150 (DataGrid tự có thanh cuộn).
                             Đã đo thật (cửa sổ rộng 1500, số px VẬT LÝ ở DPI 125%):
                                 cao 1400 → lưới link 178 (y hệt bản cũ), ô log nằm trong cửa sổ
                                 cao 1175 → lưới 128 (cũ: 178), ô log nằm trong cửa sổ
                                 cao 1000 → lưới 128, ô log 802..975 NẰM TRONG (bản cũ 852..1025 = TRÀN)
                                 cao  860 → vẫn tràn: riêng thẻ nhập ~155 + ô log 150 đã quá khổ; muốn đỡ
                                            thì phải cho cả tab cuộn dọc — ngoài phạm vi đợt 6. -->
                        <RowDefinition Height="*" MinHeight="150" MaxHeight="190" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                    </Grid.RowDefinitions>

                    <!-- Card: input + run -->
                    <Border Grid.Row="0" Style="{StaticResource card}" Padding="18,16" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Dòng 1: File link category — riêng 1 dòng, ô đường dẫn rộng hết chiều ngang -->
                            <TextBlock Text="File link category (.txt: mỗi dòng 1 link)" Style="{StaticResource caption}" />
                            <Grid Margin="0,4,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding FilesDisplay}" IsReadOnly="True" FontSize="11.5"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ChooseFilesCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconFolder}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Chọn file" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource destructive}" Width="38" Padding="0"
                                        Margin="6,0,0,0" Command="{Binding ClearFilesCommand}" ToolTip="Bỏ file">
                                    <c:PathIcon Data="{StaticResource IconDelete}" />
                                </Button>
                            </Grid>

                            <!-- Dòng 2: Bộ lọc Khu vực (Nơi Bán) + Lane + nút chạy -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Khu vực (Nơi Bán)" Style="{StaticResource caption}" />
                                    <TextBox Width="200" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding Region}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <TextBlock Text="Lane" Style="{StaticResource caption}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Width="48" Text="{Binding LaneCount}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Width="36" Padding="0" Command="{Binding ReloadCommand}" ToolTip="Nạp lại danh sách link">
                                        <c:PathIcon Data="{StaticResource IconRefresh}" />
                                    </Button>
                                    <Button Style="{StaticResource success}" MinWidth="110" Margin="8,0,0,0"
                                            Command="{Binding RunCommand}"
                                            ToolTip="Chạy mới — mỗi link tạo lượt mới từ danh mục đầu.">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconPlay}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Tìm kiếm" />
                                        </StackPanel>
                                    </Button>
                                    <Button MinWidth="96" Margin="8,0,0,0" Command="{Binding ResumeCommand}"
                                            ToolTip="Resume các link chưa kết thúc ĐÚNG từ danh mục/trang đã dừng (giữ SP đã cào).">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconResume}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Tiếp tục" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource danger}" MinWidth="80" Margin="8,0,0,0" Command="{Binding StopCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconStop}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Dừng" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách link nạp được — tick chọn link để search -->
                    <DockPanel Grid.Row="1" Margin="0,0,0,10">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource caption}" VerticalAlignment="Center">
                                <Run Text="Link đã nạp — tick chọn để search (" /><Run Text="{Binding LoadedLinks.Count, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Command="{Binding SelectAllLinksCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconCheckAll}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Chọn tất cả" />
                                    </StackPanel>
                                </Button>
                                <Button Margin="8,0,0,0" Command="{Binding UnselectAllLinksCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconUncheck}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Bỏ chọn" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource destructive}" Margin="8,0,0,0"
                                        Command="{Binding RemoveSelectedLinksCommand}"
                                        ToolTip="Xóa các link đang tick khỏi danh sách.">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconDelete}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Xóa link đã chọn" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Style="{StaticResource card}" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding LoadedLinks}" BorderThickness="0"
                                      AutoGenerateColumns="False" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Chọn" Width="48" CellStyle="{StaticResource cellTight}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Dòng" Binding="{Binding Row}" Width="50" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Link" Binding="{Binding Link}" Width="2.4*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="0.9*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Tiến độ (resume)" Binding="{Binding Progress}" Width="1.6*" IsReadOnly="True" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DockPanel>

                    <!-- Mỗi link = 1 tab: tài khoản + trạng thái + sản phẩm crawl được. Nhiều link → dải tab
                         GIỮ 1 HÀNG + cuộn ngang (không wrap xuống nhiều hàng làm vỡ/đẩy form). -->
                    <TabControl Grid.Row="2" ItemsSource="{Binding LinkTabs}" SelectedItem="{Binding SelectedLinkTab}">
                        <TabControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </TabControl.ItemsPanel>
                        <TabControl.Template>
                            <ControlTemplate TargetType="{x:Type TabControl}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                    <!-- ContentSource="SelectedContent" tự nối Content + ContentTemplate (thay 2
                                         TemplateBinding rời của bản Avalonia); tên PART_SelectedContentHost là bắt
                                         buộc để TabControl tìm ra host. -->
                                    <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" />
                                    <!-- Command nằm trên VM của MÀN (không phải trên tab) → leo tổ tiên UserControl.
                                         KHÔNG dùng ElementName=Root: bên trong DataTemplate namescope khác. -->
                                    <Button ToolTip="Đóng tab (dừng link nếu đang chạy)" Margin="6,0,0,0" Padding="3,0"
                                            MinWidth="0" Height="20" MinHeight="20"
                                            Command="{Binding DataContext.CloseLinkTabCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}">
                                        <c:PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,10,0,0">
                                    <TextBlock DockPanel.Dock="Top" Margin="2,0,0,8" FontSize="12.5"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                                        <Run Text="Tài khoản: " /><Run Text="{Binding Account, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   ·   " /><Run Text="{Binding Status, Mode=OneWay}" /><Run Text="   ·   " /><Run Text="{Binding Link, Mode=OneWay}" />
                                    </TextBlock>
                                    <Border Style="{StaticResource card}" ClipToBounds="True">
                                        <DataGrid ItemsSource="{Binding Products}" BorderThickness="0" IsReadOnly="True"
                                                  AutoGenerateColumns="False" CanUserSortColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="2.4*" />
                                                <DataGridTextColumn Header="Giá" Binding="{Binding Price}" Width="90" />
                                                <DataGridTextColumn Header="Bán/tháng" Binding="{Binding MonthlySold}" Width="90" />
                                                <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="70" />
                                                <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="1.2*" />
                                                <DataGridTextColumn Header="Khu vực" Binding="{Binding ShopLocation}" Width="1*" />
                                                <DataGridTextColumn Header="Shop" Binding="{Binding ShopName}" Width="1*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                </DockPanel>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <!-- Errored accounts -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0"
                                Visibility="{Binding ErroredAccounts.Count, Converter={StaticResource CountToVis}}">
                        <TextBlock Margin="0,0,0,5" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}">
                            <Run Text="⚠ Tài khoản lỗi (" /><Run Text="{Binding ErroredAccounts.Count, Mode=OneWay}" /><Run Text=") — engine tự đổi tk" />
                        </TextBlock>
                        <Border Style="{StaticResource card}" MaxHeight="90" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding ErroredAccounts}" BorderThickness="0" IsReadOnly="True"
                                      AutoGenerateColumns="False" CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="1.4*" />
                                    <DataGridTextColumn Header="Lỗi" Binding="{Binding Reason}" Width="*" />
                                    <DataGridTextColumn Header="Lúc" Binding="{Binding Time}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <!-- Log -->
                    <Border Grid.Row="4" CornerRadius="6" ClipToBounds="True" Margin="0,12,0,0"
                            Background="{StaticResource LogBackgroundBrush}">
                        <TextBox Style="{StaticResource log}" b:LogText.Source="{Binding LogLines}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════ TAB 2: XUẤT EXCEL ════════════ -->
            <TabItem Header="Xuất Excel">
                <Grid Margin="0,12,0,0" VerticalAlignment="Top">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource card}" Padding="18,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Bộ lọc (áp khi xuất Excel)" Style="{StaticResource h2}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Giá ≥" Style="{StaticResource caption}" />
                                        <TextBox Width="120" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding MinPrice}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Bán/tháng từ" Style="{StaticResource caption}" />
                                        <TextBox Width="90" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding MinSoldFrom}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="đến" Style="{StaticResource caption}" />
                                        <TextBox Width="90" Margin="0,4,0,0" HorizontalAlignment="Left" Text="{Binding MinSoldTo}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="Danh mục" Style="{StaticResource caption}" />
                                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Categories}"
                                                  SelectedItem="{Binding CategoryFilter}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource card}" Padding="18,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Thư mục lưu file Excel" Style="{StaticResource h2}" Margin="0,0,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource mono}" Text="{Binding OutputDir}"
                                             FontSize="11.5" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseOutputDirCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconFolder}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Chọn thư mục" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Width="76" Margin="8,0,0,0" Command="{Binding OpenOutputCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconOpenExternal}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Mở" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource card}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Xuất Excel" Style="{StaticResource h2}" Margin="0,0,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource primary}" MinWidth="190" Command="{Binding ExportAllCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconExport}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Xuất tất cả (đã quét)" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource destructive}" MinWidth="190" Margin="8,0,0,0"
                                            Command="{Binding ClearDataCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconDelete}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Xóa dữ liệu đã quét" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Mỗi link sau khi crawl xong tự xuất 1 file Excel ở thư mục con “categories”."
                                           Style="{StaticResource caption}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ════════════ TAB 3: DANH MỤC (AI) ════════════ -->
            <TabItem Header="Danh mục (AI)">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource card}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource caption}" Margin="0,0,0,4">
                                <Run Text="File danh mục lá Shopee (.docx) — provider AI đang dùng: " /><Run Text="{Binding AiProviderName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource mono}" Text="{Binding CategoryDocxPath}"
                                         FontSize="11.5" VerticalContentAlignment="Center" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding BrowseDocxCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconFolder}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Chọn file danh mục" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource primary}" MinWidth="210" Command="{Binding UpdateCategoriesAiCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconSparkle}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Cập nhật danh mục CSDL (AI)" />
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="220" Margin="8,0,0,0" Command="{Binding UpdateCategoriesExcelCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconSparkle}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Gán danh mục cho file Excel (AI)" />
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="96" Margin="8,0,0,0" Command="{Binding RefreshCategoryGridCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconRefresh}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Làm mới" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource danger}" MinWidth="80" Margin="8,0,0,0" Command="{Binding StopAiCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconStop}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Dừng" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="{Binding AiProgress}" VerticalAlignment="Center" Margin="14,0,0,0"
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource h2}" Margin="0,0,0,8">
                                <Run Text="Danh mục trong CSDL (" /><Run Text="{Binding CategoryRows.Count, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <Border Style="{StaticResource card}" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding CategoryRows}" SelectedItem="{Binding SelectedCategoryRow}"
                                          BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="Số SP" Binding="{Binding ProductCount}" Width="64" />
                                        <DataGridTextColumn Header="Số shop" Binding="{Binding ShopCount}" Width="68" />
                                        <DataGridTextColumn Header="Lần cuối" Binding="{Binding LastSeen}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource h2}" Margin="0,0,0,8">
                                <Run Text="Sản phẩm: " /><Run Text="{Binding SelectedCategoryName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Border Style="{StaticResource card}" ClipToBounds="True">
                                <DataGrid ItemsSource="{Binding CategoryProducts}" BorderThickness="0" IsReadOnly="True"
                                          AutoGenerateColumns="False" CanUserSortColumns="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="2.4*" />
                                        <DataGridTextColumn Header="Giá" Binding="{Binding Price}" Width="90" />
                                        <DataGridTextColumn Header="Bán/tháng" Binding="{Binding MonthlySold}" Width="90" />
                                        <DataGridTextColumn Header="Shop" Binding="{Binding ShopName}" Width="1.1*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
