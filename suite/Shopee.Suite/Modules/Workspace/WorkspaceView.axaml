<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="using:Shopee.Suite.Behaviors"
    xmlns:data="using:Shopee.Suite.Modules.Data"
    x:Class="Shopee.Suite.Modules.Workspace.WorkspaceView"
    x:Name="Root">
    <!-- Style CỤC BỘ màn Workspace (KHÔNG đụng Themes/Theme.axaml): dải đầu màn, list tk, sub-tab, bảng shop.
         Màu lấy từ token của theme qua DynamicResource; chỉ hard-code vài hex mà theme chưa có token. -->
    <UserControl.Styles>

        <!-- ══════════ Dải đầu màn + dải gợi ý ══════════ -->
        <!-- Header: nền phụ ấm, viền đáy mảnh, padding theo spec 18/14/18/12. -->
        <Style Selector="Border.pageHead">
            <Setter Property="Background" Value="{DynamicResource SubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,14,18,12" />
        </Style>
        <!-- Hint: dải 1 dòng nền gần-trắng ngả hồng, viền đáy rất nhạt. -->
        <Style Selector="Border.hintStrip">
            <Setter Property="Background" Value="#FFFDFC" />
            <Setter Property="BorderBrush" Value="#F0ECE8" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,8" />
        </Style>

        <!-- ══════════ Cột trái: list tài khoản (292px) ══════════ -->
        <!-- Dùng CHUNG class "acctList" của theme cho phần reset ListBoxItem (bỏ nền/khung focus Fluent), nhưng
             THẺ dùng class riêng "wsAcct" để không dính style thẻ của màn Cấu hình BigSeller. -->
        <Style Selector="Border.wsAcct">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.wsAcctList ListBoxItem:pointerover Border.wsAcct">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <!-- CHỌN = nền cam nhạt + viền cam nhạt (spec), khác hẳn thẻ thường nền trắng. -->
        <Style Selector="ListBox.wsAcctList ListBoxItem:selected Border.wsAcct">
            <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandTintBorderStrongBrush}" />
        </Style>
        <Style Selector="ListBox.wsAcctList ListBoxItem:selected:pointerover Border.wsAcct">
            <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BrandTintBorderStrongBrush}" />
        </Style>
        <!-- Chấm tròn 6px đầu thẻ: xám khi thường, CAM khi thẻ đang chọn. -->
        <Style Selector="Ellipse.acctDot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource IdleDotBrush}" />
        </Style>
        <Style Selector="ListBox.wsAcctList ListBoxItem:selected Ellipse.acctDot">
            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Dòng 2 của thẻ: trạng thái cookie (xanh = có, vàng = chưa đăng nhập). -->
        <Style Selector="TextBlock.acctCookie">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessDotBrush}" />
        </Style>
        <Style Selector="TextBlock.acctCookie.warn">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>

        <!-- ══════════ Sub-tabs — SEGMENTED CONTROL kiểu Windows 11 ══════════ -->
        <!-- Cả cụm tab nằm trong MỘT khay bo tròn nền xám ấm; ô ĐANG CHỌN nổi lên nền TRẮNG + viền mảnh + chữ
             đen đậm, ô còn lại chìm chữ xám. Bên phải khay là tên tài khoản BigSeller đang chọn (mờ).
             KHUÔN DÙNG CHUNG với màn tương đương của module Đơn hàng (orders/Views/AccountsView.axaml,
             TabControl.detailTabs) — sửa một bên thì sửa cả bên kia cho 2 màn không lệch nhau.
             Phải THAY TEMPLATE vì khay nền bao quanh dải tab không dựng được bằng setter rời. -->
        <Style Selector="TabControl.subtabs">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <!-- Các ô nằm NGANG (mặc định Fluent là WrapPanel). -->
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <DockPanel>
                        <!-- Lề PHẢI 210 (không phải 18 như bên Đơn hàng): nút "Dừng việc shop này" của màn này
                             là lớp ĐÈ ở góc trên-phải (nằm ngoài TabControl) → chừa chỗ cho nó khỏi che tên tk. -->
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="18,12,210,10">
                            <!-- KHAY segmented: nền xám ấm #F2EFEC (tông khay của bộ design — suite đặt tên token
                                 này là NeutralBadgeBg), bo 10, đệm 4 để ô đang chọn nổi hẳn lên trên nền khay. -->
                            <Border Grid.Column="0" Background="{DynamicResource NeutralBadgeBgBrush}"
                                    CornerRadius="10" Padding="4">
                                <ItemsPresenter Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Border>
                            <!-- Tên tài khoản BigSeller đang chọn — view truyền vào qua Tag. -->
                            <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="12,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <!-- Padding vùng nội dung giữ như trước (spec 18/14/18/18) — nội dung các tab dựa vào nó. -->
                        <ContentPresenter Name="PART_SelectedContentHost" Margin="18,4,18,18"
                                          Content="{TemplateBinding SelectedContent}"
                                          ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.subtabs TabItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Ô thường: chìm vào khay. Ô ĐANG CHỌN: nổi lên nền trắng + viền mảnh (không tô cam — theo luật mới
             màu chỉ để đánh dấu, không tô mảng lớn). -->
        <Style Selector="TabControl.subtabs TabItem /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#66FFFFFF" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        </Style>
        <!-- Segmented control KHÔNG dùng gạch chỉ báo — ẩn hẳn pipe mặc định của Fluent. -->
        <Style Selector="TabControl.subtabs TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- Huy hiệu SỐ trong ô segmented: ô đang chọn → nền cam nhạt chữ cam; ô chìm → nền xám chữ xám.
             CHỈ gắn ở tab có số THẬT để hiện (màn này: số shop của tài khoản đang chọn). -->
        <Style Selector="Border.tabBadge">
            <Setter Property="Background" Value="{DynamicResource BorderLightestBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.tabBadge TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:selected Border.tabBadge">
            <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
        </Style>
        <Style Selector="TabControl.subtabs TabItem:selected Border.tabBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrandTextBrush}" />
        </Style>

        <!-- ══════════ BẢNG SHOP ══════════ -->
        <!-- Header CHỮ HOA nhỏ, màu phụ, giãn chữ 0.4; chữ HOA do view tự viết hoa trong Header. -->
        <Style Selector="DataGrid.shopGrid DataGridColumnHeader">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="34" />
            <!-- Stretch để chữ HOA của 4 cột op canh giữa được (mặc định co theo nội dung thì canh trái). -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="DataGrid.shopGrid DataGridColumnHeader TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.4" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- Ô KHÔNG padding: cột SHOP tự thụt 14px bằng Margin, 4 cột op canh giữa tuyệt đối. -->
        <Style Selector="DataGrid.shopGrid DataGridCell">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- Nút op trên dòng shop — 40×30, 3 trạng thái: icon xám (chờ) · ICON + VIỀN CAM (đang chạy) ·
             huy hiệu ✓ (xong). Theo LUẬT NÚT MỚI: nền LUÔN trắng, không nút nào tô nền — "đang chạy" nhận ra
             bằng icon cam + viền cam. -->
        <Style Selector="Button.wsAction">
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style Selector="Button.wsAction PathIcon">
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
        </Style>
        <!-- Hover: chỉ đổi VIỀN sang cam nhạt, nền giữ trắng (theme mặc định tô nền be → mất nét sạch của bảng). -->
        <Style Selector="Button.wsAction:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandTintBorderStrongBrush}" />
        </Style>
        <Style Selector="Button.wsAction:pointerover /template/ Border#PART_bd">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        </Style>
        <!-- ĐANG CHẠY = ICON CAM + VIỀN CAM, nền vẫn TRẮNG (bấm lại để dừng — tooltip nói rõ). -->
        <Style Selector="Button.wsAction.running">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.wsAction.running PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.wsAction.running:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.wsAction.running:pointerover /template/ Border#PART_bd">
            <Setter Property="Background" Value="{DynamicResource BrandTintBrush}" />
        </Style>
        <Style Selector="Button.wsAction.running:pressed /template/ Border#PART_bd">
            <Setter Property="Background" Value="{DynamicResource BrandTintStrongBrush}" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <!-- Badge ✓ xanh 14px đè góc trên-phải nút = op đã xong (Hub ghi nhận). -->
        <Style Selector="Border.doneBadge">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SuccessDotBrush}" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,-5,-5,0" />
            <Setter Property="ZIndex" Value="1" />
        </Style>

        <!-- ══════════ CẤU HÌNH CHẠY — nhãn 11.5 màu phụ NẰM TRÊN ô cao 30 ══════════ -->
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Tô nền dòng process (tab Scrape) theo tài khoản. Cell phải trong suốt để lộ màu nền dòng. -->
        <Style Selector="DataGrid.instances DataGridRow">
            <Setter Property="Background" Value="{Binding AccountBrush}" />
        </Style>
        <Style Selector="DataGrid.instances DataGridCell">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- Màn chạy TRÀN VIỀN (không margin ngoài): dải header + dải hint kéo hết bề ngang như bộ design; phần
         thân dưới chia 2 cột — trái list tk (nền phụ), phải sub-tab + nội dung. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- ════ Row 0: Page header ════ -->
        <Border Grid.Row="0" Classes="pageHead">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="BigSeller Workspace" Classes="h1" />
                    <TextBlock Text="Gộp Cấu hình + Scrape + Update. Chọn 1 tài khoản để xem các shop, tình trạng scrape, rồi Scrape · Import · Update · Tên SP ngay trên từng shop."
                               Classes="caption" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontSize="11.5" Margin="0,0,4,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Classes="primary" Command="{Binding ReloadCommand}"
                            ToolTip.Tip="Đọc lại danh sách tài khoản · shop · tiến độ từ kho.">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{DynamicResource IconRefresh}" />
                            <TextBlock Text="Tải lại" />
                        </StackPanel>
                    </Button>
                    <!-- Không có việc nào chạy → nút mờ, không bấm được (CanExecute = AnyRunning). -->
                    <Button Classes="danger" Command="{Binding StopAllCommand}"
                            ToolTip.Tip="Dừng toàn bộ scrape + update đang chạy. (Dừng riêng 1 tk: bấm nút viền cam trên shop đang chạy.)">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{DynamicResource IconStop}" />
                            <TextBlock Text="Dừng tất cả" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════ Row 1: Hint strip — MỘT dòng, tràn thì cắt bằng … ════ -->
        <Border Grid.Row="1" Classes="hintStrip">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Grid.Column="0" Text="ℹ" Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           Text="Bấm 1 tài khoản → chạy theo từng shop (4 nút: scrape · import · update · tên SP). Nút icon cam + viền cam = đang chạy, bấm lại để dừng · dấu ✓ góc nút = đã xong." />
            </Grid>
        </Border>

        <!-- ════ Row 2: Banner việc dở — chỉ hiện khi HasResumePending. LIỆT KÊ từng việc (op · tk · shop ·
             tiến độ · giờ chạy cuối) + 2 nút Tiếp tục / Hủy. Mỗi việc 1 dòng (cột phải chừa cho nút
             "Giao máy khác" sau này). ════ -->
        <Border Grid.Row="2" Classes="card" Padding="14,10" Margin="18,12,18,12"
                Background="{DynamicResource BrandTintBrush}"
                BorderBrush="{DynamicResource BrandTintBorderStrongBrush}"
                IsVisible="{Binding HasResumePending}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <!-- Tiêu đề: đếm số việc -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <PathIcon Data="{DynamicResource IconPause}" Width="16" Height="16"
                                  Foreground="{DynamicResource BrandTextBrush}" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="Có" />
                            <Run Text="{Binding ResumePendingCount}" FontWeight="Bold" />
                            <Run Text="việc đang dở dang từ lần trước:" />
                        </TextBlock>
                    </StackPanel>
                    <!-- Danh sách chi tiết (cuộn nếu nhiều) -->
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="26,6,0,0">
                        <ItemsControl ItemsSource="{Binding ResumeRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                            <!-- Nhãn op (pill) -->
                                            <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="3"
                                                    Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OpLabel}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <!-- tk · shop · tiến độ -->
                                            <TextBlock VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                                <Run Text="{Binding AccountName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ShopName}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding ProgressText}" />
                                            </TextBlock>
                                            <!-- Giờ chạy cuối (ẩn khi rỗng) -->
                                            <TextBlock Text="{Binding LastRunText}" VerticalAlignment="Center" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       IsVisible="{Binding LastRunText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <!-- Grid.Column=1 chừa trống: Task 2 sẽ chèn nút "Giao máy khác" mỗi dòng. -->
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Top" Margin="12,0,0,0">
                    <Button Classes="success"
                            Command="{Binding ResumePendingWorkCommand}" ToolTip.Tip="{Binding ResumeTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{DynamicResource IconResume}" />
                            <TextBlock Text="Tiếp tục tất cả" />
                        </StackPanel>
                    </Button>
                    <Button Classes="danger"
                            Command="{Binding DiscardPendingWorkCommand}"
                            ToolTip.Tip="Bỏ các việc dở khỏi hàng chờ (không tự chạy tiếp nữa).">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Data="{DynamicResource IconClose}" />
                            <TextBlock Text="Hủy bỏ" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════ Row 3: trái = list tk (292px, luôn hiện) · phải = sub-tab + nội dung ════ -->
        <Grid Grid.Row="3" ColumnDefinitions="292,*">

            <!-- ─── LEFT: account list ─── -->
            <Border Grid.Column="0" Background="{DynamicResource SubtleBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="14,12,14,8">
                        <TextBlock Text="TÀI KHOẢN BIGSELLER" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.7"
                                   VerticalAlignment="Bottom" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock FontSize="11" VerticalAlignment="Bottom" Foreground="{DynamicResource TextMutedBrush}">
                            <Run Text="{Binding Accounts.Count}" /><Run Text=" tài khoản" />
                        </TextBlock>
                    </StackPanel>
                    <ListBox Classes="acctList wsAcctList" ItemsSource="{Binding Accounts}"
                             SelectedItem="{Binding SelectedAccount}"
                             BorderThickness="0" Background="Transparent" Padding="8,0,8,12">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="wsAcct">
                                    <StackPanel>
                                        <!-- Chấm 6px + email (cắt … khi dài) -->
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Ellipse Grid.Column="0" Classes="acctDot" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <!-- Dòng 2 thụt 14px: cookie · tiến độ scrape -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,5,0,0">
                                            <TextBlock Classes="acctCookie" Classes.warn="{Binding !HasCookie}"
                                                       Text="{Binding CookieShort}" />
                                            <TextBlock Text="·" FontSize="11" Foreground="{DynamicResource IdleDotBrush}" />
                                            <TextBlock Text="{Binding ScrapeSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ─── RIGHT: sub-tabs + nút "Dừng việc shop này" đè góc trên-phải, thẳng hàng dải tab ─── -->
            <Grid Grid.Column="1">
            <!-- Tag = tên tài khoản BigSeller đang chọn → template segmented control hiện ở mép phải khay tab. -->
            <TabControl Classes="subtabs" Tag="{Binding SelectedAccount.DisplayName}">

                <!-- ══════════ TAB 1: Shop & cấu hình ══════════ -->
                <TabItem>
                    <!-- Huy hiệu = SỐ SHOP của tài khoản đang chọn (số THẬT; ẩn khi chưa chọn acc / acc 0 shop).
                         Các tab còn lại KHÔNG gắn huy hiệu vì không có số thật để hiện. -->
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Shop &amp; cấu hình" VerticalAlignment="Center" />
                            <Border Classes="tabBadge"
                                    IsVisible="{Binding SelectedAccount.Shops.Count, Converter={StaticResource CountToBool}, FallbackValue=False}">
                                <TextBlock Text="{Binding SelectedAccount.Shops.Count}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <TextBlock Text="Chọn 1 tài khoản BigSeller bên trái để xem shop + thao tác."
                                   Classes="caption" VerticalAlignment="Top"
                                   IsVisible="{Binding !HasSelection}" />

                        <Border Classes="card" Padding="16,14,16,16"
                                DataContext="{Binding SelectedAccount}"
                                IsVisible="{Binding #Root.DataContext.HasSelection}">
                            <DockPanel>
                                <!-- Header tk + đăng nhập (Top) -->
                                <StackPanel DockPanel.Dock="Top">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Classes="h2" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- Pill cookie: xanh khi đã có, vàng khi chưa đăng nhập -->
                                            <Border Classes="pill" Classes.success="{Binding HasCookie}"
                                                    Classes.warning="{Binding !HasCookie}">
                                                <TextBlock Text="{Binding CookieStatus}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary" Command="{Binding #Root.DataContext.Scrape.ShowStatsCommand}"
                                                    ToolTip.Tip="Tiến độ theo sheet · nhả tay tk bị kẹt · xoá tiến độ scrape">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <PathIcon Data="{DynamicResource IconChart}" />
                                                    <TextBlock Text="Thống kê" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="primary"
                                                    Command="{Binding #Root.DataContext.GoToBigSellerConfigCommand}"
                                                    ToolTip.Tip="Mở tab BigSeller để đăng nhập lấy cookie / sửa workbook · cookie · shop · proxy của tài khoản này.">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <PathIcon Data="{DynamicResource IconOpenExternal}" />
                                                    <TextBlock Text="Đăng nhập / cấu hình" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Hàng Workbook chỉ excel-mode; hub-mode ẨN (kho SP ở Hub, không dùng workbook Excel). -->
                                    <StackPanel Margin="0,12,0,0" IsVisible="{Binding !UsesHubData}">
                                        <TextBlock Text="Workbook" Classes="fieldLabel" />
                                        <TextBox Classes="mono" FontSize="12" IsReadOnly="True"
                                                 Text="{Binding WorkbookPath, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Text="Mỗi shop = 1 sheet — bấm nút trên dòng shop để chạy đúng shop đó."
                                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,12" TextWrapping="NoWrap" />
                                </StackPanel>

                                <!-- Vùng dưới header: lưới shop LẤP ĐẦY (cuộn nội bộ khi nhiều shop), cụm cấu hình
                                     ở đáy giữ chiều cao tự nhiên → không sinh thanh cuộn riêng. -->
                                <Grid RowDefinitions="*,Auto">

                                    <!-- Lưới SHOP pipeline — lấp đầy chiều cao còn lại. KHÔNG có cột Tiến độ:
                                         trạng thái từng op nằm ngay trên nút (nền cam = đang chạy, ✓ = xong). -->
                                    <Border Grid.Row="0" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
                                        <DataGrid x:Name="ShopGrid" Classes="shopGrid" ItemsSource="{Binding Shops}" IsReadOnly="True"
                                                  BorderThickness="0" SelectionChanged="ShopGrid_SelectionChanged" RowHeight="44"
                                                  AutoGenerateColumns="False" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*" MinWidth="150">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="SHOP" Margin="14,0,0,0" />
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" Margin="14,0,0,0" VerticalAlignment="Center"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!-- Mỗi op 1 cột, 1 nút toggle 40×30: bấm chạy ↔ bấm lại dừng. -->
                                                <DataGridTemplateColumn Width="68">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="SCRAPE" HorizontalAlignment="Center" />
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid HorizontalAlignment="Center">
                                                                <Button Classes="wsAction" Classes.running="{Binding ScrapeRunning}"
                                                                        ToolTip.Tip="{Binding ScrapeToggleTip}"
                                                                        IsEnabled="{Binding ScrapeToggleEnabled}"
                                                                        Command="{Binding $parent[UserControl].DataContext.ScrapeToggleCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{DynamicResource IconPlay}" />
                                                                </Button>
                                                                <Border Classes="doneBadge" ToolTip.Tip="Scrape đã xong (Hub)"
                                                                        IsVisible="{Binding ScrapeDone}">
                                                                    <TextBlock Text="✓" Foreground="White" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="68">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="IMPORT" HorizontalAlignment="Center" />
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid HorizontalAlignment="Center">
                                                                <Button Classes="wsAction" Classes.running="{Binding ImportRunning}"
                                                                        ToolTip.Tip="{Binding ImportToggleTip}"
                                                                        IsEnabled="{Binding ImportToggleEnabled}"
                                                                        Command="{Binding $parent[UserControl].DataContext.ImportToggleCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{DynamicResource IconImport}" />
                                                                    <!-- Chuột phải → xoá tiến độ resume import (2 bước xác nhận, khỏi dialog).
                                                                         ContextMenu kế thừa DataContext = shop → bind thẳng command trên WorkspaceShopViewModel. -->
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Xoá tiến độ import (chạy lại từ đầu)…">
                                                                                <MenuItem.Icon>
                                                                                    <PathIcon Data="{DynamicResource IconRefresh}" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                                <MenuItem Header="Xác nhận: xoá tiến độ import"
                                                                                          Command="{Binding ResetImportProgressCommand}" />
                                                                            </MenuItem>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <Border Classes="doneBadge" ToolTip.Tip="Import đã xong (Hub)"
                                                                        IsVisible="{Binding ImportDone}">
                                                                    <TextBlock Text="✓" Foreground="White" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="68">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="UPDATE" HorizontalAlignment="Center" />
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid HorizontalAlignment="Center">
                                                                <Button Classes="wsAction" Classes.running="{Binding UpdateRunning}"
                                                                        ToolTip.Tip="{Binding UpdateToggleTip}"
                                                                        IsEnabled="{Binding UpdateToggleEnabled}"
                                                                        Command="{Binding $parent[UserControl].DataContext.UpdateToggleCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{DynamicResource IconEdit}" />
                                                                    <!-- Chuột phải → xoá tiến độ resume update (2 bước xác nhận, khỏi dialog). -->
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="Xoá tiến độ update (chạy lại từ đầu)…">
                                                                                <MenuItem.Icon>
                                                                                    <PathIcon Data="{DynamicResource IconRefresh}" Width="14" Height="14" />
                                                                                </MenuItem.Icon>
                                                                                <MenuItem Header="Xác nhận: xoá tiến độ update"
                                                                                          Command="{Binding ResetUpdateProgressCommand}" />
                                                                            </MenuItem>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <Border Classes="doneBadge" ToolTip.Tip="Update đã xong (Hub)"
                                                                        IsVisible="{Binding UpdateDone}">
                                                                    <TextBlock Text="✓" Foreground="White" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Width="68">
                                                    <DataGridTemplateColumn.Header>
                                                        <TextBlock Text="TÊN SP" HorizontalAlignment="Center" />
                                                    </DataGridTemplateColumn.Header>
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Grid HorizontalAlignment="Center">
                                                                <Button Classes="wsAction" Classes.running="{Binding RewriteRunning}"
                                                                        ToolTip.Tip="{Binding RewriteToggleTip}"
                                                                        IsEnabled="{Binding RewriteToggleEnabled}"
                                                                        Command="{Binding $parent[UserControl].DataContext.RewriteToggleCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{DynamicResource IconSparkle}" />
                                                                </Button>
                                                                <Border Classes="doneBadge" ToolTip.Tip="Tên SP đã xong (Hub)"
                                                                        IsVisible="{Binding RewriteDone}">
                                                                    <TextBlock Text="✓" Foreground="White" FontSize="9"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>

                                    <!-- Cấu hình chạy — chiều cao tự nhiên, KHÔNG cuộn. Ô số dàn theo bề ngang
                                         (WrapPanel: hết chỗ thì xuống dòng), ô đường dẫn chia đôi bề ngang. -->
                                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                                        <TextBlock FontSize="11" FontWeight="Bold" LetterSpacing="0.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="CẤU HÌNH CHẠY" />
                                            <Run Text="· tài khoản này · máy này" FontWeight="Normal"
                                                 Foreground="{DynamicResource TextMutedBrush}" />
                                        </TextBlock>
                                        <WrapPanel Margin="0,10,0,0">
                                            <StackPanel Width="120" Margin="0,0,12,10">
                                                <TextBlock Text="Từ dòng" Classes="fieldLabel" />
                                                <TextBox Text="{Binding ScrapeTarget.StartRow}" />
                                            </StackPanel>
                                            <StackPanel Width="130" Margin="0,0,12,10">
                                                <TextBlock Text="Đến dòng (0=hết)" Classes="fieldLabel" />
                                                <TextBox Text="{Binding ScrapeTarget.EndRow}" />
                                            </StackPanel>
                                            <StackPanel Width="120" Margin="0,0,12,10">
                                                <TextBlock Text="Dòng / lần" Classes="fieldLabel" />
                                                <TextBox Text="{Binding ScrapeTarget.RowsPerAccount}" />
                                            </StackPanel>
                                            <StackPanel Width="140" Margin="0,0,12,10">
                                                <TextBlock Text="Số process (mọi op)" Classes="fieldLabel" />
                                                <TextBox Text="{Binding ScrapeTarget.MaxProcess}" />
                                            </StackPanel>
                                            <StackPanel Width="120" Margin="0,0,12,10">
                                                <TextBlock Text="Số tk / khung" Classes="fieldLabel" />
                                                <TextBox Text="{Binding ScrapeTarget.FrameSize}" />
                                            </StackPanel>
                                            <StackPanel Width="120" Margin="0,0,0,10">
                                                <TextBlock Text="Reload (s)" Classes="fieldLabel" />
                                                <TextBox Text="{Binding UpdateTarget.ListingReloadSeconds}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <!-- 2 ô đường dẫn (máy này): chữ mono + nút "…" 34×30 chọn thư mục. -->
                                        <Grid ColumnDefinitions="*,12,*" Margin="0,2,0,0">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Ảnh Update (máy này)" Classes="fieldLabel" />
                                                <Grid ColumnDefinitions="*,6,Auto">
                                                    <TextBox Grid.Column="0" Classes="mono" FontSize="12"
                                                             Text="{Binding #Root.DataContext.Update.ImagePath}" />
                                                    <Button Grid.Column="2" Width="34" Padding="0"
                                                            ToolTip.Tip="Chọn thư mục ảnh Update"
                                                            Command="{Binding #Root.DataContext.Update.BrowseImageCommand}">
                                                        <PathIcon Data="{DynamicResource IconFolder}" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Thư mục video (máy này)" Classes="fieldLabel" />
                                                <Grid ColumnDefinitions="*,6,Auto">
                                                    <TextBox Grid.Column="0" Classes="mono" FontSize="12"
                                                             Text="{Binding #Root.DataContext.VideoDir}" />
                                                    <Button Grid.Column="2" Width="34" Padding="0"
                                                            ToolTip.Tip="Chọn thư mục video"
                                                            Command="{Binding #Root.DataContext.BrowseVideoDirCommand}">
                                                        <PathIcon Data="{DynamicResource IconFolder}" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Có ảnh Update trong thư mục này → dùng ảnh đó. Thiếu ảnh (quên đặt / chưa tải) → tự lấy ảnh chung từ Hub."
                                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ══════════ TAB 2: Thống kê (per-shop × per-op — đọc sổ hoàn thành trên Hub, giống tab Hub) ══════════ -->
                <TabItem Header="Thống kê">
                    <!-- DataContext đặt ở ROOT CONTENT (không đặt trên TabItem): Avalonia không truyền
                         DataContext của TabItem xuống content (issue #10958) → đặt trên TabItem là tab trắng. -->
                    <Grid DataContext="{Binding Stats}">
                        <!-- Gợi ý rỗng: chưa kết nối Hub · chưa chọn acc · acc không shop -->
                        <TextBlock Text="{Binding EmptyHint}" Classes="caption" VerticalAlignment="Top"
                                   TextWrapping="Wrap" IsVisible="{Binding ShowEmptyHint}" />

                        <!-- Nội dung khi có dữ liệu: hàng KPI trên cùng + lưới shop cuộn dưới -->
                        <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ShowEmptyHint}">

                            <!-- KPI tổng tài khoản: 4 thẻ op nằm ngang -->
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding Kpis}" Margin="0,0,0,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="card" Padding="14,10" Margin="0,0,10,0" MinWidth="150">
                                            <StackPanel>
                                                <TextBlock Text="{Binding OpLabel}" Classes="caption" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding RowsText}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                                    <TextBlock Text="dòng" Classes="caption" Margin="5,0,0,3" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ShopsDoneText}" Classes="caption" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Lưới shop: mỗi shop 1 card, trong đó 4 thẻ op dàn theo bề ngang -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Shops}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="card" Margin="0,0,0,10" Padding="14,12">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ShopName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding SheetText}" Classes="caption" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   IsVisible="{Binding SheetText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Ops}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="230" Margin="0,8,10,0" Padding="10,8" CornerRadius="6"
                                                                        Background="{DynamicResource SubtleBrush}">
                                                                    <StackPanel>
                                                                        <!-- Hàng 1: nhãn op + pill trạng thái -->
                                                                        <Grid ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="{Binding OpLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            <Border Grid.Column="1" CornerRadius="4" Padding="8,2" Background="{Binding StatusBg}"
                                                                                    ToolTip.Tip="{Binding Tooltip}">
                                                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                                                           Foreground="{Binding StatusFg}" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <!-- Hàng 2: tổng dòng + tới dòng -->
                                                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                            <TextBlock Text="{Binding RowsText}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                                                            <TextBlock Text="{Binding LastRowText}" Classes="caption" Margin="8,0,0,2" VerticalAlignment="Bottom"
                                                                                       IsVisible="{Binding LastRowText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                        </StackPanel>
                                                                        <!-- Hàng 3: các khoảng dòng đã làm -->
                                                                        <TextBlock Text="{Binding RangesText}" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                                                                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                                                        <!-- Hàng 4: máy + gần nhất -->
                                                                        <TextBlock Text="{Binding LastText}" Classes="caption" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                        <!-- Hàng 5: các máy đã tham gia (ẩn khi ≤1 máy) -->
                                                                        <TextBlock Text="{Binding MachinesText}" Classes="caption" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                                   IsVisible="{Binding MachinesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- ══════════ TAB 3: Dữ liệu (lưới kho SP của tài khoản đang chọn — fixed-acct) ══════════ -->
                <TabItem Header="Dữ liệu">
                    <data:DataView DataContext="{Binding AccountData}" />
                </TabItem>

                <!-- ══════════ TAB 4: Theo dõi Scrape (log đầy màn) ══════════ -->
                <TabItem Header="Theo dõi Scrape">
                    <Grid DataContext="{Binding Scrape}" ColumnDefinitions="1*,12,1.35*">
                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                        IsVisible="{Binding ErroredAccounts.Count, Converter={StaticResource CountToBool}}">
                                <TextBlock Margin="0,0,0,4" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}">
                                    <Run Text="⚠ Tài khoản lỗi (" /><Run Text="{Binding ErroredAccounts.Count, Mode=OneWay}" /><Run Text=") — đã tự đổi tk" />
                                </TextBlock>
                                <Border Classes="card" MaxHeight="110" ClipToBounds="True">
                                    <DataGrid ItemsSource="{Binding ErroredAccounts}" BorderThickness="0" IsReadOnly="True" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="1.4*" />
                                            <DataGridTextColumn Header="Lỗi" Binding="{Binding Reason}" Width="*" />
                                            <DataGridTextColumn Header="Lúc" Binding="{Binding Time}" Width="78" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Tiến trình scrape" Classes="caption" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Border Classes="card" ClipToBounds="True">
                                <DataGrid Classes="instances" ItemsSource="{Binding Instances}" BorderThickness="0" IsReadOnly="True"
                                          AutoGenerateColumns="False" PointerReleased="Instance_Click">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Process" Binding="{Binding Label}" Width="1.2*" />
                                        <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountName}" Width="1.3*" />
                                        <DataGridTextColumn Header="Dòng" Binding="{Binding RangeText}" Width="86" />
                                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="1.8*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <!-- DataContext vùng này = Scrape → binding tới workspace phải qua #Root.DataContext. -->
                                <TextBlock Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="Nhật ký Scrape — " /><Run Text="{Binding #Root.DataContext.SelectedAccount.DisplayName}" /><Run Text=" (500 dòng cuối · riêng acc này)" />
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Padding="8,2" FontSize="11.5" Margin="0,0,6,0"
                                            Command="{Binding #Root.DataContext.OpenScrapeAccLogCommand}"
                                            ToolTip.Tip="Mở file log RIÊNG của tài khoản đang chọn (chỉ dòng scrape của acc này).">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{DynamicResource IconFolder}" Width="14" Height="14" />
                                            <TextBlock Text="Log acc này" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="8,2" FontSize="11.5"
                                            Command="{Binding OpenLogFileCommand}"
                                            ToolTip.Tip="Mở file log GỘP mọi acc trộn chung (file cũ logs\workspace-scrape.log).">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{DynamicResource IconFolder}" Width="14" Height="14" />
                                            <TextBlock Text="Log gộp" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource LogBackgroundBrush}">
                                <TextBox Classes="log" b:LogText.Source="{Binding #Root.DataContext.SelectedAccount.ScrapeLog}" />
                            </Border>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <!-- ══════════ TAB 5: Theo dõi Update (log đầy màn) ══════════ -->
                <TabItem Header="Theo dõi Update">
                    <DockPanel DataContext="{Binding Update}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <!-- DataContext vùng này = Update → binding tới workspace phải qua #Root.DataContext. -->
                            <TextBlock Classes="caption" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="Nhật ký Update — " /><Run Text="{Binding #Root.DataContext.SelectedAccount.DisplayName}" /><Run Text=" (500 dòng cuối · riêng acc này)" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Padding="8,2" FontSize="11.5" Margin="0,0,6,0"
                                        Command="{Binding #Root.DataContext.OpenUpdateAccLogCommand}"
                                        ToolTip.Tip="Mở file log RIÊNG của tài khoản đang chọn (chỉ dòng import/update/tên SP của acc này).">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{DynamicResource IconFolder}" Width="14" Height="14" />
                                        <TextBlock Text="Log acc này" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="8,2" FontSize="11.5"
                                        Command="{Binding OpenLogFileCommand}"
                                        ToolTip.Tip="Mở file log GỘP mọi acc trộn chung (file cũ logs\workspace-update.log).">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{DynamicResource IconFolder}" Width="14" Height="14" />
                                        <TextBlock Text="Log gộp" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource LogBackgroundBrush}">
                            <TextBox Classes="log" b:LogText.Source="{Binding #Root.DataContext.SelectedAccount.UpdateLog}" />
                        </Border>
                    </DockPanel>
                </TabItem>
            </TabControl>

                <!-- Nút Dừng: DataContext của Grid này = WorkspaceViewModel (không cần #Root). FallbackValue=False
                     → acc null / không chạy gì thì ẨN HẲN. Tab bên trái, nút bên phải nên không đè lên tab. -->
                <Button Classes="danger"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0"
                        IsVisible="{Binding SelectedAccount.HasRunningWork, FallbackValue=False}"
                        Command="{Binding StopSelectedWorkCommand}"
                        ToolTip.Tip="Dừng scrape / import / update / tên SP đang chạy của tài khoản đang chọn (shop đang chạy). Tài khoản khác chạy tiếp.">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Data="{DynamicResource IconStop}" />
                        <TextBlock Text="Dừng việc shop này" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
