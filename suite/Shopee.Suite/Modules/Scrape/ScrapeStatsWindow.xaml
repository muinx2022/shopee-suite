<Window x:Class="Shopee.Suite.Modules.Scrape.ScrapeStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Shopee.Suite.Controls"
        Title="Thống kê scrape" Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource caption}" Text="{Binding Title}" />
        <TextBlock Grid.Row="1" Margin="0,4,0,10" TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Summary}" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sheets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource card}" Padding="14,12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Header}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RangesText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="12" />
                                <TextBlock Text="{Binding FrameText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <!-- Command nằm trên VM của CỬA SỔ (không phải trên dòng) → leo tổ tiên Window. -->
                                    <!-- Chỉ hiện khi sheet CÓ dòng bỏ qua: mở Hub trước rồi mới khoét vùng phủ local. -->
                                    <Button MinWidth="170" Margin="0,0,10,0"
                                            Visibility="{Binding CanReopenSkipped, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ReopenSkippedCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconRefresh}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="{Binding ReopenSkippedLabel}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource destructive}" MinWidth="110"
                                            Command="{Binding DataContext.ClearProgressCommand,
                                                      RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconDelete}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Xoá tiến độ" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button MinWidth="90" Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{StaticResource IconRefresh}" />
                    <TextBlock Style="{StaticResource btnLabel}" Text="Làm mới" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource primary}" MinWidth="90" Margin="10,0,0,0" Click="OnClose">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{StaticResource IconClose}" />
                    <TextBlock Style="{StaticResource btnLabel}" Text="Đóng" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
