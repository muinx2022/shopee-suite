<UserControl x:Class="Shopee.Suite.Modules.CheckAccount.CheckAccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:c="clr-namespace:Shopee.Suite.Controls"
             xmlns:b="clr-namespace:Shopee.Suite.Behaviors"
             x:Name="Root">
    <!-- Port từ Modules/CheckAccount/CheckAccountView.axaml (bản Avalonia). Quy ước dịch: xem bảng đầu
         Themes/Theme.xaml. Ô log dùng behavior b:LogText.Source (nối dòng + tự cuộn), không xử lý ở code-behind. -->
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header — 2 CỘT + chip dùng chung `headerStatusChip` (xem ghi chú ở style trong Themes/Theme.xaml):
             không chồng lớp nên status dài / cửa sổ hẹp không đè lên mô tả. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource h1}" Text="Check tài khoản Shopee" />
                <TextBlock Style="{StaticResource caption}" Margin="0,3,0,0"
                           Text="Kiểm tra hàng loạt tài khoản qua Edge + proxy, giữ profile khi đăng nhập thành công." />
            </StackPanel>
            <ContentControl Grid.Column="1" Style="{StaticResource headerStatusChip}" Content="{Binding Status}" />
        </Grid>

        <!-- Body -->
        <TabControl Grid.Row="1" x:Name="Tabs" SelectionChanged="OnTabChanged">
            <!-- ══════════ TAB 1: CHECK ══════════ -->
            <TabItem Header="Check tài khoản">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.3*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <!-- Accounts -->
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource caption}" Margin="0,0,0,5"
                                   Text="Danh sách tài khoản (mỗi dòng: user|pass  hoặc  user|pass|.shopee.vn=SPC_F=...)" />
                        <!-- ScrollBarVisibility phải khai TẠI CHỖ: template TextBox của theme hard-code Hidden
                             (ô 1 dòng), ô nhiều dòng dán hàng trăm tk mà không có thanh cuộn thì rất khó dùng. -->
                        <TextBox Style="{StaticResource mono}" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="{Binding IsRunning}"
                                 Text="{Binding Accounts}" />
                    </DockPanel>

                    <!-- Proxy -->
                    <DockPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource caption}" Margin="0,0,0,5"
                                   Text="Danh sách proxy (mỗi dòng 1 kiotproxy key hoặc host:port — nhiều key để mỗi tk 1 IP mới)" />
                        <TextBox Style="{StaticResource mono}" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="{Binding IsRunning}"
                                 Text="{Binding ProxyList}" />
                    </DockPanel>

                    <!-- Button row -->
                    <Grid Grid.Row="3" Margin="0,14,0,12">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource success}" MinWidth="120" Command="{Binding RunCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconPlay}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Chạy" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource danger}" MinWidth="100" Margin="10,0,0,0" Command="{Binding StopCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconStop}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Dừng" />
                                </StackPanel>
                            </Button>
                            <Button Margin="10,0,0,0" Command="{Binding OpenProfilesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconFolder}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Thư mục profile" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Số luồng" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <ComboBox Width="64" SelectedItem="{Binding Lanes}" IsEnabled="{Binding IsIdle}">
                                <sys:Int32>1</sys:Int32>
                                <sys:Int32>2</sys:Int32>
                                <sys:Int32>3</sys:Int32>
                                <sys:Int32>4</sys:Int32>
                                <sys:Int32>5</sys:Int32>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Log -->
                    <Border Grid.Row="4" CornerRadius="6" ClipToBounds="True"
                            Background="{StaticResource LogBackgroundBrush}">
                        <TextBox x:Name="LogBox" Style="{StaticResource log}" b:LogText.Source="{Binding LogLines}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════ TAB 2: TK OK ══════════ -->
            <TabItem Header="TK OK">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="Chọn tất cả" VerticalAlignment="Center" Margin="2,0,14,0"
                                      IsChecked="{Binding SelectAll}" />
                            <Button Command="{Binding ReloadOkCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconRefresh}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Tải lại" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource primary}" Margin="10,0,0,0" Command="{Binding SaveToSharedCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconSave}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Lưu vào kho chung" />
                                </StackPanel>
                            </Button>
                            <Button Margin="10,0,0,0" Command="{Binding OpenOkFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconFolder}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Mở file" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="{Binding OkStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" FontSize="12.5" />
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource card}" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding OkAccounts}" AutoGenerateColumns="False" BorderThickness="0"
                                  CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="46" Header="✓" CanUserResize="False" CanUserSort="False"
                                                        CellStyle="{StaticResource cellTight}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding Selected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tài khoản" Binding="{Binding Account, Mode=OneWay}"
                                                    Width="2*" IsReadOnly="True"
                                                    FontFamily="{StaticResource MonoFont}" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Mode=OneWay}"
                                                    Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
