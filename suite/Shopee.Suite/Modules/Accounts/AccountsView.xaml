<UserControl x:Class="Shopee.Suite.Modules.Accounts.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Suite.Controls"
             x:Name="Root" Unloaded="OnUnloaded">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header — 2 CỘT + chip dùng chung `headerStatusChip` (xem ghi chú ở style trong Themes/Theme.xaml).
             Màn này có thêm nút "Check Acc" ở cột phải: nút + chip nằm CÙNG cột Auto, không đè lên tiêu đề. -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="Tài khoản &amp; Proxy" Style="{StaticResource h1}" />
                <TextBlock Text="Kho tài khoản Shopee dùng chung — Scrape và Search đều chạy trên danh sách này."
                           Style="{StaticResource caption}" Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                <Button Style="{StaticResource primary}" MinWidth="120" Command="{Binding OpenCheckAccountCommand}"
                        AutomationProperties.Name="Check Acc"
                        ToolTip="Mở form kiểm tra hàng loạt tài khoản Shopee (Edge + proxy).">
                    <StackPanel Orientation="Horizontal">
                        <c:PathIcon Data="{StaticResource IconLogin}" />
                        <TextBlock Style="{StaticResource btnLabel}" Text="Check Acc" />
                    </StackPanel>
                </Button>
                <ContentControl Style="{StaticResource headerStatusChip}" Margin="12,0,0,0"
                                Content="{Binding Status}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: list + toolbar -->
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <!-- Quản lý danh sách CHỈ trên standalone; client read-only (chỉ xem + xử lý captcha + Đồng bộ). -->
                    <Button Style="{StaticResource success}" MinWidth="80"
                            Command="{Binding AddCommand}"
                            Visibility="{Binding IsFullEditMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconAdd}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Thêm" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource destructive}" MinWidth="80"
                            Margin="8,0,0,0" Command="{Binding DeleteCommand}"
                            CommandParameter="{Binding SelectedItems, ElementName=AccountsGrid}"
                            Visibility="{Binding IsFullEditMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconDelete}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Xóa" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding ImportCommand}"
                            Visibility="{Binding IsFullEditMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconImport}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Import…" />
                        </StackPanel>
                    </Button>
                    <Button Margin="8,0,0,0" Command="{Binding SyncFromHubCommand}"
                            Visibility="{Binding IsHubClient, Converter={StaticResource BoolToVis}}"
                            ToolTip="Kéo tài khoản + proxy + cookie từ Hub về máy này (gộp/append, không nhân đôi).">
                        <StackPanel Orientation="Horizontal">
                            <c:PathIcon Data="{StaticResource IconSync}" />
                            <TextBlock Style="{StaticResource btnLabel}" Text="Đồng bộ acc" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Hiện:" VerticalAlignment="Center" Margin="16,0,6,0" Style="{StaticResource caption}" />
                    <ComboBox MinWidth="150" VerticalAlignment="Center"
                              SelectedItem="{Binding SelectedFilter}" ItemsSource="{Binding FilterOptions}" />
                    <TextBlock Text="Mẹo: bấm đúp 1 acc lỗi để mở giải captcha." VerticalAlignment="Center" Margin="16,0,0,0"
                               Style="{StaticResource caption}"
                               Visibility="{Binding IsErrorFilter, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Kho KiotProxy dùng chung — xoay vòng gán cho acc lúc chạy (standalone sửa; client nhận) -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource card}" Padding="12,10" Margin="0,10,0,0"
                        Visibility="{Binding IsFullEditMode, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Kho KiotProxy dùng chung (xoay vòng lúc chạy)"
                                       Style="{StaticResource h2}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource primary}"
                                    MinWidth="110" Command="{Binding SaveProxyPoolCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <c:PathIcon Data="{StaticResource IconSave}" />
                                    <TextBlock Style="{StaticResource btnLabel}" Text="Lưu proxy" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Style="{StaticResource caption}" Margin="0,2,0,6" TextWrapping="Wrap"
                                   Text="Mỗi dòng 1 KiotProxy key hoặc host:port. Lúc chạy: acc thứ i → proxy thứ (i mod số proxy). Máy Hub quản lý; client tự nhận (sửa ở client sẽ bị Hub ghi đè)." />
                        <TextBox Style="{StaticResource mono}" Height="90" AcceptsReturn="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ProxyPoolText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource card}" ClipToBounds="True">
                    <DataGrid x:Name="AccountsGrid" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                              MouseDoubleClick="AccountsGrid_DoubleClick"
                              BorderThickness="0" IsReadOnly="True" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên" Binding="{Binding DisplayName}" Width="1.2*" />
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding Username}" Width="1.4*"
                                                FontFamily="{StaticResource MonoFont}" />
                            <DataGridTextColumn Header="Proxy" Binding="{Binding ProxySummary}" Width="1.2*" />
                            <DataGridTemplateColumn Header="Tình trạng" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UsageStatus}" Foreground="{Binding UsageStatusBrush}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Lỗi / captcha" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding LastError}" Foreground="{StaticResource DangerBrush}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- RIGHT: detail editor -->
            <Border Grid.Column="2" Style="{StaticResource card}" Padding="18"
                    DataContext="{Binding Selected}">
                <Grid>
                    <TextBlock Text="Chọn một tài khoản để xem / sửa chi tiết."
                               Style="{StaticResource caption}" VerticalAlignment="Top"
                               Visibility="{Binding DataContext.HasSelection, ElementName=Root,
                                            Converter={StaticResource InvBoolToVis}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding DataContext.HasSelection, ElementName=Root,
                                               Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Chi tiết tài khoản" Style="{StaticResource h2}" Margin="0,0,0,12" />

                            <TextBlock Text="Tên hiển thị" Style="{StaticResource caption}" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,12"
                                     IsReadOnly="{Binding DataContext.IsReadOnlyMode, ElementName=Root}" />

                            <TextBlock Text="Đăng nhập Shopee (user|pass|.shopee.vn=SPC_F=…)" Style="{StaticResource caption}" />
                            <TextBox Style="{StaticResource mono}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"
                                     Text="{Binding ShopeeAccountLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"
                                     IsReadOnly="{Binding DataContext.IsReadOnlyMode, ElementName=Root}" />
                            <CheckBox Content="Mở với tài khoản Shopee (tự đăng nhập)" Margin="0,0,0,14"
                                      IsChecked="{Binding OpenWithShopeeAccount}"
                                      IsEnabled="{Binding DataContext.IsFullEditMode, ElementName=Root}" />

                            <TextBlock Text="PROXY" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="KiotProxy key" Style="{StaticResource caption}" />
                            <TextBox Text="{Binding KiotProxyKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                                     IsReadOnly="{Binding DataContext.IsReadOnlyMode, ElementName=Root}" />

                            <Grid Margin="0,0,0,10" IsEnabled="{Binding DataContext.IsFullEditMode, ElementName=Root}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Vùng" Style="{StaticResource caption}" />
                                    <ComboBox Margin="0,3,0,0" HorizontalAlignment="Stretch" SelectedItem="{Binding Region}"
                                              ItemsSource="{Binding DataContext.RegionOptions, ElementName=Root}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Loại proxy" Style="{StaticResource caption}" />
                                    <ComboBox Margin="0,3,0,0" HorizontalAlignment="Stretch" SelectedItem="{Binding ProxyType}"
                                              ItemsSource="{Binding DataContext.ProxyTypeOptions, ElementName=Root}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Proxy thủ công (host:port hoặc http://… — nếu không dùng Kiot)"
                                       Style="{StaticResource caption}" />
                            <TextBox Text="{Binding ManualProxy, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,10"
                                     IsReadOnly="{Binding DataContext.IsReadOnlyMode, ElementName=Root}" />
                            <CheckBox Content="Bắt buộc có proxy mới chạy" IsChecked="{Binding RequireProxy}" Margin="0,0,0,4"
                                      IsEnabled="{Binding DataContext.IsFullEditMode, ElementName=Root}" />
                            <CheckBox Content="Tạm tắt tài khoản này" IsChecked="{Binding Disabled}"
                                      IsEnabled="{Binding DataContext.IsFullEditMode, ElementName=Root}" />

                            <!-- Nút thao tác. Xử lý captcha (double-click mở Brave) → "Đóng và …". -->
                            <WrapPanel HorizontalAlignment="Left" Margin="0,18,0,0">
                                <!-- (Trước hard-code Foreground/BorderBrush xanh tại chỗ — nay theo luật nút mới:
                                     dáng chung, màu ngữ nghĩa CHỈ ở icon qua style .success.) -->
                                <Button Style="{StaticResource success}" MinWidth="100" Margin="0,0,10,6"
                                        ToolTip="Bỏ đánh dấu lỗi/captcha của tài khoản này → đưa về rotation Scrape/Search"
                                        Command="{Binding DataContext.ReenableCommand, ElementName=Root}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconCheck}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Bật lại" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource primary}" MinWidth="120" Margin="0,0,10,6"
                                        Command="{Binding DataContext.SaveCommand, ElementName=Root}"
                                        Visibility="{Binding DataContext.IsFullEditMode, ElementName=Root,
                                                     Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconSave}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Lưu thay đổi" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- Xử lý captcha (chỉ khi lọc "Bị lỗi/captcha"): đóng Brave vừa mở kiểm tra rồi lưu/xóa/báo. -->
                            <WrapPanel HorizontalAlignment="Left" Margin="0,0,0,0"
                                       Visibility="{Binding DataContext.IsErrorFilter, ElementName=Root,
                                                    Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource success}" MinWidth="120" Margin="0,0,10,6"
                                        ToolTip="Đã giải captcha xong: đóng Brave + bật lại acc + gỡ báo trên Hub."
                                        Command="{Binding DataContext.CloseAndSaveCommand, ElementName=Root}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconSave}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Đóng và lưu" />
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="180" Margin="0,0,10,6"
                                        ToolTip="Đóng Brave, giữ acc tắt, báo Hub — Hub quyết giữ/xóa."
                                        Command="{Binding DataContext.CloseAndReportFailedCommand, ElementName=Root}"
                                        Visibility="{Binding DataContext.IsReadOnlyMode, ElementName=Root,
                                                     Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconClose}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Đóng và báo không sửa được" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource destructive}" MinWidth="140" Margin="0,0,10,6"
                                        ToolTip="Đóng Brave + xóa acc khỏi kho (đồng bộ gỡ mọi máy)."
                                        Command="{Binding DataContext.CloseAndDeleteCommand, ElementName=Root}"
                                        Visibility="{Binding DataContext.IsFullEditMode, ElementName=Root,
                                                     Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <c:PathIcon Data="{StaticResource IconDelete}" />
                                        <TextBlock Style="{StaticResource btnLabel}" Text="Đóng và xóa tk" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
