<Window x:Class="Shopee.Suite.Modules.Accounts.ImportAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Shopee.Suite.Controls"
        Title="Import tài khoản" Width="720" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="0.7*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource caption}" Margin="0,0,0,5"
                       Text="Tài khoản Shopee (mỗi dòng 1 tk: user|pass  hoặc  user|pass|.shopee.vn=SPC_F=value)" />
            <TextBox x:Name="LoginsBox" Style="{StaticResource mono}" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </DockPanel>

        <TextBlock Grid.Row="1" Style="{StaticResource caption}" Margin="0,12,0,5"
                   Text="Proxy (mỗi dòng 1 kiotproxy key hoặc host:port) — ghép xoay vòng cho từng tài khoản. Nếu CHỈ nhập proxy (để trống tài khoản) thì gán xoay vòng cho các tài khoản ĐÃ CÓ." />

        <TextBox Grid.Row="2" x:Name="KeysBox" Style="{StaticResource mono}" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <!-- KHÔNG dùng IsCancel: WPF tự gán DialogResult=false sau Click → vừa ghi đè kết quả, vừa ném
                 InvalidOperationException khi cửa sổ mở bằng Show() (đường fallback của WindowHost). -->
            <Button MinWidth="90" Click="OnCancel">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{StaticResource IconClose}" />
                    <TextBlock Style="{StaticResource btnLabel}" Text="Hủy" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource primary}" MinWidth="110" Margin="10,0,0,0" Click="OnOk">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{StaticResource IconImport}" />
                    <TextBlock Style="{StaticResource btnLabel}" Text="Import" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
