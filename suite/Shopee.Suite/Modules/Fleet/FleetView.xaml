<UserControl x:Class="Shopee.Suite.Modules.Fleet.FleetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Shopee.Suite.Controls"
             x:Name="Root">
    <!-- Port từ Modules/Fleet/FleetView.axaml (bản Avalonia). Quy ước dịch: xem bảng đầu Themes/Theme.xaml.
         Brush trạng thái (StateBrush / Brush) do ViewModel dựng SẴN và đã Freeze (AppBrushes) → bind thẳng. -->
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Trạng thái &amp; Giao việc" Style="{StaticResource h1}" />
                <TextBlock Text="Theo dõi máy + Hub giao việc cho từng máy (scrape · import · update theo dây chuyền)."
                           Style="{StaticResource caption}" Margin="0,3,0,0" />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="110"
                    Command="{Binding RefreshCommand}">
                <StackPanel Orientation="Horizontal">
                    <c:PathIcon Data="{StaticResource IconRefresh}" />
                    <TextBlock Style="{StaticResource btnLabel}" Text="Làm mới" />
                </StackPanel>
            </Button>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ════════════ TAB 1: THEO DÕI ════════════ -->
            <TabItem Header="Theo dõi">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource SubtleBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Machines}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource caption}" Margin="0,4,0,8" />
                            <CheckBox Content="⚠ Chạy đè: bỏ qua khoá của máy khác ở các lượt chạy tới (chỉ bật khi chắc máy kia đã dừng)"
                                      IsChecked="{Binding ForceNextRun}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource card}" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserSortColumns="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Máy" Binding="{Binding MachineName}" Width="170" />
                                <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountLabel}" Width="*" />
                                <DataGridTextColumn Header="Shop" Binding="{Binding ShopName}" Width="*" />
                                <DataGridTextColumn Header="Việc" Binding="{Binding Op}" Width="100" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding State}" Width="140" />
                                <DataGridTextColumn Header="Cập nhật" Binding="{Binding Updated}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════ TAB 2: GIAO VIỆC (chỉ phần CLIENT) ════════════ -->
            <TabItem Header="Giao việc">
                <Grid Margin="0,12,0,0">

                    <!-- ───── Bản CLIENT: việc của máy này ───── -->
                    <Grid Visibility="{Binding IsClientPanel, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SubtleBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReceiveStateText}" FontSize="13.5" />
                                    <TextBlock Style="{StaticResource caption}" Margin="0,3,0,0" TextWrapping="Wrap">
                                        <Run Text="Vai trò Hub đặt: " /><Run Text="{Binding MyRole, Mode=OneWay}" /><Run Text="   ·   Việc &quot;Giao tay&quot; (ghim) thì máy chạy dù chưa có vai trò." />
                                    </TextBlock>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="180" Margin="12,0,0,0"
                                        Content="{Binding ReceiveToggleText}" Command="{Binding ToggleReceiveCommand}"
                                        Style="{StaticResource primary}"
                                        ToolTip="Bật/tắt nhận việc Hub giao. Đang nhận = máy tự chạy khi có việc." />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource card}" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding MyJobs}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserSortColumns="False" GridLinesVisibility="Horizontal" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Việc" Binding="{Binding Op}" Width="110" />
                                    <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountLabel}" Width="*" />
                                    <DataGridTextColumn Header="Shop" Binding="{Binding ShopName}" Width="*" />
                                    <DataGridTextColumn Header="Dòng (Hub giao)" Binding="{Binding Rows}" Width="120" />
                                    <DataGridTemplateColumn Header="Trạng thái" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <!-- ───── Việc gián đoạn (failed/canceled, chưa xong) — bấm Tiếp tục để hub giao lại ───── -->
                        <Border Grid.Row="2" Visibility="{Binding HasInterrupted, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource card}" Margin="0,10,0,0" Padding="14,12">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding InterruptedHeader}" FontSize="13.5" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource success}" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="150"
                                            Command="{Binding ResumeAllJobsCommand}"
                                            ToolTip="Đưa TẤT CẢ việc gián đoạn về hàng chờ hub để chạy tiếp.">
                                        <StackPanel Orientation="Horizontal">
                                            <c:PathIcon Data="{StaticResource IconResume}" />
                                            <TextBlock Style="{StaticResource btnLabel}" Text="Tiếp tục tất cả" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Style="{StaticResource caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Việc bị dừng/lỗi giữa chừng (chưa xong). Bấm Tiếp tục → hub giao lại, máy phù hợp tự chạy nốt phần còn thiếu." />
                                <TextBlock Text="{Binding InterruptedStatus}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Visibility="{Binding InterruptedStatus, Converter={StaticResource StringToVis}}" />
                                <ScrollViewer MaxHeight="220" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding InterruptedJobs}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource SubtleBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource caption}" Margin="0,2,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <!-- Command nằm trên FleetViewModel (không phải trên dòng) → leo tổ tiên ItemsControl. -->
                                                        <Button Grid.Column="1" Style="{StaticResource success}" VerticalAlignment="Center"
                                                                Margin="12,0,0,0" MinWidth="110"
                                                                Command="{Binding DataContext.ResumeJobCommand,
                                                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <c:PathIcon Data="{StaticResource IconResume}" />
                                                                <TextBlock Style="{StaticResource btnLabel}" Text="Tiếp tục" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="3" Margin="2,8,0,0" Style="{StaticResource caption}" TextWrapping="Wrap"
                                   Text="Mẹo: muốn máy này dừng nhận việc mới (để chạy tay) thì bấm nút ở trên cùng." />
                    </Grid>

                    <!-- ───── Chưa bật đồng bộ ───── -->
                    <TextBlock Visibility="{Binding IsCoordOff, Converter={StaticResource BoolToVis}}"
                               Margin="0,48,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Chưa bật đồng bộ Hub trên máy này.&#x0a;Vào Cài đặt → Đồng bộ nhiều máy để chọn vai trò Client hoặc bật Hub." />
                </Grid>
            </TabItem>

            <!-- ════════════ TAB 3: SEARCH (ĐA MÁY) — chỉ thông báo phía CLIENT ════════════ -->
            <TabItem Header="Search (đa máy)">
                <Grid Margin="0,12,0,0">

                    <!-- ───── Bản CLIENT: việc search xem ở tab Giao việc ───── -->
                    <TextBlock Visibility="{Binding IsClientPanel, Converter={StaticResource BoolToVis}}"
                               Margin="0,48,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Bảng chia link Search chỉ hiển thị trên máy Hub.&#x0a;Việc Search mà Hub giao cho máy này sẽ chạy tự động và hiện ở tab “Giao việc” (mục Việc của máy này)." />

                    <!-- ───── Chưa bật đồng bộ ───── -->
                    <TextBlock Visibility="{Binding IsCoordOff, Converter={StaticResource BoolToVis}}"
                               Margin="0,48,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="Chưa bật đồng bộ Hub trên máy này.&#x0a;Vào Cài đặt → Đồng bộ nhiều máy để bật Hub." />
                </Grid>
            </TabItem>

            <!-- ══════════ TAB LOG (nhật ký nhiều máy gửi về Hub) ══════════ -->
            <TabItem Header="Log">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource destructive}" Command="{Binding ClearLogsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <c:PathIcon Data="{StaticResource IconDelete}" />
                                <TextBlock Style="{StaticResource btnLabel}" Text="Xoá log" />
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource caption}"
                                   Text="Nhật ký từ tất cả các máy (client gửi về Hub) — mới nhất ở trên." />
                    </DockPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserSortColumns="False" GridLinesVisibility="Horizontal"
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding Time}" Width="90" />
                            <DataGridTextColumn Header="Máy" Binding="{Binding Machine}" Width="150" />
                            <DataGridTemplateColumn Header="Nội dung" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                   TextWrapping="Wrap" Margin="8,2,8,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
