<UserControl x:Class="Shopee.Suite.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Border Style="{StaticResource card}" Padding="48" HorizontalAlignment="Center"
                VerticalAlignment="Center" MaxWidth="560">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="64" Height="64" CornerRadius="6" Background="{StaticResource SubtleBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource emoji}" Text="🚧" FontSize="30"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Chữ do code-behind điền: màn "Sắp có" thật (ComingSoonViewModel) HOẶC màn module đang
                     chờ port sang WPF (đợt 2–5) — xem ComingSoonView.xaml.cs. -->
                <TextBlock x:Name="TitleText" Style="{StaticResource h1}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                <Border x:Name="Badge" Background="{StaticResource SubtleBrush}" CornerRadius="4" Padding="10,4"
                        Margin="0,10,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="BadgeText" Text="Sắp có" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
                <TextBlock x:Name="DescriptionText" Style="{StaticResource body}"
                           Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
