<Window x:Class="Shopee.Suite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Shopee.Suite.ViewModels"
        xmlns:c="clr-namespace:Shopee.Suite.Controls"
        Title="Shopee Suite" Width="1500" Height="940" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Phím tắt chuyển tab — KHỚP chữ gợi ý "Ctrl + 1…4 để chuyển tab" ở cuối dải tab. "D1".."D4" là phím số
         hàng trên (tên trong enum Key). Tham số là chỉ số tab; tab không tồn tại ở chế độ hiện tại → bỏ qua. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1" Command="{Binding SelectTabAtCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Control" Key="D2" Command="{Binding SelectTabAtCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Control" Key="D3" Command="{Binding SelectTabAtCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Control" Key="D4" Command="{Binding SelectTabAtCommand}" CommandParameter="3" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ Row 0: DẢI TAB (nền TRẮNG, tab canh đáy + gạch cam 3px) ══════════
             Khung cửa sổ vẫn là chrome NATIVE của Windows → app-mark + tên app được gộp vào ĐẦU dải tab
             thay vì title bar riêng như mockup (giảm 1 tầng chrome, giữ kéo-thả/snap). -->
        <Border Grid.Row="0" Panel.ZIndex="1" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource TabStripBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App mark (ô vuông cam bo 4) + tên app — bấm để về màn hình chính (Workspace) -->
                <Button Grid.Column="0" Style="{StaticResource brand}" VerticalAlignment="Center"
                        Command="{Binding GoHomeCommand}" ToolTip="Về màn hình chính">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="4" Margin="0,0,9,0"
                                Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="Shopee Suite" FontSize="12.5"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Tab (canh ĐÁY dải; chỉ báo active = gạch cam 3px dựng trong ItemTemplate) -->
                <ListBox Grid.Column="1" Style="{StaticResource topnav}" VerticalAlignment="Bottom"
                         Margin="6,0,0,0"
                         ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RibbonTab}">
                            <!-- Padding của tab nằm TRONG template (ListBoxItem để Padding=0) → gạch chỉ báo
                                 thụt đúng 12px mỗi bên như spec, không bị cộng thêm padding của item. -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="3" />
                                </Grid.RowDefinitions>
                                <!-- Chữ để độ đậm THƯỜNG (không SemiBold/Bold) — tab đang chọn chỉ nhận biết qua
                                     màu chữ đậm hơn + gạch cam dưới đây, KHÔNG đổi nét chữ. -->
                                <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="14.5"
                                           Margin="16,9,16,8" VerticalAlignment="Center" />
                                <!-- NGOẠI LỆ bo góc (chuẩn 4/6): gạch chỉ báo chỉ cao 3px, bo 4 sẽ méo → giữ 2. -->
                                <Border Grid.Row="1" Height="3" Margin="12,0" CornerRadius="2,2,0,0"
                                        Background="{StaticResource AccentBrush}"
                                        Visibility="{Binding IsSelected,
                                                     RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}},
                                                     Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Gợi ý phím tắt (khớp Window.InputBindings ở trên). Chữ dựng THEO SỐ TAB THẬT của chế độ
                     đang chạy (ShellViewModel.TabShortcutHint) — ghi cứng "1…4" là sai ở chế độ Shopee (2 tab)
                     và Workspace (3 tab). -->
                <TextBlock Grid.Column="2" Text="{Binding TabShortcutHint}" FontSize="11.5"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Bottom" Margin="12,0,6,13" />
            </Grid>
        </Border>

        <!-- ══════════ Row 1: DẢI RIBBON (nền trắng, cao ≥112, nhóm + caption đáy) ══════════ -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,0,0,1"
                MinHeight="112">
            <!-- Hẹp → cuộn NGANG (không co/cắt nút) -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SelectedTab.Groups}" Margin="6,8,6,6">
                    <ItemsControl.Resources>
                        <!-- 3 loại item của ribbon: chọn theo KIỂU dữ liệu (DataTemplate ngầm định) -->

                        <!-- Nút ĐIỀU HƯỚNG MÀN (icon trên, nhãn dưới; active giữ tint cam — DataTrigger IsActive
                             trong style `ribbonNav`) -->
                        <DataTemplate DataType="{x:Type vm:RibbonScreenItem}">
                            <Button Style="{StaticResource ribbonNav}" Margin="2,0"
                                    Command="{Binding ActivateCommand}" ToolTip="{Binding ToolTip}">
                                <StackPanel VerticalAlignment="Center">
                                    <c:PathIcon Style="{StaticResource ribbonIcon}" Data="{Binding Icon}"
                                                Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource ribbonLabel}" Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>

                        <!-- Nút HÀNH ĐỘNG (icon trên, nhãn dưới) — cùng bộ icon với nút trong các form, để
                             "Dừng" ở ribbon và "Dừng" ở form là MỘT icon. -->
                        <DataTemplate DataType="{x:Type vm:RibbonActionItem}">
                            <Button Style="{StaticResource ribbon}" Margin="2,0"
                                    Command="{Binding Command}" ToolTip="{Binding ToolTip}">
                                <StackPanel VerticalAlignment="Center">
                                    <c:PathIcon Style="{StaticResource ribbonIcon}" Data="{Binding Icon}"
                                                Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource ribbonLabel}" Text="{Binding Title}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>

                        <!-- TOGGLE (checkbox): căn GIỮA chiều cao hàng nút cho cân với nút lớn. -->
                        <DataTemplate DataType="{x:Type vm:RibbonToggleItem}">
                            <Border Margin="6,0" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource ribbonToggle}" IsChecked="{Binding IsChecked}"
                                          Content="{Binding Title}" ToolTip="{Binding ToolTip}"
                                          VerticalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.Resources>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RibbonGroup}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Nhóm: hàng nút (chiếm hết chiều cao) + caption ở ĐÁY. IsEnabled theo nhóm:
                                     nhóm bị khóa (vd "Hành động"/"Tùy chọn" tab Shopee khi không ở màn Tài khoản)
                                     → làm mờ CẢ cụm; nhóm bật → item con theo trạng thái riêng (CanExecute). -->
                                <DockPanel Margin="12,0" IsEnabled="{Binding IsEnabled}">
                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Title}" FontSize="10.5"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding Items}" HorizontalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </DockPanel>
                                <!-- Vạch dọc ngăn nhóm (thụt 2px trên / 6px dưới) -->
                                <Rectangle Width="1" Margin="0,2,0,6" VerticalAlignment="Stretch"
                                           Fill="{StaticResource RibbonDividerBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ══════════ Row 2: NỘI DUNG màn đang chọn ══════════ -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentScreen}" />

        <!-- ══════════ Row 3: THANH TRẠNG THÁI (cao 32, nền trung tính — KHÔNG cam) ══════════
             Các đoạn cao hết thanh, hover sáng nhẹ, ngăn nhau bằng vạch 1×16. Style ở Theme.xaml
             (statusSeg / statusSep / statusDot) — KHÔNG dùng style của module Đơn hàng.
             QUY TẮC CO (thay ContainerQuery của Avalonia — WPF không có): thanh hẹp (< 1240px) → ẩn các đoạn
             ưu tiên THẤP, bằng cách bind Visibility vào ActualWidth của chính thanh qua converter WiderThan.
             Đoạn trạng thái job, cụm đếm chính và PHIÊN BẢN luôn hiện; thanh không bao giờ xuống dòng. -->
        <Border x:Name="StatusBarRoot" Grid.Row="3" Height="32" ClipToBounds="True"
                Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <!-- ── NHÓM PHẢI — khai TRƯỚC nhóm trái: DockPanel chia chỗ theo thứ tự khai báo nên phiên bản
                       + cụm phải luôn giữ được chỗ khi cửa sổ hẹp. Thứ tự khai báo = phải → trái. ── -->

                <!-- Phiên bản app (đọc từ assembly = version.txt) — LUÔN hiện -->
                <Border DockPanel.Dock="Right" Style="{StaticResource statusSeg}" ToolTip="Phiên bản Shopee Suite">
                    <TextBlock Style="{StaticResource statusText}" Text="{Binding AppVersionText}" />
                </Border>

                <!-- Mức thu phóng — CHỈ hiện khi khác 100% (Ctrl +/− đổi mức, Ctrl 0 về mặc định) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding ShowZoom, Converter={StaticResource BoolToVis}}">
                    <Rectangle Style="{StaticResource statusSep}" />
                    <Border Style="{StaticResource statusSeg}"
                            ToolTip="Ctrl + và Ctrl − để thu phóng giao diện · Ctrl 0 về 100%">
                        <TextBlock Style="{StaticResource statusText}" Text="{Binding ZoomText}" />
                    </Border>
                </StackPanel>

                <!-- Máy online (ưu tiên thấp) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding ActualWidth, ElementName=StatusBarRoot,
                                         Converter={StaticResource WiderThan}, ConverterParameter=1240}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowWorkspaceStatus, Converter={StaticResource BoolToVis}}">
                        <Rectangle Style="{StaticResource statusSep}" />
                        <Border Style="{StaticResource statusSeg}">
                            <TextBlock Style="{StaticResource statusText}" Text="{Binding WorkspaceStatus.MachineText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Trình duyệt (ưu tiên thấp) — nguồn Workspace nếu có, không thì đoạn Shopee -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding ActualWidth, ElementName=StatusBarRoot,
                                         Converter={StaticResource WiderThan}, ConverterParameter=1240}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowWorkspaceStatus, Converter={StaticResource BoolToVis}}">
                        <Rectangle Style="{StaticResource statusSep}" />
                        <Border Style="{StaticResource statusSeg}">
                            <TextBlock Style="{StaticResource statusText}" Text="{Binding WorkspaceStatus.BrowserText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding ActualWidth, ElementName=StatusBarRoot,
                                         Converter={StaticResource WiderThan}, ConverterParameter=1240}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowOrdersBrowserStatus, Converter={StaticResource BoolToVis}}">
                        <Rectangle Style="{StaticResource statusSep}" />
                        <Border Style="{StaticResource statusSeg}">
                            <TextBlock Style="{StaticResource statusText}" Text="{Binding ShopeeStatusVm.StatusBrowserText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ── NHÓM TRÁI ── -->

                <!-- Trạng thái job: chấm xanh NHẤP NHÁY (2.4s) + số việc đang chạy — LUÔN hiện -->
                <Border DockPanel.Dock="Left" Style="{StaticResource statusSeg}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource statusDot}" Margin="0,0,7,0"
                                 Fill="{StaticResource SuccessDotBrush}" />
                        <TextBlock Style="{StaticResource statusText}" Text="{Binding JobStatusText}" />
                    </StackPanel>
                </Border>

                <!-- Vòng chờ đẩy (đơn/phiếu/dòng sheet/đếm Đã bán còn tồn) — CHỈ hiện khi còn tồn > 0 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding ShowShopeeStatus, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShopeeStatusVm.HasOutboxPending, Converter={StaticResource BoolToVis}}">
                        <Rectangle Style="{StaticResource statusSep}" />
                        <Border Style="{StaticResource statusSeg}" ToolTip="{Binding ShopeeStatusVm.OutboxPendingTooltip}">
                            <TextBlock Style="{StaticResource statusText}" Text="{Binding ShopeeStatusVm.OutboxPendingText}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Cụm đếm chính (Workspace): tk BigSeller · shop -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding ShowWorkspaceStatus, Converter={StaticResource BoolToVis}}">
                    <Rectangle Style="{StaticResource statusSep}" />
                    <Border Style="{StaticResource statusSeg}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource statusText}" Text="{Binding WorkspaceStatus.BigSellerText}" />
                            <TextBlock Style="{StaticResource statusDotSep}" Text="·" Margin="7,0" />
                            <TextBlock Style="{StaticResource statusText}" Text="{Binding WorkspaceStatus.ShopText}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Cụm đếm phụ (Workspace): acc Shopee · proxy — ẩn khi hẹp -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding ActualWidth, ElementName=StatusBarRoot,
                                         Converter={StaticResource WiderThan}, ConverterParameter=1240}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowWorkspaceStatus, Converter={StaticResource BoolToVis}}">
                        <Rectangle Style="{StaticResource statusSep}" />
                        <Border Style="{StaticResource statusSeg}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource statusText}" Text="{Binding WorkspaceStatus.ShopeeAccountText}" />
                                <TextBlock Style="{StaticResource statusDotSep}" Text="·" Margin="7,0" />
                                <TextBlock Style="{StaticResource statusText}" Text="{Binding WorkspaceStatus.ProxyText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Cụm đếm đoạn Shopee (đơn hàng): tài khoản · đơn hàng — ẩn khi hẹp. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                            Visibility="{Binding ActualWidth, ElementName=StatusBarRoot,
                                         Converter={StaticResource WiderThan}, ConverterParameter=1240}">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding ShowShopeeStatus, Converter={StaticResource BoolToVis}}">
                        <Rectangle Style="{StaticResource statusSep}" />
                        <Border Style="{StaticResource statusSeg}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource statusText}" Text="{Binding ShopeeStatusVm.StatusAccountsText}" />
                                <TextBlock Style="{StaticResource statusDotSep}" Text="·" Margin="7,0" />
                                <TextBlock Style="{StaticResource statusText}" Text="{Binding ShopeeStatusVm.StatusOrdersText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
